(ert-deftest auto-review/log-selects-saved-record-in-fresh-buffer-or-after-new-automation ()
  (dolist (frontend-started '(nil t))
    (save-window-excursion
      (auto-review-test-buffer
       (setf (alist-get 'automation magit-auto-review--review)
             '((operation_id . "old-automatic")))
       (when frontend-started
         (cl-letf (((symbol-function 'magit-auto-review--async) (lambda (&rest _) nil)))
           (magit-auto-review--start '((command . "run")) #'ignore)))
       (let ((review (copy-tree magit-auto-review--review)))
         (setf (alist-get 'operation_id (alist-get 'automation review)) "new-automatic")
         (magit-auto-review--accept review))
       (cl-letf (((symbol-function 'magit-auto-review--call)
                  (lambda (request)
                    (should (equal (alist-get 'command request) "review-log"))
                    (should (equal (alist-get 'operation_id request) "new-automatic"))
                    (should (equal (alist-get 'session request) "/test/session"))
                    '((text . "Saved automatic log\n")))))
         (magit-auto-review-log)
         (should (eq (current-buffer) (get-buffer "*Auto-review saved log*")))
         (should (equal (buffer-string) "Saved automatic log\n"))
         (should (eq major-mode 'special-mode))
         (should (= (point) (point-max))))))))

(ert-deftest auto-review/log-falls-back-to-progress-when-saved-log-retrieval-fails ()
  (dolist (failure '((magit-auto-review-api-error "The saved operation log is no longer available." "missing_log")
                     (file-missing "Backend executable unavailable")))
    (save-window-excursion
      (auto-review-test-buffer
       (setf (alist-get 'automation magit-auto-review--review)
             '((operation_id . "saved-automatic")))
       (with-current-buffer (get-buffer-create "*Auto-review progress*")
         (let ((inhibit-read-only t))
           (erase-buffer)
           (insert "Retained frontend feedback\n")))
       (let (notice)
         (cl-letf (((symbol-function 'magit-auto-review--call)
                    (lambda (_) (signal (car failure) (cdr failure))))
                   ((symbol-function 'message)
                    (lambda (format-string &rest args) (setq notice (apply #'format format-string args)))))
           (magit-auto-review-log)
           (should (eq (current-buffer) (get-buffer "*Auto-review progress*")))
