;;; magit-auto-review-tests.el --- Behavioral review UI tests -*- lexical-binding: t; -*-
(require 'ert)
(require 'magit-auto-review)

(defvar auto-review-test-requests nil)
(defconst auto-review-test-root
  (expand-file-name "../.." (file-name-directory (or load-file-name buffer-file-name))))

(defun auto-review-test-data ()
  (copy-tree `((session . "/test/session") (generation . "old") (current_generation . "old")
    (revision . "revision-1") (pr . 7) (snapshot . ((head . ,(make-string 40 ?a))))
    (verdict . "COMMENT") (historical . :false)
    (verdicts . (((value . "COMMENT") (available . t)) ((value . "REQUEST_CHANGES") (available . t)) ((value . "APPROVE") (available . t))))
    (comments . ,(cl-loop for i from 1 to 3 collect
                         `((id . ,(format "p%d" i)) (title . ,(format "Finding %d" i)) (body . ,(format "Body %d" i))
                           (status . "unstaged") (classification . "NEW") (override . :false) (locations . nil)
                           (severity . nil) (severity_incomplete . :false) (finding_assessments . nil)
                           (placement . ((kind . "inline") (path . "source.txt") (line . 2) (side . "RIGHT")))
                           (context . ((path . "source.txt") (line . 2) (side . "RIGHT")
                                       (rows . (((old . 1) (new . 1) (kind . " ") (text . "before") (highlight . :false))
                                                ((old . nil) (new . 2) (kind . "+") (text . "actual line") (highlight . t))))))))))))

(defun auto-review-test-call (request)
  (push request auto-review-test-requests)
  (cond
   ((equal (alist-get 'command request) "read") magit-auto-review--review)
   ((equal (alist-get 'command request) "preview-comment")
    (let* ((review (copy-tree magit-auto-review--review))
           (comment (copy-tree (car (alist-get 'comments review)))))
      (setf (alist-get 'id comment) "new-preview"
            (alist-get 'title comment) (alist-get 'title request)
            (alist-get 'body comment) (alist-get 'body request)
            (alist-get 'placement comment) (alist-get 'placement request)
            (alist-get 'status comment) "unstaged"
            (alist-get 'composing comment) t
            (alist-get 'comments review) (append (alist-get 'comments review) (list comment)))
      `((review . ,review) (comment . "new-preview"))))
   (t
    (let* ((review (copy-tree magit-auto-review--review))
           (op (alist-get 'operation request))
           (ids (or (append (alist-get 'comments request) nil) (list (alist-get 'comment request))))
           (comments (alist-get 'comments review)))
      (dolist (comment comments)
        (when (member (alist-get 'id comment) ids)
          (pcase op
            ("stage" (setf (alist-get 'status comment) "staged"))
            ("unstage" (setf (alist-get 'status comment) "unstaged"))
            ("suppress" (setf (alist-get 'status comment) "suppressed"))
            ("restore" (setf (alist-get 'status comment) "unstaged"))
            ("edit" (unless (equal (alist-get 'body comment) (alist-get 'body request))
                       (setf (alist-get 'body comment) (alist-get 'body request)
                             (alist-get 'status comment) "unstaged"))))))
      `((review . ,review) (changed . ,ids) (skipped . nil))))))

(defmacro auto-review-test-buffer (&rest body)
  `(with-temp-buffer
     (magit-auto-review-mode)
     (let ((auto-review-test-requests nil))
       (magit-auto-review--accept (auto-review-test-data))
       (cl-letf (((symbol-function 'magit-auto-review--call) #'auto-review-test-call))
         (unwind-protect (progn ,@body)
           (when magit-auto-review--editor (magit-auto-review--finish-edit)))))))

(defun auto-review-test-goto (id)
  (magit-auto-review--goto-comment id t))

(ert-deftest auto-review/mode-initialization-has-a-usable-section ()
  (with-temp-buffer
    (magit-auto-review-mode)
    (magit-section-post-command-hook)
    (should (object-of-class-p (magit-current-section) 'magit-section))
    (should buffer-read-only)
    (should-not (buffer-modified-p))))

(ert-deftest auto-review/send-selection-to-owner-preserves-reviewer-drafts ()
  (auto-review-test-buffer
   (goto-char (oref (oref (cdr (assoc "p1" magit-auto-review--sections)) parent) start))
   (let ((before (copy-tree magit-auto-review--review)) request shown)
     (cl-letf (((symbol-function 'magit-auto-review--call)
                (lambda (r) (setq request r) '((owner . ((session . "/owner"))) (items . ("local:1" "local:2" "local:3")))))
               ((symbol-function 'magit-auto-review-owner-show-import)
                (lambda (result directory) (setq shown (list result directory)))))
       (magit-auto-review-send-to-owner))
     (should (equal (alist-get 'command request) "owner-import"))
     (should (equal (alist-get 'comments request) ["p1" "p2" "p3"]))
     (should (equal (alist-get 'generation request) "old"))
     (should (equal (alist-get 'revision request) "revision-1"))
     (should shown)
     (should (equal magit-auto-review--review before))
     (should (eq (key-binding "o") #'magit-auto-review-send-to-owner)))))

