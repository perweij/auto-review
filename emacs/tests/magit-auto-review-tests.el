(defun auto-review-test-pulls (refreshed)
  `((repository . "github.com/org/repo") (repositories . ("github.com/org/repo"))
    (checked_at . ,(and refreshed "2026-10-25"))
    (pull_requests . ,(append
                      (when refreshed '(((pr . 2) (repository . "github.com/org/repo")
                                         (title . "New feature") (state . "OPEN") (sessions . nil))))
                      `(((pr . 1) (repository . "github.com/org/repo") (title . "Old feature")
                         (state . ,(if refreshed "MERGED" "UNKNOWN"))
                         (sessions . (((session . "/test/pr-1"))))))))))

