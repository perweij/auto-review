(ert-deftest auto-review/repository-entry-refresh-finds-new-pr-and-run-targets-it ()
  (save-window-excursion
    (let (listing review requests run-request)
      (cl-letf (((symbol-function 'magit-toplevel) (lambda () auto-review-test-root))
                ((symbol-function 'magit-auto-review--call)
                 (lambda (request)
                   (push request requests)
                   (pcase (alist-get 'command request)
                     ("toolkit" '((toolkit . "reviewer")))
                     ("pull-requests"
                      (should-not (alist-get 'refresh request))
                      (auto-review-test-pulls nil))
                     ("discover"
                      (should (= (alist-get 'pr request) 2))
                      (should (equal (alist-get 'repository request) "github.com/org/repo"))
                      '((sessions . nil)))
                     (_ (error "Unexpected request: %S" request)))))
                ((symbol-function 'magit-auto-review--async)
                 (lambda (request _events result _error)
                   (should (equal (alist-get 'command request) "pull-requests"))
                   (should (alist-get 'refresh request))
                   (funcall result (auto-review-test-pulls t)) nil))
                ((symbol-function 'magit-auto-review-run)
                 (lambda () (magit-auto-review--launch-review nil)))
                ((symbol-function 'magit-auto-review--start)
                 (lambda (request _callback) (setq run-request request))))
        (unwind-protect
            (progn
              (magit-auto-review)
              (setq listing (current-buffer))
              (should (derived-mode-p 'magit-auto-review-pulls-mode))
              (should-not magit-auto-review--session)
              (should (= (alist-get 'pr (magit-auto-review--pull-at-point)) 1))
              (execute-kbd-macro "g")
              (should (string-match-p "#2  New feature" (buffer-string)))
              (should (string-match-p "MERGED" (buffer-string)))
              (should (= (alist-get 'pr (magit-auto-review--pull-at-point)) 2))
              (execute-kbd-macro "R")
              (setq review (current-buffer))
              (should (derived-mode-p 'magit-auto-review-mode))
              (should (= (alist-get 'pr run-request) 2))
              (should (equal (alist-get 'repository run-request) "github.com/org/repo"))
              (should-not (alist-get 'session run-request))
              (should (equal (mapcar (lambda (r) (alist-get 'command r)) (reverse requests))
                             '("pull-requests" "toolkit" "discover"))))
          (dolist (buffer (list listing review))
            (when (buffer-live-p buffer) (kill-buffer buffer))))))))

