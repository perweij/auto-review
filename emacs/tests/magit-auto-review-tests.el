(defun auto-review-test-conversations ()
  (let ((review (auto-review-test-data)))
    (setf (alist-get 'coverage review) '((kind . "followup") (threads . ("thread:T1")))
          (alist-get 'review_status review)
          '((available . t) (decision . "CHANGES_REQUESTED")
            (opinionated . ((id . "r1") (state . "CHANGES_REQUESTED")))
            (latest_activity . ((id . "r2") (state . "COMMENTED")))))
    (dolist (i '(1 2))
      (let* ((key (format "thread:T%d" i))
             (thread `((key . ,key) (kind . "thread") (path . "source.txt") (line . ,i)
                       (is_resolved . ,(if (= i 1) :false t)) (is_outdated . t)
                       (can_resolve . t) (can_unresolve . t) (can_reply . t)
                       (comments . (((author . "reviewer") (body . ,(format "Concern %d" i)))))))
             (context `((thread . ,thread) (expected . ((head . "head") (thread . ,key))) (rows . nil))))
        (push thread (alist-get 'items (alist-get 'discussion review)))
        (push (cons (intern key) context) (alist-get 'thread_contexts review))))
    review))

(defun auto-review-test-goto-thread (key)
  (magit-auto-review--walk-sections
   (lambda (s) (when (and (eq (oref s type) 'review-conversation) (equal (oref s value) key))
                 (goto-char (oref s start))))))

