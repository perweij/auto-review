        (magit-auto-review-owner--push-header)
        (should (string-match-p "configure this upstream" (buffer-string)))
        (should-not (string-match-p "P u" (buffer-string)))))))

(ert-deftest owner/association-is-visible-on-folded-feedback-and-in-completion ()
  (owner-test-buffer
   (let ((view (owner-test-view)))
     ;; JSON object keys become symbols, including feedback keys with punctuation.
     (setf (alist-get 'associations (car (alist-get 'batches view)))
           `((,(intern "thread:T1") . ((commits . ("03db750c0b83abcdef")) (method . "exact")))))
     (cl-letf (((symbol-function 'magit-auto-review-owner--start)
                (lambda (request callback)
                  (should (equal (alist-get 'command request) "owner-associate"))
                  (funcall callback view))))
       (magit-auto-review-owner-associate nil))
     (should (string-match-p "Saved commit associations: 1 feedback item(s) · Linked 03db750c0b83" header-line-format))
     (let ((section (owner-test-goto 'owner-feedback "thread:T1")))
       (should (oref section hidden))
       (should (string-match-p "Linked 03db750c0b83" (buffer-substring (line-beginning-position) (line-end-position)))))
     (owner-test-goto 'owner-batch "b1")
     (should (string-match-p "Linked 03db750c0b83" (buffer-substring (line-beginning-position) (line-end-position)))))))

(ert-deftest owner/association-with-no-match-explains-the-result ()
