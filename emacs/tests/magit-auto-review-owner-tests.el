(ert-deftest owner/completed-local-help-offers-finishing-and-inspection ()
  (save-window-excursion
    (owner-test-buffer
     (switch-to-buffer (current-buffer))
     (magit-auto-review-owner--accept (owner-test-completed-local-view))
     (owner-test-goto 'owner-batch "b1")
     (unwind-protect
         (progn
           (execute-kbd-macro "?")
           (let ((commands (mapcar (lambda (s) (oref s command)) transient--suffixes)))
             (should (memq #'magit-auto-review-owner-handled commands))
             (should (memq #'magit-auto-review-owner-diff commands))
             (should (memq #'magit-auto-review-owner-all-menu commands))
             (should (< (cl-count-if (lambda (command) (string-prefix-p "magit-auto-review-" (symbol-name command))) commands) 12))
             (dolist (command '(magit-auto-review-owner-fix magit-auto-review-owner-resume magit-auto-review-owner-adopt
                                magit-auto-review-owner-compose magit-auto-review-owner-stage magit-auto-review-owner-publish
                                magit-auto-review-owner-resolve magit-auto-review-owner-reopen))
               (should-not (memq command commands))))
           (with-current-buffer transient--buffer
             (should (string-match-p "No GitHub reply is needed" (buffer-string))))
           (execute-kbd-macro "+")
           (should (eq (oref transient--prefix command) 'magit-auto-review-owner-all-menu)))
       (when transient--prefix (execute-kbd-macro "q"))))))

