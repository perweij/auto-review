     (owner-test-goto 'owner-feedback "thread:T1")
     (should-not (string-match-p "old-commit" (buffer-substring (line-beginning-position) (line-end-position)))))))

(ert-deftest owner/partial-diff-requires-explicit-prefix-and-current-revision ()
