   (let* ((view (owner-test-view)) (older (car (alist-get 'batches view)))
          (newer (copy-tree older)))
     (setf (alist-get 'associations older) '(("thread:T1" . ((commits . ("old-commit"))))))
     (setf (alist-get 'id newer) "b2")
