                    ("owner-read" view)
                    (_ (ert-fail request)))))
               ((symbol-function 'magit-auto-review-owner--start)
                (lambda (request &rest _) (setq resume request))))
       (magit-auto-review-environment-apply)
       (magit-auto-review-owner-resume)
       (should (equal "b1" (alist-get 'batch resume)))
       (should (= 4 (alist-get 'revision resume)))))))

(ert-deftest owner/publish-and-finish-uses-confirmed-threads-and-current-revisions ()
  (dolist (choice '(?r ?p ?q published))
    (owner-test-buffer
     (let* ((view (owner-test-view))
            (threads (seq-take (alist-get 'feedback view) 2))
            (prompts 0) sent)
       (setf (alist-get 'replies view)
             (cl-loop for item in threads for n from 101 collect
                      (progn
                        (nconc item `((root_id . ,n) (can_resolve . t) (fingerprint . "original")))
                        `((id . ,(format "draft-%d" n)) (source . ,(alist-get 'key item))
                          (body . "Fixed in abc") (fingerprint . "original") (commits . ("abc"))
                          (status . ,(if (eq choice 'published) "published" "staged"))
                          (receipt . ((id . ,(+ n 2)))) (target . ((kind . "reply") (root_id . ,n)))))))
       (magit-auto-review-owner--accept view)
       (when (eq choice 'published)
         (should (string-search "P resolves open threads" (buffer-string)))
         (should (string-search "Reply published" (magit-auto-review-owner--title (car threads)))))
       (cl-letf (((symbol-function 'read-multiple-choice)
                  (lambda (prompt &rest _)
                    (should (string-search "#101, #102" prompt)) (cl-incf prompts) (list choice)))
                 ((symbol-function 'yes-or-no-p)
                  (lambda (prompt) (should (eq choice 'published))
                    (should (string-search "#101, #102" prompt)) (cl-incf prompts) t))
                 ((symbol-function 'magit-auto-review-owner--start)
                  (lambda (req cb)
                    (push (alist-get 'command req) sent)
                    (should (= (alist-get 'revision req) (alist-get 'revision view)))
                    (pcase (car sent)
                      ("owner-prepare" (funcall cb `((owner . ,view) (replies . ,(alist-get 'replies view)) (token . "exact"))))
                      ("owner-publish"
                       (should (equal "exact" (alist-get 'token req)))
                       (dolist (r (alist-get 'replies view)) (setf (alist-get 'status r) "published"))
                       (cl-incf (alist-get 'revision view)) (funcall cb view))
                      ("owner-thread-state"
                       (should (eq t (alist-get 'resolved req)))
                       (let ((item (magit-auto-review-owner--feedback (alist-get 'item req))))
                         (should (memq item threads))
                         (should-not (magit-auto-review--true-p (alist-get 'is_resolved item)))
                         (setf (alist-get 'is_resolved item) t))
                       (cl-incf (alist-get 'revision view)) (funcall cb view))))))
         (magit-auto-review-owner-publish))
       (should (= prompts 1))
       (should (equal (reverse sent)
                      (pcase choice
                        (?r '("owner-prepare" "owner-publish" "owner-thread-state" "owner-thread-state"))
                        (?p '("owner-prepare" "owner-publish"))
                        (?q '("owner-prepare"))
                        ('published '("owner-thread-state" "owner-thread-state")))))))))

(ert-deftest owner/thread-finishing-skips-changed-or-unconfirmed-feedback ()
  (owner-test-buffer
   (let* ((item (magit-auto-review-owner--feedback "thread:T1"))
          (reply '((id . "fix") (source . "thread:T1") (fingerprint . "original")
                   (status . "published") (receipt . ((id . 222)))
                   (commits . ("abc")) (target . ((kind . "reply") (root_id . 101))))))
     (nconc item '((root_id . 101) (fingerprint . "original") (can_resolve . t)))
     (setf (alist-get 'replies magit-auto-review-owner--view) (list reply))
     (should (magit-auto-review-owner--finishable-replies (list reply) "published"))
     (dolist (field '((fingerprint . "changed") (root_id . 102) (is_resolved . t) (can_resolve . :false)))
       (let ((previous (alist-get (car field) item)))
         (setf (alist-get (car field) item) (cdr field))
         (should-not (magit-auto-review-owner--finishable-replies (list reply) "published"))
         (setf (alist-get (car field) item) previous)))
     (push '((source . "thread:T1") (status . "unstaged")) (alist-get 'replies magit-auto-review-owner--view))
     (should-not (magit-auto-review-owner--finishable-replies (list reply) "published")))))

(ert-deftest owner/automatic-retry-shows-one-finding-per-phase-and-explains-stop ()
  (owner-test-buffer
   (let* ((view (owner-test-view))
          (previous (car (alist-get 'batches view)))
          (current (copy-tree previous)))
     (setf (alist-get 'status previous) "interrupted"
           (alist-get 'error previous) "Operation cancelled."
           (alist-get 'id current) "retry"
           (alist-get 'auto_commit current) t
           (alist-get 'status current) "paused"
           (alist-get 'error current) "Final check requires a fixture."
           (alist-get 'items current) '("thread:T1" "thread:T2" "comment:3")
           (alist-get 'tasks current)
           '(((items . ("thread:T1" "thread:T2")) (status . "complete"))
             ((items . ("thread:T2")) (status . "reviewing"))
             ((items . ("comment:3")) (status . "queued")))
           (alist-get 'batches view) (list previous current))
     (magit-auto-review-owner--accept view)
     (let ((text (owner-test-visible-text)))
       (dolist (label '("Current automatic fix round · 3 findings" "Earlier round: Operation cancelled."
                        "Stopped because: Final check requires a fixture." "r resumes"
                        "Fix replies: 0 drafted · 0 staged · 0 published"
                        "Task checks passed (1)" "Paused (1)" "Queued (1)"))
         (should (string-match-p (regexp-quote label) text))))
     (dolist (key (alist-get 'items current))
       (should (= 1 (cl-count-if (lambda (s) (and (eq (oref s type) 'owner-feedback)
                                                 (equal (oref s value) key)))
                                 magit-auto-review-owner--sections))))
     (owner-test-goto 'owner-batch "b1")
     (should (equal (oref (magit-auto-review-owner--at 'owner-group) value) "history"))
     (setf (alist-get 'status current) "running"
           (alist-get 'status (cadr (alist-get 'tasks current))) "repairing")
     (magit-auto-review-owner--accept view)
     (should (string-match-p "In progress (1)" (owner-test-visible-text)))
     (should-not (string-match-p "Stopped because:" (owner-test-visible-text))))))
