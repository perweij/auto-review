;;; magit-auto-review-owner-tests.el --- Owner behavior -*- lexical-binding: t; -*-
(require 'ert)
(require 'magit-auto-review-owner)

(defun owner-test-view ()
  "Build a saved owner view with feedback and drafts."
  (copy-tree
   '((session . "/test/owner") (revision . 3) (pr . 7) (repository . "github.com/org/repo")
     (checked_at . "2026-10-25") (url . "https://github.com/org/repo/pull/7")
     (settings . ((fix . ((provider . "claude") (model . "fable") (effort . "medium")))
                  (review . ((provider . "codex") (model . "chosen") (effort . "high")))
                  (verification . "focused")))
     (feedback . (((key . "thread:T1") (kind . "thread") (attention . t) (actionable . t) (unread . t)
                   (is_outdated . t) (is_resolved . :false) (path . "source.py")
                   (comments . (((author . "reviewer") (body . "First concern") (url . "https://example.com/1")))))
                  ((key . "thread:T2") (kind . "thread") (attention . t) (actionable . t) (unread . :false)
                   (is_resolved . :false) (comments . (((author . "reviewer") (body . "Second concern")))))
                  ((key . "comment:3") (kind . "comment") (attention . :false) (actionable . t)
                   (comments . (((author . "reviewer") (body . "Deferred concern")))))))
     (replies . (((id . "r1") (source . "thread:T1") (status . "staged") (body . "Fixed in HASH"))
                 ((id . "r2") (source . "thread:T2") (status . "published") (body . "Published reply"))))
     (batches . (((id . "b1") (status . "ready") (created_at . "today") (baseline . "abc")
                  (items . ("thread:T1" "thread:T2"))
                  (tasks . (((id . "t1") (status . "complete") (rationale . "Shared fix")
                             (expected . (((item . "thread:T1") (outcome . "First fixed")) ((item . "thread:T2") (outcome . "Second fixed")))) (items . ("thread:T1" "thread:T2")))))))))))

(defmacro owner-test-buffer (&rest body)
  `(with-temp-buffer
     (magit-auto-review-owner-mode)
     (magit-auto-review-owner--accept (owner-test-view))
     ,@body))

(defun owner-test-goto (type value)
  "Visit TYPE section VALUE."
  (let ((section (cl-find-if (lambda (s) (and (eq (oref s type) type) (equal (oref s value) value)))
                              magit-auto-review-owner--sections)))
    (should section)
    (goto-char (oref section start))
    section))

(defun owner-test-local-view ()
  "Return imported findings followed by unrelated incoming feedback."
  (let ((view (owner-test-view)))
    (setf (alist-get 'feedback view)
          (append
           (cl-loop for key in '("local:first" "local:second") collect
                    `((key . ,key) (kind . "local_review") (title . ,key) (attention . t) (actionable . t)
                      (source . ((snapshot . ((head . "reviewed-sha"))) (finding_ids . ("F1"))))
                      (review_context . ((path . "source.py") (line . 1)
                                         (rows . (((new . 1) (kind . "+") (text . "saved code context") (highlight . t))))))
                      (evidence . ("Traced the concern"))
                      (comments . (((author . "Saved reviewer finding") (body . "Preserved local wording"))))))
           (list (car (alist-get 'feedback view)))))
    view))

(defun owner-test-completed-local-view ()
  "Return one linked local fix plus unrelated attention items."
  (let* ((view (owner-test-local-view))
         (batch (car (alist-get 'batches view)))
         (task (car (alist-get 'tasks batch))))
    (setf (alist-get 'worktree view) temporary-file-directory
          (alist-get 'items batch) '("local:first")
          (alist-get 'verified_items batch) '("local:first")
          (alist-get 'associations batch) '(("local:first" . ((commits . ("03db750c0b83")) (method . "exact"))))
          (alist-get 'review batch) '((summary . "The concern is fixed; final verification passed.")
                                     (outcomes . (((item . "local:first") (status . "fixed") (evidence . "Final evidence"))))
                                     (checks . ("Detailed verification command")))
          (alist-get 'items task) '("local:first")
          (alist-get 'rationale task) (concat "Detailed plan " (make-string 1000 ?x))
          (alist-get 'attempts batch) '(((path . "/old-attempt") (role . "review") (status . "complete") (started_at . "earlier")
                                        (result . ((summary . "Earlier failure, repaired afterward") (blocking . ("Old blocking defect")))))))
    (setf (car (alist-get 'batches view)) batch)
    view))

(defun owner-test-visible-text ()
  "Return the lines currently visible in the owner buffer."
  (save-excursion
    (goto-char (point-min))
    (let (lines)
      (while (not (eobp))
        (unless (invisible-p (point))
          (push (buffer-substring-no-properties (line-beginning-position) (line-end-position)) lines))
        (forward-line 1))
      (string-join (nreverse lines) "\n"))))

(ert-deftest owner/finish-from-fix-moves-only-its-feedback-to-history ()
  (owner-test-buffer
   (magit-auto-review-owner--accept (owner-test-completed-local-view))
   (owner-test-goto 'owner-batch "b1")
   (let (sent)
     (cl-letf (((symbol-function 'magit-auto-review--call)
                (lambda (request)
                  (setq sent request)
                  (let ((view (copy-tree magit-auto-review-owner--view)))
                    (setf (alist-get 'feedback view)
                          (mapcar (lambda (item)
                                    (when (member (alist-get 'key item) (append (alist-get 'items request) nil))
                                      (setf (alist-get 'triage item) "handled" (alist-get 'attention item) :false))
                                    item)
                                  (alist-get 'feedback view)))
                    view))))
       (magit-auto-review-owner-handled))
     (should (equal (alist-get 'command sent) "owner-mutate"))
     (should (equal (alist-get 'operation sent) "handled"))
     (should (equal (alist-get 'items sent) ["local:first"]))
     (should (string-match-p "Attention needed (2)" (buffer-string)))
     (should (string-match-p "Done locally · local:first" (buffer-string)))
     (should (string-match-p "Fixes (0)" (owner-test-visible-text)))
     (should-not (string-match-p "Done locally · local:first" (owner-test-visible-text)))
     (should (equal (oref (magit-current-section) value) "history"))
     (should (equal (alist-get 'status (car (alist-get 'batches magit-auto-review-owner--view))) "ready"))
     (let ((section (owner-test-goto 'owner-feedback "local:first")))
       (should (equal (oref (oref section parent) value) "history")))
     (let ((section (owner-test-goto 'owner-batch "b1")))
       (should (equal (oref (oref section parent) value) "history")))
     (should-error (magit-auto-review-owner-handled) :type 'user-error)
     (should-not (assoc "h" (magit-auto-review-owner--menu-actions))))))

(ert-deftest owner/finish-from-task-excludes-unverified-and-unrelated-items ()
  (owner-test-buffer
   (let* ((view (owner-test-completed-local-view)) (batch (car (alist-get 'batches view))) sent)
     (setf (alist-get 'items batch) '("local:first" "local:second")
           (alist-get 'items (car (alist-get 'tasks batch))) '("local:first" "local:second"))
     (magit-auto-review-owner--accept view)
     (should (string-match-p "Verified 1 of 2 feedback items" (buffer-string)))
     (owner-test-goto 'owner-task "t1")
     (cl-letf (((symbol-function 'magit-auto-review-owner--mutate)
                (lambda (_operation &rest fields) (setq sent (alist-get 'items fields)))))
       (magit-auto-review-owner-handled))
     (should (equal sent ["local:first"]))
     (setf (alist-get 'discussion_stale batch) t)
     (setf (car (alist-get 'batches view)) batch)
     (should-error (magit-auto-review-owner-handled) :type 'user-error))))

