;;; magit-auto-review-owner.el --- PR owner toolkit -*- lexical-binding: t; -*-

;; SPDX-License-Identifier: GPL-3.0-or-later
;;; Commentary:
;; Independent owner buffers and commands over the shared backend API.
;; Verified staging prepares native Magit; commits and pushes stay interactive.
;;; Code:
(require 'magit-auto-review)
(require 'magit-commit)
(require 'transient)

(defface magit-auto-review-owner-heading
  '((t :inherit magit-section-heading :weight bold))
  "Owner group headings; inherit the theme's Magit heading color."
  :group 'magit-auto-review)

(defface magit-auto-review-owner-attention
  '((t :inherit default :weight bold))
  "Owner items with work remaining, distinct from group headings."
  :group 'magit-auto-review)

(defface magit-auto-review-owner-item
  '((t :inherit shadow :weight normal))
  "Owner items without pending action, including handled and resolved feedback."
  :group 'magit-auto-review)

(defun magit-auto-review-owner--heading (text &optional face)
  "Insert a section heading with TEXT in FACE."
  (magit-insert-heading (propertize text 'font-lock-face (or face 'magit-auto-review-owner-heading))))

(defvar-local magit-auto-review-owner--view nil)
(defvar-local magit-auto-review-owner--process nil)
(defvar-local magit-auto-review-owner--operation nil)
(defvar-local magit-auto-review-owner--sections nil)
(defvar-local magit-auto-review-owner--retry nil)
(defvar-local magit-auto-review-owner--trust nil)
(defvar-local magit-auto-review-owner--trust-paths nil)
(defvar-local magit-auto-review-owner--trust-diff nil)
(defvar-local magit-auto-review-owner--editor-origin nil)
(defvar-local magit-auto-review-owner--editor-request nil)
(defvar-local magit-auto-review-owner--handoff nil)

(defvar magit-auto-review-owner-mode-map
  (let ((map (make-sparse-keymap)))
    (set-keymap-parent map magit-section-mode-map)
    (dolist (binding '(("g" . magit-auto-review-owner-refresh)
                       ("G" . magit-auto-review-owner-fetch)
                       ("f" . magit-auto-review-owner-fix)
                       ("V" . magit-auto-review-owner-verify)
                       ("R" . magit-auto-review-owner-setup)
                       ("r" . magit-auto-review-owner-resume)
                       ("A" . magit-auto-review-owner-adopt)
                       ("p" . magit-auto-review-owner-replan)
                       ("k" . magit-auto-review-owner-defer)
                       ("U" . magit-auto-review-owner-restore)
                       ("i" . magit-auto-review-owner-acknowledge)
                       ("h" . magit-auto-review-owner-handled)
                       ("c" . magit-auto-review-owner-compose)
                       ("e" . magit-auto-review-owner-edit)
                       ("s" . magit-auto-review-owner-stage)
                       ("u" . magit-auto-review-owner-unstage)
                       ("d" . magit-auto-review-owner-diff)
                       ("m" . magit-auto-review-owner-magit)
                       ("a" . magit-auto-review-owner-associate)
                       ("P" . magit-auto-review-owner-publish)
                       ("O" . magit-auto-review-owner-recover)
                       ("x" . magit-auto-review-owner-resolve)
                       ("X" . magit-auto-review-owner-reopen)
                       ("K" . magit-auto-review-owner-cancel)
                       ("T" . magit-auto-review-owner-trust)
                       ("L" . magit-auto-review-owner-log)
                       ("b" . magit-auto-review-owner-browse)
                       ("B" . magit-auto-review-pull-requests)
                       ("M" . magit-auto-review-select-toolkit)
                       ("?" . magit-auto-review-owner-menu)
                       ("q" . quit-window)))
      (define-key map (kbd (car binding)) (cdr binding)))
    map))

(define-derived-mode magit-auto-review-owner-mode magit-section-mode "PR Owner"
  "Inspect feedback and prepare owner fixes; F is reserved for later work."
  (setq-local buffer-read-only t)
  (setq-local truncate-lines nil)
  (add-hook 'kill-buffer-query-functions #'magit-auto-review-owner--can-close nil t)
  (setq-local revert-buffer-function (lambda (&rest _) (magit-auto-review-owner-refresh)))
  (magit-auto-review-owner--render))

(defun magit-auto-review-owner--can-close ()
  "Keep an active owner's controls available until its operation stops."
  (if (process-live-p magit-auto-review-owner--process)
      (progn (message "Owner operation running; use K to cancel before killing this buffer") nil)
    t))

(defun magit-auto-review-owner--request (command &rest fields)
  "Build an owner COMMAND with FIELDS and the displayed revision."
  (append `((command . ,command)
            (session . ,(alist-get 'session magit-auto-review-owner--view))
            (revision . ,(alist-get 'revision magit-auto-review-owner--view))) fields))

(defun magit-auto-review-owner--at (type)
  "Return the nearest containing section of TYPE."
  (let ((section (magit-current-section)))
    (while (and section (not (eq (oref section type) type)))
      (setq section (oref section parent)))
    section))

(defun magit-auto-review-owner--selected (type)
  "Select TYPE at point, a containing group, or sibling headings."
  (let* ((section (magit-current-section))
         (single (and (not (use-region-p)) (magit-auto-review-owner--at type)))
         (start (if (use-region-p) (region-beginning) (and section (oref section start))))
         (end (if (use-region-p) (region-end) (and section (oref section end))))
         (entries (cl-remove-if-not
                   (lambda (s) (and (eq (oref s type) type) start end
                                     (>= (oref s start) start) (< (oref s start) end)))
                   (reverse magit-auto-review-owner--sections))))
    (when (and (use-region-p)
               (or (not entries)
                   (> (length (delete-dups (mapcar (lambda (s) (oref s parent)) entries))) 1)
                   (not (= start (oref (car entries) start)))))
      (user-error "Select sibling headings, starting at the first heading"))
    (let ((ids (if single (list (oref single value))
                 (mapcar (lambda (s) (oref s value)) entries))))
      (unless ids (user-error "Choose an item or its group"))
      ids)))

(defun magit-auto-review-owner--feedback (key)
  "Return feedback KEY from the displayed snapshot."
  (cl-find key (alist-get 'feedback magit-auto-review-owner--view)
           :key (lambda (i) (alist-get 'key i)) :test #'equal))

(defun magit-auto-review-owner--reply (id)
  "Return outgoing reply ID."
  (cl-find id (alist-get 'replies magit-auto-review-owner--view)
           :key (lambda (i) (alist-get 'id i)) :test #'equal))

(defun magit-auto-review-owner--linked-commits (batch &optional key)
  "Return distinct commits associated with BATCH, optionally for feedback KEY."
  (delete-dups
   (cl-loop for association in (alist-get 'associations batch)
            when (or (not key) (equal key (format "%s" (car association))))
            append (copy-sequence (alist-get 'commits (cdr association))))))

(defun magit-auto-review-owner--commit-label (commits)
  "Describe saved COMMITS compactly without claiming publication or resolution."
  (if commits
      (concat " · Linked " (string-join (mapcar (lambda (sha) (substring sha 0 (min 12 (length sha)))) commits) ", "))
    ""))

(defun magit-auto-review-owner--batch-commit-label (batch &optional key)
  "Show a locally confirmed commit for BATCH, or its saved associations."
  (let* ((progress (alist-get 'commit_progress batch))
         (commits (and key (cdr (cl-find key (alist-get 'items progress)
                                        :key (lambda (entry) (format "%s" (car entry))) :test #'equal))))
         (commit (and (or (not key) (member key (magit-auto-review-owner--verified-keys batch)))
                      (alist-get 'commit (alist-get 'commit_match batch)))))
    (cond
     (commits (concat " · Committed " (string-join (mapcar (lambda (sha) (substring sha 0 (min 12 (length sha)))) commits) ", ")))
     ((and (not key) (> (or (alist-get 'total progress) 0) 1))
      (format " · Fixes committed %d/%d" (alist-get 'completed progress) (alist-get 'total progress)))
     (commit (concat " · Committed " (substring commit 0 (min 12 (length commit)))))
     (t (magit-auto-review-owner--commit-label (magit-auto-review-owner--linked-commits batch key))))))

(defun magit-auto-review-owner--commit-unit-at-point ()
  "Return the logical fix commit row at point."
  (when-let ((section (magit-auto-review-owner--at 'owner-commit-unit)))
    (cl-find (cdr (oref section value))
             (alist-get 'units (alist-get 'commit_plan (magit-auto-review-owner--batch-at-point)))
             :key (lambda (unit) (alist-get 'id unit)) :test #'equal)))

(defun magit-auto-review-owner--brief (text &optional width)
  "Return TEXT on one line, limited to WIDTH display columns."
  (truncate-string-to-width (string-join (split-string (or text "") "[\n\r\t ]+" t) " ")
                            (or width 100) nil nil "…"))

(defun magit-auto-review-owner--item-label (key)
  "Return a human-readable label for feedback KEY."
  (let ((item (magit-auto-review-owner--feedback key)))
    (magit-auto-review-owner--brief
     (or (alist-get 'title item) (magit-auto-review-owner--comment-body (car (alist-get 'comments item))) "Review feedback"))))

(defun magit-auto-review-owner--comment-body (comment)
  "Return COMMENT's display text, retaining compatibility with older backends."
  (or (alist-get 'display_body comment) (alist-get 'body comment) ""))

(defun magit-auto-review-owner--batch-at-point ()
  "Return the selected fix or the latest fix containing feedback at point."
  (unless (use-region-p)
    (let ((batch (magit-auto-review-owner--at 'owner-batch))
          (feedback (magit-auto-review-owner--at 'owner-feedback)))
      (if batch
          (cl-find (oref batch value) (alist-get 'batches magit-auto-review-owner--view) :key (lambda (b) (alist-get 'id b)) :test #'equal)
        (when feedback
          (cl-find-if (lambda (b) (member (oref feedback value) (alist-get 'items b)))
                      (reverse (alist-get 'batches magit-auto-review-owner--view))))))))

(defun magit-auto-review-owner--batch-handled-p (batch)
  "Whether every feedback item in BATCH is explicitly handled locally."
  (and (alist-get 'items batch)
       (cl-every (lambda (key) (equal (alist-get 'triage (magit-auto-review-owner--feedback key)) "handled"))
                 (alist-get 'items batch))))

(defun magit-auto-review-owner--batch-history-p (batch)
  "Whether BATCH is a finished result belonging under History."
  (or (alist-get 'superseded_by batch)
      (and (equal (alist-get 'status batch) "ready")
           (not (magit-auto-review-owner--auto-pending-p batch))
           (magit-auto-review-owner--batch-handled-p batch))))

(defun magit-auto-review-owner--batch-resolved-p (batch)
  "Whether every item in BATCH has confirmed GitHub completion."
  (and (alist-get 'items batch)
       (cl-every (lambda (key) (alist-get 'github_completion (magit-auto-review-owner--feedback key)))
                 (alist-get 'items batch))))

(defun magit-auto-review-owner--auto-pending-p (batch)
  "Whether BATCH still has automatic completion work or a stop to inspect."
  (and (equal (alist-get 'status batch) "ready")
       (magit-auto-review--true-p (alist-get 'auto_commit batch))
       (not (equal (alist-get 'status (alist-get 'commit_execution batch)) "complete"))))

(defun magit-auto-review-owner--auto-summary (batch)
  "Summarize automatic commits and outgoing replies for BATCH."
  (let* ((phase (alist-get 'commit_execution batch))
         (progress (alist-get 'commit_progress batch))
         (replies (cl-remove-if-not (lambda (reply) (and (equal (alist-get 'batch reply) (alist-get 'id batch))
                                                        (equal (alist-get 'status reply) "staged")))
                                    (alist-get 'replies magit-auto-review-owner--view))))
    (format "Fix verified · %s · %d/%d fixes committed · %d replies staged%s%s"
            (if (equal (alist-get 'status phase) "complete") "automatic commits complete"
              (concat "automatic completion " (or (alist-get 'status phase) "pending"))) (or (alist-get 'completed progress) 0)
            (or (alist-get 'total progress) 0) (length replies)
            (if (cl-some (lambda (reply) (magit-auto-review--true-p (alist-get 'awaiting_push reply))) replies) " (awaiting push)" "")
            (if (alist-get 'error phase) (concat " · " (magit-auto-review-owner--brief (alist-get 'error phase) 200)) ""))))

(defun magit-auto-review-owner--verified-keys (batch)
  "Return BATCH's verified feedback, retaining compatibility with older saves."
  (if (assq 'verified_items batch) (alist-get 'verified_items batch) (alist-get 'items batch)))

(defun magit-auto-review-owner--batch-label (batch)
  "Describe BATCH's user-facing state without changing its saved status."
  (cond ((alist-get 'superseded_by batch) "Superseded")
        ((magit-auto-review-owner--batch-history-p batch)
         (if (magit-auto-review-owner--batch-resolved-p batch) "Resolved" "Done locally"))
        ((magit-auto-review--true-p (alist-get 'discussion_stale batch)) "Feedback changed")
        ((equal (alist-get 'status batch) "ready") "Verified")
        ((member (alist-get 'status batch) '("paused" "needs_attention" "interrupted")) "Needs attention")
        (t (capitalize (or (alist-get 'status batch) "Pending")))))

(defun magit-auto-review-owner--pause-reason (batch)
  "Return the current blocking explanation for BATCH."
  (let* ((pending (cl-find-if (lambda (task) (not (member (alist-get 'status task) '("complete" "skipped" "blocked"))))
                               (alist-get 'tasks batch)))
         (report (or (alist-get 'review pending) (alist-get 'implementation pending) (alist-get 'review batch))))
    (or (alist-get 'error batch)
        (and (alist-get 'blocking report) (string-join (alist-get 'blocking report) "; "))
        (alist-get 'summary report)
        "Combined verification has not passed.")))

(defun magit-auto-review-owner--fix-conclusion (batch)
  "Describe BATCH's workflow result separately from process completion."
  (cond
   ((alist-get 'superseded_by batch) "Unused batch superseded by newer verified fixes; no action needed.")
   ((equal (alist-get 'status batch) "ready")
      (if (magit-auto-review--true-p (alist-get 'auto_commit batch))
          (if (magit-auto-review-owner--auto-pending-p batch)
              (magit-auto-review-owner--next-step batch)
            (concat (magit-auto-review-owner--auto-summary batch) " · " (magit-auto-review-owner--next-step batch)))
        (format "Fix verified · %d feedback item(s) · %s" (length (magit-auto-review-owner--verified-keys batch))
                (magit-auto-review-owner--next-step batch))))
   (t (format "Fix %s · %d/%d tasks complete · %s"
            (or (alist-get 'status batch) "stopped")
            (cl-count "complete" (alist-get 'tasks batch) :key (lambda (task) (alist-get 'status task)) :test #'equal)
            (length (alist-get 'tasks batch)) (magit-auto-review-owner--brief (magit-auto-review-owner--pause-reason batch) 200)))))

(defun magit-auto-review-owner--next-step (batch)
  "Explain the next useful action for BATCH using saved state only."
  (let* ((keys (magit-auto-review-owner--verified-keys batch))
         (items (mapcar #'magit-auto-review-owner--feedback keys))
         (outcomes (alist-get 'outcomes (alist-get 'review batch)))
         (fixed (if outcomes
                    (mapcar (lambda (o) (alist-get 'item o))
                            (cl-remove-if-not (lambda (o) (equal (alist-get 'status o) "fixed")) outcomes))
                  keys))
         (linked (cl-every (lambda (key) (magit-auto-review-owner--linked-commits batch key)) fixed))
         (replies (cl-remove-if-not (lambda (r) (and (member (alist-get 'source r) keys)
                                                    (equal (alist-get 'batch r) (alist-get 'id batch))))
                                    (alist-get 'replies magit-auto-review-owner--view))))
    (cond
     ((alist-get 'superseded_by batch)
      "The same feedback was verified by newer fixes. No resume is needed; this unused batch is retained for inspection.")
     ((magit-auto-review-owner--batch-history-p batch)
      (if (magit-auto-review-owner--batch-resolved-p batch)
          "Finished: replies published and threads resolved. Saved reports and commit links remain available below."
        "Finished locally. Saved reports and commit links remain available below."))
     ((magit-auto-review--true-p (alist-get 'discussion_stale batch)) "Next: inspect the changed feedback, then p replans unfinished work.")
     ((and (not (equal (alist-get 'status batch) "ready"))
           (not (alist-get 'attempts batch)) (not (alist-get 'plans batch)) (not (alist-get 'tasks batch)))
      "No model work has started. R changes provider/model/effort; r resumes with those settings. T applies only to agent-configuration trust requests.")
     ((not (equal (alist-get 'status batch) "ready")) "Next: inspect with d; r resumes, or A adopts manual edits. m opens status only until verification succeeds.")
     ((magit-auto-review-owner--auto-pending-p batch)
      (concat (magit-auto-review-owner--auto-summary batch) "\n"
              (if (magit-auto-review--true-p (alist-get 'inspection_required (alist-get 'commit_execution batch)))
                  "Next: inspect retained commits and changes in Magit; automatic completion requires manual reconciliation."
                "Next: r retries unfinished automatic completion; C-u r selects automatic or manual completion.")))
     ((not keys) "No verified feedback to finish. Inspect the task details and remaining feedback.")
     ((cl-every (lambda (item) (equal (alist-get 'triage item) "handled")) items)
      "Verified feedback is handled locally. Remaining feedback needs separate work; select it under Attention needed.")
     ((and outcomes (not fixed))
      "No new code fix is needed. h marks the verified feedback handled locally.")
     ((member (alist-get 'status (alist-get 'commit_progress batch)) '("diverged" "ambiguous"))
      (concat "Next: inspect in Magit. " (alist-get 'reason (alist-get 'commit_progress batch))))
     ((and (alist-get 'commit_progress batch)
           (< (alist-get 'completed (alist-get 'commit_progress batch)) (alist-get 'total (alist-get 'commit_progress batch))))
      (format "Next: m on this batch prepares commit %d of %d; commit with C-c C-c, then g checks it."
              (1+ (alist-get 'completed (alist-get 'commit_progress batch)))
              (alist-get 'total (alist-get 'commit_progress batch))))
     ((and (not linked) (alist-get 'commit_match batch))
      (if (cl-every (lambda (item) (equal (alist-get 'kind item) "local_review")) items)
          "Exact fix commit detected. g finishes verified local findings; explicitly restored findings stay queued until h or a new fix."
        "Exact fix commit detected. Next: inspect/push it in Magit, then a prepares replies for GitHub feedback."))
     ((not linked) "Next: m prepares or inspects the commit in Magit; after committing, g checks it here.")
     ((cl-every (lambda (item) (equal (alist-get 'kind item) "local_review")) items)
      "Next: h finishes this local feedback and removes it from Attention needed. No GitHub reply is needed.")
     ((cl-some (lambda (issue) (equal (alist-get 'kind issue) "awaiting_push")) (alist-get 'reply_issues batch))
      "Commit linked locally; push required before creating the remaining replies. Push with C-u m, then a creates staged replies; P previews publication.")
     ((alist-get 'reply_issues batch)
      (concat "Reply preparation needs inspection: "
              (string-join (mapcar (lambda (issue) (alist-get 'reason issue)) (alist-get 'reply_issues batch)) "; ")))
     ((cl-some (lambda (r) (equal (alist-get 'status r) "unstaged")) replies)
      "Next: inspect the unstaged replies under Replies, stage those you want with s, then P previews publication.")
     ((cl-some (lambda (r) (and (not (equal (alist-get 'status r) "published"))
                                (magit-auto-review--true-p (alist-get 'awaiting_push r)))) replies)
      "Next: push with C-u m. G checks the push; P also checks it and previews staged replies for publication. No a or s is needed.")
     ((cl-some (lambda (r) (equal (alist-get 'status r) "staged")) replies)
      "Next: inspect the staged replies, then P previews publication. They are already staged; no s is needed.")
     ((not replies) "Commit linked locally. Push with C-u m, then a checks GitHub and creates staged replies; P previews publication.")
     (t "Replies are published. h marks the feedback handled locally; thread resolution remains a separate action."))))

(defun magit-auto-review-owner--insert-batch (batch)
  "Insert a concise result for BATCH with folded verification and history."
  (magit-insert-section section (owner-batch (alist-get 'id batch) t)
    (push section magit-auto-review-owner--sections)
    (magit-auto-review-owner--heading
      (format "%s · %s%s" (magit-auto-review-owner--batch-label batch)
              (if (= (length (alist-get 'items batch)) 1)
                  (magit-auto-review-owner--item-label (car (alist-get 'items batch)))
                (format "%d feedback items" (length (alist-get 'items batch))))
              (magit-auto-review-owner--batch-commit-label batch))
      (if (magit-auto-review-owner--batch-history-p batch)
          'magit-auto-review-owner-item 'magit-auto-review-owner-attention))
    (unless (alist-get 'superseded_by batch)
      (insert (if (magit-auto-review--true-p (alist-get 'auto_commit batch)) "Auto commit" "Manual commit") " · C-u r chooses completion mode\n"))
    (insert (magit-auto-review-owner--next-step batch) "\n")
    (when (equal (alist-get 'status batch) "ready")
      (let* ((plan (alist-get 'commit_plan batch))
             (progress (alist-get 'commit_progress batch))
             (units (alist-get 'units plan)))
        (when (alist-get 'reason plan) (insert "Commit grouping: " (alist-get 'reason plan) "\n"))
        (when (> (length units) 1)
          (insert "Logical fix commits (in order):\n")
          (cl-loop for unit in units for position from 1 do
                   (let ((sha (cdr (cl-find (alist-get 'id unit) (alist-get 'units progress)
                                           :key (lambda (entry) (format "%s" (car entry))) :test #'equal))))
                     (magit-insert-section section (owner-commit-unit (cons (alist-get 'id batch) (alist-get 'id unit)) t)
                       (push section magit-auto-review-owner--sections)
                       (magit-auto-review-owner--heading
                         (format "%d/%d · %s · %s" position (length units)
                                 (cond (sha (concat "Committed " (substring sha 0 (min 12 (length sha)))))
                                       ((member (alist-get 'status progress) '("diverged" "ambiguous")) "Inspect commits")
                                       ((= position (1+ (or (alist-get 'completed progress) 0))) "Ready to commit")
                                       (t "After earlier commit"))
                                 (magit-auto-review-owner--brief
                                  (string-join (mapcar #'magit-auto-review-owner--item-label (alist-get 'items unit)) "; ")))
                         (if sha 'magit-auto-review-owner-item 'magit-auto-review-owner-attention))
                       (insert "m prepares or inspects this commit; d shows its exact patch.\n")
                       (dolist (key (alist-get 'items unit))
                         (insert "  · " (magit-auto-review-owner--item-label key) "\n"))))))))
    (when (> (length (alist-get 'items batch)) 1)
      (insert "Included feedback:\n")
      (dolist (key (alist-get 'items batch))
        (insert "  · " (magit-auto-review-owner--item-label key)
                (if (member key (magit-auto-review-owner--verified-keys batch)) "" " (not verified)") "\n")))
    (unless (equal (alist-get 'status batch) "ready")
      (insert (magit-auto-review-owner--fix-conclusion batch) "\n"))
    (when (and (equal (alist-get 'status batch) "ready")
               (< (length (magit-auto-review-owner--verified-keys batch)) (length (alist-get 'items batch))))
      (insert (format "Verified %d of %d feedback items; h on this fix handles only the verified items.\n"
                      (length (magit-auto-review-owner--verified-keys batch)) (length (alist-get 'items batch)))))
    (when-let ((summary (alist-get 'summary (alist-get 'review batch))))
      (insert "Result: " (magit-auto-review-owner--brief summary 160) "\n"))
    (when (alist-get 'error batch)
      (insert (if (alist-get 'superseded_by batch) "Original stop (historical): " "Last stop: ")
              (magit-auto-review-owner--brief (alist-get 'error batch) 160) "\n"))
    (dolist (attempt (alist-get 'attempts (alist-get 'commit_execution batch)))
      (insert (format "Commit %s · %s%s · artifacts: %s\n" (alist-get 'unit attempt) (alist-get 'status attempt)
                      (if (alist-get 'commit attempt) (concat " · " (alist-get 'commit attempt)) "")
                      (alist-get 'artifacts attempt))))
    (magit-insert-section section (owner-details (cons (alist-get 'id batch) 'verification) t)
      (push section magit-auto-review-owner--sections)
      (magit-auto-review-owner--heading "Verification and task details")
      (insert (format "Started: %s\nBaseline: %s\n" (alist-get 'created_at batch) (alist-get 'baseline batch)))
      (dolist (rejection (alist-get 'plan_rejections batch))
        (insert (format "Rejected plan (%s): %s\n" (alist-get 'at rejection) (alist-get 'error rejection))))
      (dolist (role '(fix review))
        (when-let ((choice (alist-get role (alist-get 'settings batch))))
          (insert (format "Saved %s settings: %s / %s (%s)\n" role
                          (alist-get 'provider choice) (alist-get 'model choice) (alist-get 'effort choice)))))
      (magit-auto-review-owner--insert-report (alist-get 'review batch))
      (dolist (association (alist-get 'associations batch))
        (insert (format "Commit association: %s → %s (%s)\n" (car association)
                        (string-join (alist-get 'commits (cdr association)) ", ") (alist-get 'method (cdr association)))))
      (dolist (task (alist-get 'tasks batch))
        (magit-insert-section section (owner-task (alist-get 'id task) t)
          (push section magit-auto-review-owner--sections)
          (magit-auto-review-owner--heading
            (format "%s · %s" (capitalize (alist-get 'status task))
                    (magit-auto-review-owner--brief
                     (string-join (mapcar #'magit-auto-review-owner--item-label (alist-get 'items task)) "; ")))
            (if (member (alist-get 'status task) '("complete" "skipped"))
                'magit-auto-review-owner-item 'magit-auto-review-owner-attention))
          (insert (format "Plan: %s\nFeedback: %s\nPrerequisites: %s\n"
                          (alist-get 'rationale task) (string-join (alist-get 'items task) ", ")
                          (string-join (alist-get 'depends_on task) ", ")))
          (dolist (expected (alist-get 'expected task))
            (insert (format "Expected for %s: %s\n" (alist-get 'item expected) (alist-get 'outcome expected))))
          (when (magit-auto-review--true-p (alist-get 'verification_superseded task))
            (insert "Earlier verification superseded; inspect the final combined review.\n"))
          (magit-auto-review-owner--insert-report (alist-get 'implementation task))
          (magit-auto-review-owner--insert-report (alist-get 'review task)))))
    (when (alist-get 'attempts batch)
      (magit-insert-section section (owner-details (cons (alist-get 'id batch) 'history) t)
        (push section magit-auto-review-owner--sections)
        (magit-auto-review-owner--heading (format "Attempt history (%d; includes earlier reports)" (length (alist-get 'attempts batch))))
        (dolist (attempt (alist-get 'attempts batch))
          (magit-insert-section section (owner-attempt (alist-get 'path attempt) t)
            (push section magit-auto-review-owner--sections)
            (magit-auto-review-owner--heading (format "%s attempt · %s · %s" (alist-get 'role attempt)
                                         (alist-get 'status attempt) (alist-get 'started_at attempt))
              'magit-auto-review-owner-item)
            (insert (format "Artifacts: %s (L opens the event log)\n" (alist-get 'path attempt)))
            (when (alist-get 'error attempt) (insert (alist-get 'error attempt) "\n"))
            (magit-auto-review-owner--insert-report (alist-get 'result attempt))))))))

(defun magit-auto-review-owner--title (item)
  "Describe ITEM without changing its original wording."
  (let* ((comment (car (alist-get 'comments item)))
         (body (magit-auto-review-owner--comment-body comment))
         (line (car (split-string body "\n" t)))
         (batch (cl-find-if (lambda (b) (member (alist-get 'key item) (alist-get 'items b)))
                            (reverse (alist-get 'batches magit-auto-review-owner--view)))))
    (format "%s%s%s%s%s%s%s"
            (if (equal (alist-get 'kind item) "local_review") "Local review · " "")
            (cond ((magit-auto-review--true-p (alist-get 'is_resolved item)) "Resolved · ")
                  ((equal (alist-get 'triage item) "handled") "Handled · ") (t ""))
            (if (magit-auto-review--true-p (alist-get 'unread item)) "NEW · " "")
            (if (magit-auto-review--true-p (alist-get 'is_outdated item)) "Outdated · " "")
            (if (alist-get 'path item) (concat (alist-get 'path item) " · ") "")
            (truncate-string-to-width (or (alist-get 'title item) line (alist-get 'state item) (alist-get 'key item)) 110 nil nil "…")
            (magit-auto-review-owner--batch-commit-label batch (alist-get 'key item)))))

(defun magit-auto-review-owner--insert-feedback (item)
  "Insert ITEM and its full saved conversation."
  (magit-insert-section section (owner-feedback (alist-get 'key item) t)
    (push section magit-auto-review-owner--sections)
    (magit-auto-review-owner--heading
     (magit-auto-review-owner--title item)
     (if (or (magit-auto-review--true-p (alist-get 'attention item))
             (magit-auto-review-owner--own-available-p item))
         'magit-auto-review-owner-attention 'magit-auto-review-owner-item))
    (when (equal (alist-get 'kind item) "thread")
      (insert (format "Thread: %s%s\n"
                      (if (magit-auto-review--true-p (alist-get 'is_resolved item)) "resolved" "unresolved")
                      (if (magit-auto-review--true-p (alist-get 'is_outdated item)) "; code context outdated" ""))))
    (when (equal (alist-get 'kind item) "review")
      (insert (format "Review verdict: %s%s\n" (alist-get 'state item)
                      (if (magit-auto-review--true-p (alist-get 'change_requested item)) " · outstanding change request" ""))))
    (when (equal (alist-get 'kind item) "local_review")
      (let* ((source (alist-get 'source item))
             (head (alist-get 'head (alist-get 'snapshot source))))
        (insert (format "Local review of %s · %s\n" head (string-join (alist-get 'finding_ids source) ", ")))
        (when (and (alist-get 'metadata magit-auto-review-owner--view)
                   (not (equal head (alist-get 'headRefOid (alist-get 'metadata magit-auto-review-owner--view)))))
          (insert "The PR head has changed since this review; fixes recheck the current code.\n"))
        (insert "No GitHub reply destination; commit associations remain local.\n")
        (magit-auto-review--insert-code (alist-get 'review_context item))
        (dolist (evidence (alist-get 'evidence item)) (insert (format "Evidence: %s\n" evidence)))
        (dolist (comment (alist-get 'comments (alist-get 'thread (alist-get 'review_context item))))
          (insert (format "Saved discussion · %s\n%s\n\n" (alist-get 'author comment) (alist-get 'body comment))))))
    (when (alist-get 'diff_hunk item) (insert (alist-get 'diff_hunk item) "\n\n"))
    (dolist (comment (alist-get 'comments item))
      (insert (format "%s · %s\n%s\n\n" (alist-get 'author comment)
                      (or (alist-get 'url comment) "") (magit-auto-review-owner--comment-body comment))))))

(defun magit-auto-review-owner--own-available-p (item)
  "Whether ITEM is own-authored feedback available for explicit selection."
  (and (magit-auto-review--true-p (alist-get 'own_only item))
       (equal (alist-get 'triage item) "available")
       (not (magit-auto-review--true-p (alist-get 'is_resolved item)))
       (not (magit-auto-review--true-p (alist-get 'missing item)))))

(defun magit-auto-review-owner--render ()
  "Render owner state, retaining section folds and selected heading."
  (let* ((view magit-auto-review-owner--view)
         (old (magit-current-section))
         (selected (and old (cons (oref old type) (oref old value))))
         (old-group (when-let ((group (magit-auto-review-owner--at 'owner-group))) (oref group value)))
         (history (cl-remove-if-not #'magit-auto-review-owner--batch-history-p (reverse (alist-get 'batches view))))
         (folds (mapcar (lambda (s) (cons (cons (oref s type) (oref s value)) (oref s hidden)))
                        magit-auto-review-owner--sections))
         (inhibit-read-only t) target)
    (deactivate-mark)
    (setq magit-auto-review-owner--sections nil)
    (erase-buffer)
    (magit-insert-section (owner-root)
      (magit-auto-review-owner--heading (format "PR Owner · #%s · %s" (or (alist-get 'pr view) "?") (or (alist-get 'repository view) "")))
      (insert "f fix · C-u f fix/commit/replies · g check commits · h finish locally · m commit/status · C-u m inspect · ? actions · M toolkit\n")
      (insert (format "GitHub last checked: %s\n" (or (alist-get 'checked_at view) "never; G fetches feedback")))
      (dolist (role '(fix review))
        (when-let ((choice (alist-get role (alist-get 'settings view))))
          (insert (format "%s: %s / %s / %s\n" (capitalize (symbol-name role))
                          (alist-get 'provider choice) (alist-get 'model choice) (alist-get 'effort choice)))))
      (when (alist-get 'worktree view)
        (insert (format "Worktree: %s\nPush target: %s · %s\n" (alist-get 'worktree view)
                        (or (alist-get 'repository (alist-get 'push_target view)) "unavailable")
                        (alist-get 'branch (alist-get 'push_target view))))
        (let ((remotes (alist-get 'remotes (alist-get 'push_target view))))
          (insert (cond ((= (length remotes) 1) (format "Matching push remote: %s (inspect the destination in Magit)\n" (car remotes)))
                        (remotes (format "Ambiguous push remotes: %s; choose in Magit\n" (string-join remotes ", ")))
                        (t "No matching push remote recorded; configure the displayed destination in Magit\n")))))
      (insert "\n")
      (let ((items (cl-remove-if-not (lambda (i) (magit-auto-review--true-p (alist-get 'attention i))) (alist-get 'feedback view))))
        (magit-insert-section section (owner-group "attention")
          (push section magit-auto-review-owner--sections)
          (magit-auto-review-owner--heading (format "Attention needed (%d)" (length items)))
          (mapc #'magit-auto-review-owner--insert-feedback items)
          (unless items (insert "No attention items in the saved snapshot. G fetches GitHub; o in Reviewer sends local findings here.\n"))))
      (let ((items (cl-remove-if-not #'magit-auto-review-owner--own-available-p (alist-get 'feedback view))))
        (when items
          (magit-insert-section section (owner-group "own")
            (push section magit-auto-review-owner--sections)
            (magit-auto-review-owner--heading (format "Your GitHub comments (%d)" (length items)))
            (insert "Select feedback to fix with f, or use U to queue it under Attention needed.\n")
            (mapc #'magit-auto-review-owner--insert-feedback items))))
      (magit-insert-section section (owner-group "fixes")
        (push section magit-auto-review-owner--sections)
        (let ((active (cl-remove-if #'magit-auto-review-owner--batch-history-p (reverse (alist-get 'batches view)))))
          (magit-auto-review-owner--heading (format "Fixes (%d)" (length active)))
          (mapc #'magit-auto-review-owner--insert-batch active)
          (unless active (insert "No unfinished fixes. Completed fixes are under Deferred / History.\n"))))
      (magit-insert-section section (owner-group "replies")
        (push section magit-auto-review-owner--sections)
        (magit-auto-review-owner--heading "Replies")
        (dolist (status '("unstaged" "staged" "published"))
          (magit-insert-section section (owner-reply-group status)
            (push section magit-auto-review-owner--sections)
            (magit-auto-review-owner--heading (capitalize status))
            (dolist (reply (cl-remove-if-not (lambda (r) (equal (alist-get 'status r) status)) (alist-get 'replies view)))
              (magit-insert-section section (owner-reply (alist-get 'id reply) t)
                (push section magit-auto-review-owner--sections)
                (magit-auto-review-owner--heading (format "Reply to %s%s" (alist-get 'source reply)
                                             (if (magit-auto-review--true-p (alist-get 'awaiting_push reply)) " · Awaiting push" ""))
                  (if (equal status "published") 'magit-auto-review-owner-item 'magit-auto-review-owner-attention))
                (when (alist-get 'needs_attention reply) (insert (alist-get 'needs_attention reply) "\n"))
                (insert (alist-get 'body reply) "\n\n")
                (when (alist-get 'receipt reply) (insert (or (alist-get 'html_url (alist-get 'receipt reply)) "") "\n")))))))
      (magit-insert-section section (owner-group "history" t)
        (push section magit-auto-review-owner--sections)
        (magit-auto-review-owner--heading (format "Deferred / History (%d fixes)" (length history)))
        (mapc #'magit-auto-review-owner--insert-batch history)
        (mapc #'magit-auto-review-owner--insert-feedback
              (cl-remove-if (lambda (i) (or (magit-auto-review--true-p (alist-get 'attention i))
                                           (magit-auto-review-owner--own-available-p i))) (alist-get 'feedback view)))))
    (dolist (section magit-auto-review-owner--sections)
      (let* ((key (cons (oref section type) (oref section value))) (saved (assoc key folds)))
        (when saved (if (cdr saved) (magit-section-hide section) (magit-section-show section)))
        (when (equal key selected) (setq target section))))
    (when (and target (not (equal old-group "history")))
      (let ((parent target))
        (while (and parent (not (eq (oref parent type) 'owner-group)))
          (setq parent (oref parent parent)))
        (when (and parent (equal (oref parent value) "history")) (setq target parent))))
    (goto-char (if target (oref target start) (point-min)))
    (set-buffer-modified-p nil)))

(defun magit-auto-review-owner--insert-report (report)
  "Insert a structured verification REPORT."
  (when report
    (insert (or (alist-get 'summary report) "") "\n")
    (dolist (outcome (alist-get 'outcomes report))
      (insert (format "%s: %s — %s\n" (alist-get 'item outcome) (alist-get 'status outcome) (alist-get 'evidence outcome))))
    (dolist (check (alist-get 'checks report)) (insert "Checked: " check "\n"))
    (dolist (finding (alist-get 'blocking report)) (insert "Blocking: " finding "\n"))))

(defun magit-auto-review-owner--accept (view)
  "Adopt VIEW and render it."
  (setq magit-auto-review-owner--view view
        magit-auto-review--repository (alist-get 'repository view)
        magit-auto-review--target (alist-get 'pr view))
  (magit-auto-review-owner--render))

;;;###autoload
(defun magit-auto-review-owner (&optional pr)
  "Open owner toolkit for PR in the current repository."
  (interactive)
  (magit-auto-review-owner-open (or (magit-toplevel) default-directory)
                               (or pr magit-auto-review--target (read-number "Pull request number: "))
                               magit-auto-review--repository))

(defun magit-auto-review-owner-open (directory number &optional repository)
  "Open cached owner state for NUMBER in DIRECTORY and REPOSITORY."
  (let ((view (magit-auto-review--call `((command . "owner-open") (cwd . ,directory) (pr . ,number)
                                       (repository . ,repository) (defaults . ,(magit-auto-review--default-settings))))))
    (magit-auto-review-owner--show view directory)))

(defun magit-auto-review-owner--show (view directory)
  "Display owner VIEW for DIRECTORY, retaining the existing buffer and folds."
  (let ((buffer (get-buffer-create (format "*PR Owner %s #%s (%s)*" (alist-get 'repository view)
                                         (alist-get 'pr view) (abbreviate-file-name directory)))))
    (pop-to-buffer buffer)
    (unless (derived-mode-p 'magit-auto-review-owner-mode)
      (magit-auto-review-owner-mode)
      (setq default-directory directory))
    (magit-auto-review-owner--accept view)))

(defun magit-auto-review-owner-show-import (result directory)
  "Display handoff RESULT in DIRECTORY and focus the first imported item."
  (magit-auto-review-owner--show (alist-get 'owner result) directory)
  (let ((sections (mapcar (lambda (key)
                            (cl-find-if (lambda (s) (and (eq (oref s type) 'owner-feedback)
                                                        (equal (oref s value) key)))
                                        magit-auto-review-owner--sections))
                          (alist-get 'items result))))
    (when (and sections (cl-every #'identity sections))
      (magit-section-show (oref (car sections) parent))
      (goto-char (oref (car sections) start))
      (deactivate-mark))
    (setq header-line-format (format " %d local finding(s) imported · f fixes the item at point; select a group or region for a batch" (length sections)))
    (message "%s" header-line-format)))

(defun magit-auto-review-owner-refresh ()
  "Reload results and reconcile local fix commits without network access."
  (interactive)
  (let* ((running (process-live-p magit-auto-review-owner--process))
         (view (magit-auto-review--call
                (magit-auto-review-owner--request (if running "owner-read" "owner-reconcile"))))
         (result (alist-get 'reconciliation view)))
    (magit-auto-review-owner--accept view)
    (when result
      (setq header-line-format
            (concat " " (pcase (alist-get 'status result)
                           ("busy" "Saved results reloaded; commit check waits for the running Owner operation")
                           ("unavailable" (concat "Commit check unavailable: " (alist-get 'reason result)))
                           (_ (format "Local commits checked · %d committed groups · %d findings moved to History · %d reopened"
                                      (or (alist-get 'committed_batches result) 0)
                                      (length (alist-get 'handled_items result))
                                      (length (alist-get 'reopened_items result)))))
                    (when (cl-some (lambda (reply) (magit-auto-review--true-p (alist-get 'awaiting_push reply)))
                                   (alist-get 'replies view))
                      " · G checks the push; P previews staged replies")))
      (message "%s" header-line-format))))

(defun magit-auto-review-owner--progress (message)
  "Append MESSAGE with its time and PR identity to the owner progress log."
  (let ((prefix (format "[%s] %s #%s · " (format-time-string "%Y-%m-%d %H:%M:%S UTC" nil t)
                        (alist-get 'repository magit-auto-review-owner--view)
                        (alist-get 'pr magit-auto-review-owner--view))))
    (with-current-buffer (get-buffer-create "*PR Owner progress*")
      (let ((inhibit-read-only t))
        (goto-char (point-max))
        (insert prefix message "\n")))))

(defun magit-auto-review-owner--refresh-summary (view)
  "Describe freshly fetched VIEW, including push confirmations."
  (let* ((replies (alist-get 'replies view))
         (confirmed (cl-count-if
                     (lambda (reply)
                       (and (magit-auto-review--true-p (alist-get 'push_confirmed reply))
                            (magit-auto-review--true-p
                             (alist-get 'awaiting_push (magit-auto-review-owner--reply (alist-get 'id reply)))))) replies))
         (staged (cl-remove-if-not (lambda (r) (equal (alist-get 'status r) "staged")) replies)))
    (concat (if (> confirmed 0) (format "Push confirmed for %d reply(s). " confirmed) "GitHub refreshed. ")
            (cond ((cl-some (lambda (r) (magit-auto-review--true-p (alist-get 'awaiting_push r))) staged)
                   "Some staged replies still await a push; inspect/push with C-u m, then P previews publication.")
                  (staged "Replies are staged; P previews publication. No s is needed.")
                  (t "Saved feedback updated.")))))

(defun magit-auto-review-owner--start (request &optional callback)
  "Run REQUEST asynchronously, optionally passing its result to CALLBACK."
  (when (process-live-p magit-auto-review-owner--process) (user-error "An owner operation is already running"))
  (when (and (equal (alist-get 'command request) "owner-fix")
             (if (assq 'auto_commit request)
                 (magit-auto-review--true-p (alist-get 'auto_commit request))
               (magit-auto-review--true-p
                (alist-get 'auto_commit (cl-find (alist-get 'batch request) (alist-get 'batches magit-auto-review-owner--view)
                                                 :key (lambda (batch) (alist-get 'id batch)) :test #'equal)))))
    (when-let ((path (alist-get 'worktree magit-auto-review-owner--view)))
      (let ((default-directory (file-name-as-directory path)))
        (when (magit-commit-message-buffer)
          (user-error "Finish or cancel the existing Magit commit editor before automatic completion")))))
  (deactivate-mark)
  (setq magit-auto-review-owner--retry request header-line-format " Owner operation running…")
  (let ((scope (cond ((alist-get 'items request) (format " · %d feedback item(s)" (length (alist-get 'items request))))
                     ((alist-get 'batch request) " · resuming selected batch")
                     (t ""))))
    (setq header-line-format (format " Starting %s%s…" (alist-get 'command request) scope))
    (magit-auto-review-owner--progress (format "Starting %s%s%s" (alist-get 'command request) scope
                                             (if (magit-auto-review--true-p (alist-get 'auto_commit request)) " · Auto commit and staged replies" ""))))
  (setq magit-auto-review-owner--process
        (magit-auto-review--async
         request
         (lambda (event)
           (when (equal (alist-get 'type event) "started")
             (setq magit-auto-review-owner--operation (alist-get 'operation_id event)))
           (when (alist-get 'message event)
             (setq header-line-format (concat " " (alist-get 'message event)))
             (magit-auto-review-owner--progress (alist-get 'message event))))
         (lambda (result)
           (setq magit-auto-review-owner--process nil magit-auto-review-owner--operation nil)
           (let* ((batches (alist-get 'batches result))
                  (batch (if-let ((id (alist-get 'batch request)))
                             (cl-find id batches :key (lambda (b) (alist-get 'id b)) :test #'equal)
                           (car (last batches))))
                  (conclusion (cond
                               ((and (equal (alist-get 'command request) "owner-fix") batch)
                                (let ((magit-auto-review-owner--view result)) (magit-auto-review-owner--fix-conclusion batch)))
                               ((equal (alist-get 'command request) "owner-refresh")
                                (magit-auto-review-owner--refresh-summary result))
                               (t "Owner operation complete"))))
             (setq header-line-format (concat " " conclusion))
             (magit-auto-review-owner--progress conclusion)
             (if callback (funcall callback result) (magit-auto-review-owner--accept result))))
         (lambda (error)
           (setq magit-auto-review-owner--process nil magit-auto-review-owner--operation nil
                 header-line-format (concat " " (magit-auto-review--error-message error))
                 magit-auto-review-owner--trust (alist-get 'trusted_snapshot (nth 3 error))
                 magit-auto-review-owner--trust-paths (alist-get 'paths (nth 3 error))
                 magit-auto-review-owner--trust-diff (alist-get 'diff (nth 3 error)))
           (magit-auto-review-owner--progress (concat "Owner operation stopped: " (magit-auto-review--error-message error)))
           (ignore-errors (magit-auto-review-owner--accept
                           (magit-auto-review--call (magit-auto-review-owner--request "owner-read"))))
           (when magit-auto-review-owner--trust (message "%s; T inspects and trusts the changed configuration" header-line-format))))))

(defun magit-auto-review-owner-fetch () "Fetch GitHub feedback explicitly." (interactive)
  (magit-auto-review-owner--start (magit-auto-review-owner--request "owner-refresh")))
(defun magit-auto-review-owner-fix (&optional automatic)
  "Plan, fix, and review selected feedback.
With AUTOMATIC, also commit and stage replies."
  (interactive "P")
  (let ((keys (cl-remove-if-not (lambda (k) (magit-auto-review--true-p (alist-get 'actionable (magit-auto-review-owner--feedback k))))
                                (magit-auto-review-owner--selected 'owner-feedback))))
    (unless keys (user-error "No actionable feedback in this selection"))
    (magit-auto-review-owner--start (magit-auto-review-owner--request "owner-fix" `(items . ,(vconcat keys))
                                   `(auto_commit . ,(if automatic t :false))))))
(defun magit-auto-review-owner-verify () "Verify selected concerns without changing code." (interactive)
  (magit-auto-review-owner--start (magit-auto-review-owner--request "owner-fix" '(verify_only . t)
                              `(items . ,(vconcat (magit-auto-review-owner--selected 'owner-feedback))))))

(defun magit-auto-review-owner--batch-id ()
  "Return the selected or related batch, or the latest saved batch."
  (or (alist-get 'id (magit-auto-review-owner--batch-at-point))
      (alist-get 'id (car (last (alist-get 'batches magit-auto-review-owner--view))))
      (user-error "No saved fix batch")))
(defun magit-auto-review-owner--resume (&rest fields)
  "Resume the selected batch with FIELDS."
  (magit-auto-review-owner--start
   (apply #'magit-auto-review-owner--request "owner-fix"
          `(batch . ,(magit-auto-review-owner--batch-id)) fields)))
(defun magit-auto-review-owner-resume (&optional choose-mode)
  "Resume the selected fix; with CHOOSE-MODE select automatic or manual completion."
  (interactive "P")
  (let ((batch (magit-auto-review-owner--batch-at-point)))
    (unless batch (user-error "Select one fix under Fixes, or its feedback; r does not resume a whole group"))
    (when (alist-get 'superseded_by batch)
      (user-error "This unused batch was superseded by newer verified fixes; no resume is needed"))
    (when (and (alist-get 'commit_match batch) (not choose-mode)
               (not (magit-auto-review-owner--auto-pending-p batch)))
      (user-error "This fix is already committed; m inspects it in Magit"))
    (if choose-mode
        (let ((choice (completing-read "Resume with: " '("Automatic commits and staged replies" "Manual commits") nil t nil nil
                                       (if (magit-auto-review--true-p (alist-get 'auto_commit batch))
                                           "Automatic commits and staged replies" "Manual commits"))))
          (magit-auto-review-owner--resume `(auto_commit . ,(if (equal choice "Manual commits") :false t))))
      (magit-auto-review-owner--resume))))
(defun magit-auto-review-owner-adopt () "Adopt inspected manual changes and reverify." (interactive)
  (when (yes-or-no-p "Adopt current owner worktree changes and reverify affected outcomes? ")
    (magit-auto-review-owner--resume '(adopt . t))))
(defun magit-auto-review-owner-replan () "Replan unfinished work against accumulated changes." (interactive)
  (magit-auto-review-owner--resume '(replan . t)))
(defun magit-auto-review-owner-skip () "Skip the selected task and resume independent work." (interactive)
  (let ((task (magit-auto-review-owner--at 'owner-task)))
    (unless task (user-error "Choose a task to skip"))
    (magit-auto-review-owner--resume `(skip . ,(vector (oref task value))))))

(defun magit-auto-review-owner--mutate (operation &rest fields)
  "Apply local OPERATION with FIELDS."
  (magit-auto-review-owner--accept
   (magit-auto-review--call (apply #'magit-auto-review-owner--request "owner-mutate" `(operation . ,operation) fields))))
(defun magit-auto-review-owner-defer () "Defer selected feedback locally." (interactive)
  (magit-auto-review-owner--mutate "defer" `(items . ,(vconcat (magit-auto-review-owner--selected 'owner-feedback)))))
(defun magit-auto-review-owner-restore () "Restore deferred feedback to attention." (interactive)
  (magit-auto-review-owner--mutate "restore" `(items . ,(vconcat (magit-auto-review-owner--selected 'owner-feedback)))))
(defun magit-auto-review-owner--handling-keys ()
  "Return feedback selected directly or covered by the verified fix at point."
  (or (condition-case nil (magit-auto-review-owner--selected 'owner-feedback) (user-error nil))
      (when (and (not (use-region-p)) (magit-auto-review-owner--at 'owner-batch))
        (let* ((batch (magit-auto-review-owner--batch-at-point))
               (unit (magit-auto-review-owner--commit-unit-at-point))
               (task-section (magit-auto-review-owner--at 'owner-task))
               (task (and task-section (cl-find (oref task-section value) (alist-get 'tasks batch)
                                                :key (lambda (value) (alist-get 'id value)) :test #'equal))))
          (when (and (equal (alist-get 'status batch) "ready")
                     (not (magit-auto-review--true-p (alist-get 'discussion_stale batch))))
            (cl-remove-if-not (lambda (key) (member key (alist-get 'items (or unit task batch))))
                              (magit-auto-review-owner--verified-keys batch)))))))

(defun magit-auto-review-owner-handled ()
  "Finish selected feedback or a verified fix locally, retaining its history."
  (interactive)
  (let ((keys (magit-auto-review-owner--handling-keys)))
    (unless keys (user-error "Select feedback or a verified fix result to mark handled"))
    (setq keys (cl-remove-if (lambda (key) (equal (alist-get 'triage (magit-auto-review-owner--feedback key)) "handled")) keys))
    (unless keys (user-error "Selected feedback is already handled locally"))
    (magit-auto-review-owner--mutate "handled" `(items . ,(vconcat keys)))
    (setq header-line-format (format " Done locally · %d feedback item(s) moved to History" (length keys)))
    (magit-auto-review-owner--progress (string-trim header-line-format))
    (message "%s" header-line-format)))
(defun magit-auto-review-owner-acknowledge () "Acknowledge inspected feedback or reply context." (interactive)
  (if (magit-auto-review-owner--at 'owner-reply)
      (magit-auto-review-owner--mutate "acknowledge-reply" `(replies . ,(vconcat (magit-auto-review-owner--selected 'owner-reply))))
    (magit-auto-review-owner--mutate "acknowledge" `(items . ,(vconcat (magit-auto-review-owner--selected 'owner-feedback))))))
(defun magit-auto-review-owner-stage () "Stage selected replies." (interactive)
  (magit-auto-review-owner--mutate "stage" `(replies . ,(vconcat (magit-auto-review-owner--selected 'owner-reply)))))
(defun magit-auto-review-owner-unstage () "Unstage selected replies." (interactive)
  (magit-auto-review-owner--mutate "unstage" `(replies . ,(vconcat (magit-auto-review-owner--selected 'owner-reply)))))

(defvar magit-auto-review-owner-edit-mode-map
  (let ((map (make-sparse-keymap)))
    (set-keymap-parent map text-mode-map)
    (define-key map (kbd "C-c C-c") #'magit-auto-review-owner-save-reply)
    (define-key map (kbd "C-c C-k") #'kill-current-buffer)
    (define-key map (kbd "C-c C-r") #'magit-auto-review-owner-rebase-reply)
    map))
(define-derived-mode magit-auto-review-owner-edit-mode text-mode "Owner Reply"
  "Edit a local reply; failed saves leave the text intact."
  (setq header-line-format " C-c C-c save locally · C-c C-k cancel · C-c C-r refresh save revision"))

(defun magit-auto-review-owner--editor (request body)
  "Open an editable BODY backed by REQUEST."
  (let ((origin (current-buffer)) (buffer (generate-new-buffer "*Owner reply*")))
    (pop-to-buffer buffer)
    (magit-auto-review-owner-edit-mode)
    (setq magit-auto-review-owner--editor-origin origin magit-auto-review-owner--editor-request request)
    (insert body)
    (set-buffer-modified-p nil)))
(defun magit-auto-review-owner-compose () "Compose a reply to the selected feedback." (interactive)
  (let ((keys (magit-auto-review-owner--selected 'owner-feedback)))
    (unless (= 1 (length keys)) (user-error "Choose one conversation"))
    (when (equal (alist-get 'kind (magit-auto-review-owner--feedback (car keys))) "local_review")
      (user-error "Local findings have no GitHub reply destination; select a GitHub conversation"))
    (magit-auto-review-owner--editor (magit-auto-review-owner--request "owner-mutate" '(operation . "reply") `(item . ,(car keys))) "")))
(defun magit-auto-review-owner-edit () "Edit a saved unpublished reply." (interactive)
  (let* ((ids (magit-auto-review-owner--selected 'owner-reply)) (reply (magit-auto-review-owner--reply (car ids))))
    (unless (and (= 1 (length ids)) (not (equal (alist-get 'status reply) "published"))) (user-error "Choose one unpublished reply"))
    (magit-auto-review-owner--editor (magit-auto-review-owner--request "owner-mutate" '(operation . "edit") `(reply . ,(car ids))) (alist-get 'body reply))))
(defun magit-auto-review-owner-save-reply () "Save locally, preserving text on stale-save errors." (interactive)
  (let* ((request (copy-tree magit-auto-review-owner--editor-request))
         (origin magit-auto-review-owner--editor-origin) (editor (current-buffer)))
    (setf (alist-get 'body request) (buffer-string))
    (let ((view (magit-auto-review--call request)))
      (when (buffer-live-p origin)
        (with-current-buffer origin (magit-auto-review-owner--accept view))
        (pop-to-buffer origin))
      (with-current-buffer editor (set-buffer-modified-p nil))
      (kill-buffer editor))))
(defun magit-auto-review-owner-rebase-reply () "Explicitly refresh the revision for retained editor text." (interactive)
  (let ((view (magit-auto-review--call `((command . "owner-read") (session . ,(alist-get 'session magit-auto-review-owner--editor-request))))))
    (when (yes-or-no-p "Use the latest revision for this retained text (saving may replace newer draft wording)? ")
      (setf (alist-get 'revision magit-auto-review-owner--editor-request) (alist-get 'revision view)))))

(defun magit-auto-review-owner-diff (&optional current)
  "Inspect a logical fix, task, or batch; CURRENT shows partial changes."
  (interactive "P")
  (let* ((task (magit-auto-review-owner--at 'owner-task))
         (unit (magit-auto-review-owner--commit-unit-at-point))
         (result (magit-auto-review--call (magit-auto-review-owner--request "owner-diff"
                  `(batch . ,(magit-auto-review-owner--batch-id)) `(task . ,(and task (oref task value)))
                  `(unit . ,(alist-get 'id unit))
                  `(current . ,(if current t :false))))))
    (pop-to-buffer (get-buffer-create "*Owner fix diff*"))
    (let ((inhibit-read-only t)) (erase-buffer) (insert (alist-get 'diff result)) (diff-mode) (view-mode 1))))
(defun magit-auto-review-owner--push-header ()
  "Show the PR destination and upstream action in an owner Magit buffer."
  (let* ((view magit-auto-review-owner--handoff)
         (branch (magit-get-current-branch))
         (target (alist-get 'push_target view))
         (remote (and branch (magit-get "branch" branch "remote")))
         (merge (and branch (magit-get "branch" branch "merge")))
         (matches (and (member remote (alist-get 'remotes target))
                       (equal merge (concat "refs/heads/" (alist-get 'branch target))))))
    (if (not (equal branch (alist-get 'branch view)))
        (magit-insert-push-branch-header)
      (insert (format "Push PR:  %s · %s\n"
                      (if matches (concat remote "/" (alist-get 'branch target))
                        (format "%s / %s" (or (alist-get 'repository target) "unknown repository")
                                (or (alist-get 'branch target) "unknown branch")))
                      (if matches "P u (upstream)" "configure this upstream before pushing"))))))

(defun magit-auto-review-owner-magit (&optional inspect)
  "Stage the selected logical fix or the batch's next commit in native Magit.
With prefix INSPECT, open status only.  Existing commit messages are retained."
  (interactive "P")
  (let* ((path (alist-get 'worktree magit-auto-review-owner--view))
         (view magit-auto-review-owner--view)
         (batch (magit-auto-review-owner--batch-at-point))
         (unit (magit-auto-review-owner--commit-unit-at-point))
         (feedback (magit-auto-review-owner--at 'owner-feedback))
         (task (magit-auto-review-owner--at 'owner-task))
         (running (process-live-p magit-auto-review-owner--process))
         prepared editor)
    (unless (and path (file-directory-p path)) (user-error "Run a fix to prepare the owner worktree first"))
    (let ((default-directory (file-name-as-directory path)))
      (setq editor (magit-commit-message-buffer)))
    (unless (or inspect running editor)
      (condition-case error
          (progn
            (setq prepared (magit-auto-review--call
                            (magit-auto-review-owner--request "owner-prepare-commit"
                              `(batch . ,(alist-get 'id batch))
                              `(unit . ,(alist-get 'id unit))
                              `(item . ,(and feedback (oref feedback value)))
                              `(task . ,(and task (oref task value))))))
            (setq view (alist-get 'owner prepared))
            (magit-auto-review-owner--accept view))
        (magit-auto-review-api-error
         (setq prepared `((reason . ,(magit-auto-review--error-message error)))))))
    (with-current-buffer (magit-status-setup-buffer path)
      (setq-local magit-auto-review-owner--handoff view)
      (setq-local magit-status-headers-hook
                  (cons #'magit-auto-review-owner--push-header
                        (remq #'magit-auto-review-owner--push-header
                              (remq #'magit-insert-push-branch-header magit-status-headers-hook))))
      (magit-refresh)
      (cond
       ((and editor (not inspect)) (pop-to-buffer editor))
       ((magit-auto-review--true-p (alist-get 'ready prepared))
        (when (alist-get 'position prepared)
          (message "Preparing fix commit %d of %d" (alist-get 'position prepared) (alist-get 'total prepared)))
        (let ((magit-commit-ask-to-stage nil))
          (magit-commit-create (list "--edit" (concat "--message=" (alist-get 'message prepared))))))
       ((alist-get 'reason prepared) (message "%s" (alist-get 'reason prepared)))))))
(defun magit-auto-review-owner--association-result (view &optional batch-id)
  "Display VIEW with a visible summary of saved associations for BATCH-ID."
  (magit-auto-review-owner--accept view)
  (let ((batches (cl-remove-if-not (lambda (b) (or (not batch-id) (equal (alist-get 'id b) batch-id)))
                                  (alist-get 'batches view)))
        items commits)
    (dolist (batch batches)
      (dolist (association (alist-get 'associations batch))
        (when (alist-get 'commits (cdr association)) (push (format "%s" (car association)) items)))
      (setq commits (append commits (magit-auto-review-owner--linked-commits batch))))
    (let ((summary (if commits
                       (format "Saved commit associations: %d feedback item(s)%s" (length (delete-dups items))
                               (magit-auto-review-owner--commit-label (delete-dups commits)))
                     "No matching commit associations; inspect the commits or use C-u a for an explicit association.")))
      (setq header-line-format (concat " " summary))
      (when commits
        (setq summary (concat summary " · "
                              (string-join (mapcar #'magit-auto-review-owner--next-step
                                                  (cl-remove-if-not #'magit-auto-review-owner--linked-commits batches)) " "))
              header-line-format (concat " " summary)))
      (magit-auto-review-owner--progress summary)
      (message "%s" summary))))

(defun magit-auto-review-owner-associate (explicit)
  "Detect exact commits; with EXPLICIT prefix, associate chosen commits."
  (interactive "P")
  (let ((request (magit-auto-review-owner--request "owner-associate")))
    (when explicit
      (let* ((id (magit-auto-review-owner--batch-id))
             (batch (cl-find id (alist-get 'batches magit-auto-review-owner--view) :key (lambda (b) (alist-get 'id b)) :test #'equal))
             (choices (mapcar (lambda (o) (alist-get 'item o))
                             (cl-remove-if-not (lambda (o) (equal (alist-get 'status o) "fixed"))
                                               (alist-get 'outcomes (alist-get 'review batch)))))
             (items (completing-read-multiple "Feedback to associate (empty = all verified fixes): " choices nil t)))
        (setf (alist-get 'batch request) id
              (alist-get 'items request) (vconcat (or items choices))
              (alist-get 'commits request) (vconcat (split-string (read-string "Fix commit SHA(s), separated by spaces: ") " +" t)))))
    (magit-auto-review-owner--start request
      (lambda (view) (magit-auto-review-owner--association-result view (alist-get 'batch request))))))
(defun magit-auto-review-owner-publish () "Inspect exact staged replies and explicitly publish." (interactive)
  (magit-auto-review-owner--start
   (magit-auto-review-owner--request "owner-prepare")
   (lambda (result)
     (magit-auto-review-owner--accept (alist-get 'owner result))
     (let ((origin (current-buffer)))
       (with-current-buffer (get-buffer-create "*Owner publication preview*")
         (let ((inhibit-read-only t))
           (erase-buffer)
           (dolist (reply (alist-get 'replies result))
             (insert (format "Destination: %s\n%s\n\n" (alist-get 'source reply) (alist-get 'body reply))))
           (special-mode))
         (display-buffer (current-buffer)))
       (with-current-buffer origin
         (when (yes-or-no-p (format "Publish these %d replies to GitHub? " (length (alist-get 'replies result))))
           (magit-auto-review-owner--start (magit-auto-review-owner--request "owner-publish" `(token . ,(alist-get 'token result))))))))))
(defun magit-auto-review-owner-recover () "Recover uncertain publication through read-back." (interactive)
  (magit-auto-review-owner--start (magit-auto-review-owner--request "owner-recover")))
(defun magit-auto-review-owner--thread (resolved)
  "Explicitly set thread RESOLVED state."
  (let ((keys (magit-auto-review-owner--selected 'owner-feedback)))
    (unless (= 1 (length keys)) (user-error "Choose one thread"))
    (unless (equal (alist-get 'kind (magit-auto-review-owner--feedback (car keys))) "thread")
      (user-error "Choose a GitHub review thread"))
    (magit-auto-review-owner--start (magit-auto-review-owner--request "owner-thread-state" `(item . ,(car keys)) `(resolved . ,(if resolved t :false))))))
(defun magit-auto-review-owner-resolve () "Resolve the selected GitHub thread." (interactive) (magit-auto-review-owner--thread t))
(defun magit-auto-review-owner-reopen () "Reopen the selected GitHub thread." (interactive) (magit-auto-review-owner--thread nil))
(defun magit-auto-review-owner-cancel () "Cancel the owned provider operation." (interactive)
  (unless magit-auto-review-owner--operation (user-error "No cancellable provider operation"))
  (magit-auto-review--call `((command . "cancel") (operation_id . ,magit-auto-review-owner--operation))))
(defun magit-auto-review-owner-trust () "Inspect and explicitly authorize changed agent configuration." (interactive)
  (unless magit-auto-review-owner--trust (user-error "No agent-configuration trust request"))
  (let ((patch magit-auto-review-owner--trust-diff)
        (paths magit-auto-review-owner--trust-paths))
    (with-current-buffer (get-buffer-create "*Owner agent configuration*")
      (let ((inhibit-read-only t))
        (erase-buffer) (insert "Changed configuration: " (string-join paths ", ") "\n\n" (or patch ""))
        (diff-mode) (view-mode 1))
      (display-buffer (current-buffer))))
  (magit-auto-review-owner-confirm-trust))

(defun magit-auto-review-owner-confirm-trust () "Authorize the pending trust token and resume its exact batch." (interactive)
  (unless magit-auto-review-owner--trust (user-error "No pending agent-configuration trust request"))
  (when (yes-or-no-p "Trust the changed agent configuration inspected in the owner worktree? ")
    (magit-auto-review-owner--resume `(trusted_snapshot . ,magit-auto-review-owner--trust))))
(defun magit-auto-review-owner-log () "Show owner process activity." (interactive)
  (if-let ((attempt (magit-auto-review-owner--at 'owner-attempt)))
      (find-file-read-only (expand-file-name "events.jsonl" (oref attempt value)))
    (pop-to-buffer (get-buffer-create "*PR Owner progress*")) (special-mode)))
(defun magit-auto-review-owner-browse () "Open the selected feedback, receipt, or PR." (interactive)
  (let* ((section (magit-auto-review-owner--at 'owner-feedback))
         (reply-section (magit-auto-review-owner--at 'owner-reply))
         (item (and section (magit-auto-review-owner--feedback (oref section value))))
         (reply (and reply-section (magit-auto-review-owner--reply (oref reply-section value)))))
    (browse-url (or (alist-get 'html_url (alist-get 'receipt reply))
                    (alist-get 'url item) (alist-get 'url (car (alist-get 'comments item)))
                    (alist-get 'url magit-auto-review-owner--view)))))

(defun magit-auto-review-owner-configure (role)
  "Choose provider, model, and effort for ROLE using fresh metadata."
  (let ((provider (completing-read (concat (capitalize role) " provider: ") '("claude" "codex") nil t)))
    (magit-auto-review-owner--start
     `((command . "models") (provider . ,provider))
     (lambda (catalog)
       (let* ((models (alist-get 'models catalog))
              (model (completing-read "Model: " (mapcar (lambda (m) (alist-get 'value m)) models) nil t))
              (info (cl-find model models :key (lambda (m) (alist-get 'value m)) :test #'equal))
              (effort (completing-read "Effort: " (alist-get 'efforts info) nil t))
              (settings (copy-tree (alist-get 'settings magit-auto-review-owner--view))))
         (setf (alist-get (intern role) settings) `((provider . ,provider) (model . ,model) (effort . ,effort)))
         (magit-auto-review-owner--mutate "settings" `(settings . ,settings)))))))
(defun magit-auto-review-owner-configure-fix () "Configure fix provider settings." (interactive) (magit-auto-review-owner-configure "fix"))
(defun magit-auto-review-owner-configure-review () "Configure automatic-review settings." (interactive) (magit-auto-review-owner-configure "review"))

(transient-define-prefix magit-auto-review-owner-setup ()
  "Configure owner providers without invoking inference."
  [["Provider settings"
    ("f" "Fix provider/model/effort" magit-auto-review-owner-configure-fix)
    ("r" "Review provider/model/effort" magit-auto-review-owner-configure-review)]
   ["Recovery"
    ("T" "Trust and resume inspected agent configuration" magit-auto-review-owner-confirm-trust)
    ("q" "Close" transient-quit-one)]])

(defun magit-auto-review-owner--menu-actions ()
  "Return actions applicable to the selected feedback, fix, or reply."
  (let* ((batch (magit-auto-review-owner--batch-at-point))
         (keys (condition-case nil (magit-auto-review-owner--selected 'owner-feedback) (user-error nil)))
         (items (mapcar #'magit-auto-review-owner--feedback keys))
         (reply-ids (condition-case nil (magit-auto-review-owner--selected 'owner-reply) (user-error nil)))
         (replies (mapcar #'magit-auto-review-owner--reply reply-ids))
         (handling (magit-auto-review-owner--handling-keys))
         (ready (and (equal (alist-get 'status batch) "ready")
                     (not (magit-auto-review--true-p (alist-get 'discussion_stale batch)))))
         (handled (and batch (magit-auto-review-owner--batch-handled-p batch)))
         (progress (alist-get 'commit_progress batch))
         (unit (or (magit-auto-review-owner--commit-unit-at-point)
                   (and (= (length items) 1)
                        (cl-find-if (lambda (value) (member (alist-get 'key (car items)) (alist-get 'items value)))
                                    (alist-get 'units (alist-get 'commit_plan batch))))))
         (unit-committed (and unit (cl-find (alist-get 'id unit) (alist-get 'units progress)
                                           :key (lambda (entry) (format "%s" (car entry))) :test #'equal)))
         (running (process-live-p magit-auto-review-owner--process))
         actions)
    (cl-labels ((offer (condition key label command) (when condition (push (list key label command) actions))))
      (offer running "K" "Cancel running operation" #'magit-auto-review-owner-cancel)
      (unless running
        (offer (and handling (cl-some (lambda (key) (not (equal (alist-get 'triage (magit-auto-review-owner--feedback key)) "handled"))) handling))
               "h" "Finish locally (mark handled)" #'magit-auto-review-owner-handled)
        (offer (and items (not ready) (cl-some (lambda (i) (magit-auto-review--true-p (alist-get 'actionable i))) items))
               "f" "Fix/review (C-u: commit and stage replies)" #'magit-auto-review-owner-fix)
        (offer (and items (not ready)) "V" "Verify existing code" #'magit-auto-review-owner-verify)
        (offer (and items (cl-some (lambda (i) (not (member (alist-get 'triage i) '("handled" "deferred")))) items))
               "k" "Defer feedback" #'magit-auto-review-owner-defer)
        (offer (and items (cl-some (lambda (i) (member (alist-get 'triage i) '("handled" "deferred"))) items))
               "U" "Return feedback to Attention" #'magit-auto-review-owner-restore)
        (offer (and (= (length items) 1) (not (equal (alist-get 'kind (car items)) "local_review")))
               "c" "Compose a GitHub reply" #'magit-auto-review-owner-compose)
        (offer (or (cl-some (lambda (i) (magit-auto-review--true-p (alist-get 'unread i))) items)
                   (and (magit-auto-review-owner--at 'owner-reply)
                        (cl-some (lambda (r) (alist-get 'needs_attention r)) replies)))
               "i" "Acknowledge inspected context" #'magit-auto-review-owner-acknowledge)
        (when (and (= (length items) 1) (equal (alist-get 'kind (car items)) "thread"))
          (offer (and (not (magit-auto-review--true-p (alist-get 'is_resolved (car items))))
                      (magit-auto-review--true-p (alist-get 'can_resolve (car items))))
                 "x" "Resolve this GitHub thread" #'magit-auto-review-owner-resolve)
          (offer (and (magit-auto-review--true-p (alist-get 'is_resolved (car items)))
                      (magit-auto-review--true-p (alist-get 'can_unresolve (car items))))
                 "X" "Reopen this GitHub thread" #'magit-auto-review-owner-reopen))
        (when (and batch (not ready) (not handled) (not (alist-get 'superseded_by batch)))
          (offer t "r" "Resume fix" #'magit-auto-review-owner-resume)
          (offer t "A" "Adopt inspected edits and reverify" #'magit-auto-review-owner-adopt)
          (offer t "p" "Replan unfinished work" #'magit-auto-review-owner-replan)
          (offer (magit-auto-review-owner--at 'owner-task) "S" "Skip this task and resume" #'magit-auto-review-owner-skip))
        (when (and ready (or (magit-auto-review-owner--auto-pending-p batch)
                             (and (not (alist-get 'commit_match batch)) (not (magit-auto-review-owner--linked-commits batch)))))
          (offer t "r" "Resume completion (C-u: choose mode)" #'magit-auto-review-owner-resume))
        (offer (and batch ready (not handled) (not (magit-auto-review-owner--linked-commits batch)))
               "a" "Link the fix commit" #'magit-auto-review-owner-associate)
        (offer (and (= (length replies) 1) (not (equal (alist-get 'status (car replies)) "published")))
               "e" "Edit reply" #'magit-auto-review-owner-edit)
        (offer (and replies (cl-every (lambda (r) (equal (alist-get 'status r) "unstaged")) replies))
               "s" "Stage replies" #'magit-auto-review-owner-stage)
        (offer (and replies (cl-every (lambda (r) (equal (alist-get 'status r) "staged")) replies))
               "u" "Unstage replies" #'magit-auto-review-owner-unstage)
        (offer (cl-some (lambda (r) (equal (alist-get 'status r) "staged")) replies)
               "P" "Preview and publish staged replies" #'magit-auto-review-owner-publish)
        (offer magit-auto-review-owner--trust "T" "Inspect changed agent configuration" #'magit-auto-review-owner-trust))
      (offer batch "d" "Inspect fix diff" #'magit-auto-review-owner-diff)
      (offer (and (alist-get 'worktree magit-auto-review-owner--view) (or batch running))
             "m" (if (and ready (not handled)
                          (if progress
                              (and (member (alist-get 'status progress) '("unstarted" "partial")) (not unit-committed))
                            (and (not (alist-get 'commit_match batch)) (not (magit-auto-review-owner--linked-commits batch)))))
                     "Prepare commit in Magit" "Inspect worktree in Magit") #'magit-auto-review-owner-magit)
      (offer (or batch running) "L" "Progress / selected attempt log" #'magit-auto-review-owner-log)
      (unless (or items batch replies running)
        (offer t "G" "Fetch GitHub feedback" #'magit-auto-review-owner-fetch)
        (offer t "R" "Provider settings" #'magit-auto-review-owner-setup)
        (offer t "B" "Pull requests" #'magit-auto-review-pull-requests)
        (offer t "M" "Select toolkit" #'magit-auto-review-select-toolkit)))
    (nreverse actions)))

(defun magit-auto-review-owner--context-help (_children)
  "Explain the selected workflow state above its contextual actions."
  (transient-parse-suffixes
   'magit-auto-review-owner-menu
   (list (if-let ((batch (magit-auto-review-owner--batch-at-point)))
             (magit-auto-review-owner--next-step batch)
           "Actions apply to the selected item or group. + shows the complete command reference."))))

(defun magit-auto-review-owner--context-actions (_children)
  "Build the contextual owner actions."
  (transient-parse-suffixes 'magit-auto-review-owner-menu (magit-auto-review-owner--menu-actions)))

(transient-define-prefix magit-auto-review-owner-menu ()
  "Show the next step and commands relevant to the current selection."
  [:class transient-column :setup-children magit-auto-review-owner--context-help]
  [["Selected item" :class transient-column :setup-children magit-auto-review-owner--context-actions]
   ["Navigation"
    ("g" "Reload / check local commits" magit-auto-review-owner-refresh)
    ("+" "All commands…" magit-auto-review-owner-all-menu)
    ("q" "Close" transient-quit-one)]])

(transient-define-prefix magit-auto-review-owner-all-menu ()
  "Complete owner command reference; individual commands check their targets."
  [["Feedback"
    ("f" "Fix/review (C-u: commit and stage replies)" magit-auto-review-owner-fix)
    ("V" "Verify existing fix" magit-auto-review-owner-verify)
    ("c" "Compose reply" magit-auto-review-owner-compose)
    ("i" "Acknowledge inspected context" magit-auto-review-owner-acknowledge)
    ("h" "Mark handled locally" magit-auto-review-owner-handled)
    ("k" "Defer" magit-auto-review-owner-defer)
    ("U" "Restore deferred" magit-auto-review-owner-restore)
    ("x" "Resolve thread" magit-auto-review-owner-resolve)
    ("X" "Reopen thread" magit-auto-review-owner-reopen)]
   ["Fixes"
    ("R" "Provider settings" magit-auto-review-owner-setup)
    ("r" "Resume batch" magit-auto-review-owner-resume)
    ("A" "Adopt manual changes / reverify" magit-auto-review-owner-adopt)
    ("p" "Replan unfinished tasks" magit-auto-review-owner-replan)
    ("S" "Skip task / resume" magit-auto-review-owner-skip)
    ("d" "Task/batch diff" magit-auto-review-owner-diff)
    ("m" "Prepare commit in Magit (prefix: inspect)" magit-auto-review-owner-magit)
    ("a" "Associate commits (prefix: explicit)" magit-auto-review-owner-associate)]
   ["Replies"
    ("e" "Edit reply" magit-auto-review-owner-edit)
    ("s" "Stage" magit-auto-review-owner-stage)
    ("u" "Unstage" magit-auto-review-owner-unstage)
    ("P" "Preview/publish staged" magit-auto-review-owner-publish)
    ("O" "Recover uncertain publication" magit-auto-review-owner-recover)]
   ["Navigation"
    ("g" "Reload / check local commits" magit-auto-review-owner-refresh)
    ("G" "Fetch GitHub" magit-auto-review-owner-fetch)
    ("M" "Select toolkit" magit-auto-review-select-toolkit)
    ("K" "Cancel operation" magit-auto-review-owner-cancel)
    ("L" "Progress" magit-auto-review-owner-log)
    ("b" "Open on GitHub" magit-auto-review-owner-browse)
    ("q" "Close" transient-quit-one)]])

(provide 'magit-auto-review-owner)
