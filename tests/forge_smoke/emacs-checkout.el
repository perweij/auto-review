;;; emacs-checkout.el --- Real-backend smoke checks -*- lexical-binding: t; -*-
(require 'magit-auto-review)
(require 'magit-auto-review-owner)
(require 'dired)
(setq magit-auto-review-executable (getenv "SMOKE_BACKEND"))
(unless (eq (lookup-key magit-auto-review-mode-map (kbd "w"))
            #'magit-auto-review-open-checkout)
  (error "Reviewer w does not open checkout"))
(unless (eq (lookup-key magit-auto-review-owner-mode-map (kbd "w"))
            #'magit-auto-review-owner-open-checkout)
  (error "Owner w does not open checkout"))
(dolist (item (json-parse-string (getenv "SMOKE_EMACS_CASES")
                               :object-type 'alist :array-type 'list :null-object nil))
  (if (alist-get 'missing item)
      (condition-case nil
          (progn
            (magit-auto-review--open-checkout (alist-get 'toolkit item)
                                             (alist-get 'session item)
                                             (alist-get 'generation item))
            (error "Missing checkout unexpectedly opened"))
        (user-error nil))
    (magit-auto-review--open-checkout (alist-get 'toolkit item)
                                     (alist-get 'session item)
                                     (alist-get 'generation item))
    (unless (and (derived-mode-p 'dired-mode)
                 (equal (file-truename default-directory)
                        (file-name-as-directory (file-truename (alist-get 'path item)))))
      (error "Dired opened the wrong checkout"))))
