;;; gitlab-owner-emacs.el --- Native Owner workflow -*- lexical-binding: t; -*-
(require 'magit-auto-review-owner)
(setq magit-auto-review-executable (getenv "SMOKE_BACKEND"))
(defvar owner-smoke-previews nil)
(defvar owner-smoke-error nil)
(defun owner-smoke-assert (condition message)
  (unless condition (error "%s" message)))
(defun owner-smoke-wait ()
  (let ((deadline (+ (float-time) 900)))
    (while (and magit-auto-review-owner--process (< (float-time) deadline))
      (accept-process-output nil 0.1)))
  (owner-smoke-assert (not magit-auto-review-owner--process) "Owner operation timed out")
  (owner-smoke-assert (not owner-smoke-error) (format "Owner operation failed: %s" owner-smoke-error)))
(defun owner-smoke-goto (type value)
  (let ((section (cl-find-if (lambda (s) (and (eq (oref s type) type) (equal (oref s value) value)))
                             magit-auto-review-owner--sections)))
    (owner-smoke-assert section (format "Missing section %s %s" type value))
    (goto-char (oref section start))))
(defun owner-smoke-wait-head ()
  "Wait for native REST metadata and the MR fetch ref after explicit push."
  (let* ((view magit-auto-review-owner--view)
         (default-directory (file-name-as-directory (alist-get 'worktree view)))
         (sha (string-trim (with-temp-buffer (process-file "git" nil t nil "rev-parse" "HEAD") (buffer-string))))
         (endpoint (format "projects/%s/merge_requests/%s"
                           (url-hexify-string (alist-get 'path (alist-get 'forge_project view)))
                           (alist-get 'pr view)))
         ready)
    (dotimes (_ 30)
      (unless ready
        (let* ((remote (with-temp-buffer
                         (process-file "git" nil t nil "ls-remote" "origin"
                                       (format "refs/merge-requests/%s/head" (alist-get 'pr view)))
                         (buffer-string)))
               (raw (with-temp-buffer
                      (owner-smoke-assert (zerop (process-file "glab" nil t nil "api" "--hostname" "gitlab.com"
                                                              "--method" "GET" endpoint)) "MR metadata lookup failed")
                      (json-parse-string (buffer-string) :object-type 'alist))))
          (setq ready (and (string-prefix-p sha remote) (equal sha (alist-get 'sha raw))
                           (equal sha (alist-get 'head_sha (alist-get 'diff_refs raw)))))
        (unless ready (sleep-for 1)))))
    (owner-smoke-assert ready "GitLab MR ref did not converge after push")))
(defun owner-smoke-publish (answer)
  (cl-letf (((symbol-function 'yes-or-no-p)
             (lambda (_prompt)
               (with-current-buffer "*Owner publication preview*"
                 (owner-smoke-assert buffer-read-only "Owner preview is editable")
                 (push (buffer-string) owner-smoke-previews))
               answer)))
    (magit-auto-review-owner-publish)
    (owner-smoke-wait)))
;; Record async failures without replacing the real transport or callbacks.
(advice-add 'magit-auto-review-owner--progress :before
            (lambda (message)
              (when (string-prefix-p "Owner operation stopped:" message)
                (setq owner-smoke-error message))))
(let* ((default-directory (file-name-as-directory (getenv "SMOKE_CWD")))
       (url (getenv "SMOKE_MR_URL")) origin session key thread-key fingerprint usage)
  (magit-auto-review-owner-open default-directory url nil "gitlab")
  (setq origin (current-buffer) session (alist-get 'session magit-auto-review-owner--view))
  (owner-smoke-assert (equal magit-auto-review--forge "gitlab") "Owner lost forge identity")
  (magit-auto-review-owner-fetch)
  (owner-smoke-wait)
  (setq key (alist-get 'key (cl-find (string-to-number (getenv "SMOKE_COMMENT_ID"))
                                    (alist-get 'feedback magit-auto-review-owner--view)
                                    :key (lambda (item) (alist-get 'root_id item)))))
  (setq thread-key (alist-get 'key (cl-find (string-to-number (getenv "SMOKE_ROOT_ID"))
                                           (alist-get 'feedback magit-auto-review-owner--view)
                                           :key (lambda (item) (alist-get 'root_id item)))))
  (setq fingerprint (alist-get 'fingerprint (magit-auto-review-owner--feedback key)))
  (owner-smoke-goto 'owner-feedback key)
  (magit-auto-review-owner-compose)
  (owner-smoke-assert (equal magit-auto-review--forge "gitlab") "Reply editor lost forge identity")
  (insert "Emacs Owner acknowledgment.\n/close")
  (magit-auto-review-owner-save-reply)
  (owner-smoke-goto 'owner-reply (alist-get 'id (car (last (alist-get 'replies magit-auto-review-owner--view)))))
  (magit-auto-review-owner-stage)
  (owner-smoke-publish nil)
  (owner-smoke-assert (equal (alist-get 'status (car (last (alist-get 'replies magit-auto-review-owner--view)))) "staged")
                      "Declining publication changed reply status")
  (owner-smoke-publish t)
  (magit-auto-review-owner-fetch)
  (owner-smoke-wait)
  (owner-smoke-assert (equal fingerprint (alist-get 'fingerprint (magit-auto-review-owner--feedback key)))
                      "Conversion changed the Owner feedback fingerprint")
  (owner-smoke-assert (string-match-p "/​close" (car owner-smoke-previews)) "Preview omitted slash protection")
  (magit-auto-review-owner--mutate "settings"
    '(settings . ((fix . ((provider . "codex") (model . "gpt-6.1-terra") (effort . "high")))
                  (review . ((provider . "codex") (model . "gpt-6.1-terra") (effort . "high")))
                  (verification . "focused"))))
  (owner-smoke-goto 'owner-feedback thread-key)
  (magit-auto-review-owner-restore)
  (owner-smoke-goto 'owner-feedback thread-key)
  (magit-auto-review-owner-fix t)
  (owner-smoke-wait)
  (owner-smoke-assert (equal "ready" (alist-get 'status (car (last (alist-get 'batches magit-auto-review-owner--view)))))
                      "Owner fixing did not reach ready")
  (let ((default-directory (file-name-as-directory (alist-get 'worktree magit-auto-review-owner--view))))
    (owner-smoke-assert (zerop (process-file "python3" nil "*Owner smoke checks*" nil "-m" "unittest")) "Native unit test failed")
    (owner-smoke-assert (zerop (process-file "git" nil "*Owner smoke push*" nil "push" "origin"
                                            (concat "HEAD:refs/heads/" (getenv "SMOKE_SOURCE_BRANCH"))))
                        "Explicit fix push failed"))
  (owner-smoke-wait-head)
  (magit-auto-review-owner-fetch)
  (owner-smoke-wait)
  (magit-auto-review-owner-associate nil)
  (owner-smoke-wait)
  (owner-smoke-publish t)
  (setq fingerprint (alist-get 'fingerprint (magit-auto-review-owner--feedback thread-key)))
  (dolist (resolved '(t nil t))
    (owner-smoke-goto 'owner-feedback thread-key)
    (if resolved (magit-auto-review-owner-resolve) (magit-auto-review-owner-reopen))
    (owner-smoke-wait)
    (owner-smoke-assert (equal fingerprint (alist-get 'fingerprint (magit-auto-review-owner--feedback thread-key)))
                        "Resolution invalidated semantic evidence"))
  (owner-smoke-assert (alist-get 'remote_completion (magit-auto-review-owner--feedback thread-key))
                      "GitLab completion proof is missing")
  (setq usage (alist-get 'roles (alist-get 'usage magit-auto-review-owner--view)))
  (magit-auto-review-owner-publish-report)
  (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "Owner")))
    (magit-auto-review-select-toolkit))
  (kill-buffer origin)
  (magit-auto-review--open-pr (file-name-as-directory (getenv "SMOKE_CWD")) url nil "gitlab")
  (owner-smoke-assert (equal session (alist-get 'session magit-auto-review-owner--view)) "Retained Owner session was not reopened")
  (owner-smoke-assert (equal usage (alist-get 'roles (alist-get 'usage magit-auto-review-owner--view)))
                      "Reopen or reports performed model work")
  (let ((evidence `((view . ,magit-auto-review-owner--view) (previews . ,(vconcat (reverse owner-smoke-previews)))
                    (text . ,(buffer-string)))))
    (with-temp-file (getenv "SMOKE_EMACS_EVIDENCE") (insert (json-encode evidence)))))
