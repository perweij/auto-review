;;; gitlab-emacs.el --- Live GitLab commands through Emacs -*- lexical-binding: t; -*-
(require 'magit-auto-review)
(require 'dired)
(unless (version<= "29.1" emacs-version) (error "gitlab-emacs requires Emacs 29.1 or newer"))
(setq magit-auto-review-executable (getenv "SMOKE_BACKEND"))
(defvar smoke-evidence nil)
(defvar smoke-prompts nil)
(defvar smoke-confirmations nil)
(defvar smoke-answer nil)
(defvar smoke-prepared nil)
(defvar smoke-calls nil)

(defun smoke-assert (condition message)
  (unless condition (error "%s" message)))
(defun smoke-wait ()
  (let ((deadline (+ (float-time) 600)))
    (while (and magit-auto-review--process (< (float-time) deadline))
      (accept-process-output nil 0.1))
    (smoke-assert (not magit-auto-review--process) "Async review timed out")
    (smoke-assert (not magit-auto-review--progress)
                  (format "Backend operation failed: %s" magit-auto-review--progress))))
(defun smoke-configure ()
  (cl-letf (((symbol-function 'transient-setup) #'ignore))
    (magit-auto-review-run)
    (let ((deadline (+ (float-time) 60)))
      (while (and (not (magit-auto-review--setup-ready-p)) (< (float-time) deadline))
        (accept-process-output nil 0.1)))
    (smoke-assert (magit-auto-review--setup-ready-p) "Metadata discovery timed out")))
(defun smoke-stage (id)
  (magit-auto-review--goto-comment id t)
  (magit-auto-review-stage))
(defun smoke-new (title body placement)
  (magit-auto-review--new-comment-at title placement)
  (insert body)
  (magit-auto-review-save)
  (magit-auto-review-stage))
(defun smoke-record-call (original request &rest callbacks)
  (push (alist-get 'command request) smoke-calls)
  (apply original request callbacks))
(defun smoke-record-start (original request callback)
  (push (alist-get 'command request) smoke-calls)
  (funcall original request
           (lambda (result)
             (when (equal (alist-get 'command request) "prepare")
               (setq smoke-prepared (copy-tree result)))
             (funcall callback result))))

(advice-add 'magit-auto-review--call :around #'smoke-record-call)
(advice-add 'magit-auto-review--start :around #'smoke-record-start)
(let* ((default-directory (file-name-as-directory (getenv "SMOKE_CWD")))
       (magit-auto-review-suggested-changes t)
       (fixture-url (getenv "SMOKE_MR_URL"))
       origin session raw-body)
  ;; No selected topic: exercise the saved-review/manual target entry path.
  (cl-letf (((symbol-function 'completing-read)
             (lambda (prompt &rest _) (push prompt smoke-prompts) fixture-url)))
    (magit-auto-review))
  (setq origin (current-buffer))
  (smoke-assert (magit-auto-review--gitlab-p) "Entry did not select GitLab Reviewer")
  (smoke-assert (not magit-auto-review--session) "Expected a fresh MR")
  (smoke-configure)
  (smoke-assert (not (eq t (alist-get 'suggested_changes magit-auto-review--setup-settings)))
                "GitHub suggestion default leaked into GitLab")
  (cl-letf (((symbol-function 'transient-setup) #'ignore))
    (magit-auto-review-setup-economical))
  (let ((deadline (+ (float-time) 60)))
    (while (and (not (magit-auto-review--setup-ready-p)) (< (float-time) deadline))
      (accept-process-output nil 0.1)))
  (magit-auto-review-setup-submit)
  (smoke-wait)
  (magit-auto-review-refresh)
  (setq session magit-auto-review--session)
  (push (cons 'usage_after_run (alist-get 'usage magit-auto-review--review)) smoke-evidence)
  (smoke-assert (alist-get 'comments magit-auto-review--review) "Review returned no findings")
  ;; Edit and stage using the ordinary inline editor; prose stays untouched.
  (let ((id (alist-get 'id (car (alist-get 'comments magit-auto-review--review)))))
    (magit-auto-review--goto-comment id t)
    (magit-auto-review-edit)
    (delete-region (plist-get magit-auto-review--editor :start) (plist-get magit-auto-review--editor :end))
    (setq raw-body "**Edited finding**\n/close\n\n<!-- pr-review action=literal -->\nKeep this text.")
    (insert raw-body)
    (magit-auto-review-save)
    (smoke-assert (equal raw-body (alist-get 'body (magit-auto-review--comment id))) "Editor changed source wording")
    (smoke-stage id))
  (cl-letf (((symbol-function 'read-char-choice)
             (lambda (prompt choices &rest _)
               (push prompt smoke-prompts)
               (smoke-assert (not (memq ?t choices)) "Unsupported thread placement offered") ?o))
            ((symbol-function 'read-string) (lambda (prompt &rest _) (push prompt smoke-prompts) "Assessment")))
    (magit-auto-review-new-comment))
  (insert "**Overall**\n/close\n```sh\n/close\n```\nLiteral code remains intact.")
  (magit-auto-review-save)
  (magit-auto-review-stage)
  (smoke-new "Removed line" "Removed line evidence." '((kind . "inline") (path . "price.py") (side . "LEFT") (line . 3)))
  (smoke-new "Context line" "Context line evidence." '((kind . "inline") (path . "price.py") (side . "RIGHT") (line . 2)))
  (smoke-new "Range" "Range evidence." '((kind . "inline") (path . "price.py") (side . "RIGHT") (start_line . 1) (line . 3)))
  ;; The real confirmation callback captures the visible, read-only buffer.
  (cl-letf (((symbol-function 'yes-or-no-p)
             (lambda (prompt)
               (let ((text (with-current-buffer "*Auto-review publication preview*"
                             (smoke-assert buffer-read-only "Preview was editable") (buffer-string))))
                 (push `((prompt . ,prompt) (text . ,text) (accepted . ,smoke-answer)
                         (prepared . ,(copy-tree smoke-prepared))) smoke-confirmations))
               smoke-answer)))
    (setq smoke-answer nil)
    (magit-auto-review-publish)
    (smoke-wait)
    (smoke-assert (not (member "publish" smoke-calls)) "Declining sent publication")
    (setq smoke-answer t)
    (magit-auto-review-publish)
    (smoke-wait))
  (smoke-assert (cl-every (lambda (c) (equal (alist-get 'status c) "published"))
                         (alist-get 'comments magit-auto-review--review)) "Publication was incomplete")
  (push (cons 'published_review (copy-tree magit-auto-review--review)) smoke-evidence)
  ;; Reopen from target and resume the same saved review. No review stages run.
  (kill-buffer origin)
  (magit-auto-review--open-pr (file-name-as-directory (getenv "SMOKE_CWD")) fixture-url nil "gitlab")
  (setq origin (current-buffer))
  (smoke-assert (equal session magit-auto-review--session) "Reopen chose a different session")
  (smoke-configure)
  (magit-auto-review-setup-submit)
  (smoke-wait)
  (magit-auto-review-refresh)
  (push (cons 'usage_after_resume (alist-get 'usage magit-auto-review--review)) smoke-evidence)
  (magit-auto-review-open-checkout)
  (smoke-assert (derived-mode-p 'dired-mode) "Checkout did not open Dired")
  (push (cons 'checkout default-directory) smoke-evidence)
  (pop-to-buffer origin)
  (magit-auto-review-execution-report)
  (smoke-assert buffer-file-name "Local report did not open")
  (push (cons 'report_path buffer-file-name) smoke-evidence)
  (pop-to-buffer origin)
  (magit-auto-review-publish-execution-report)
  (push (cons 'final_review (copy-tree magit-auto-review--review)) smoke-evidence)
  (push (cons 'confirmations (nreverse smoke-confirmations)) smoke-evidence)
  (push (cons 'prompts (nreverse smoke-prompts)) smoke-evidence)
  (push (cons 'calls (nreverse smoke-calls)) smoke-evidence)
  (with-temp-file (getenv "SMOKE_EMACS_EVIDENCE")
    (insert (json-encode smoke-evidence))))
