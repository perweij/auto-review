#!/usr/bin/env bash
set -euo pipefail
tool=${0##*/}
args=$(jq -cn --args '$ARGS.positional' -- "$@")
jq -nc --arg tool "$tool" --argjson args "$args" '{tool:$tool,args:$args}' >> "$FIXTURE/calls.jsonl"
if [[ $* == *--version* ]]; then printf '%s test-1.0\n' "$tool"; exit; fi
if [[ $* == *--help* ]]; then
    cat <<'EOF'
--base --output-last-message --json --ephemeral --model --config --strict-config
--print --effort --permission-mode --output-format stream-json --verbose --include-partial-messages
--no-session-persistence --disallowed-tools --add-dir --json-schema --max-budget-usd
--append-system-prompt --hostname --paginate --slurp --method --field --raw-field
--repo --comments status --output-schema
--skip-git-repo-check --tools --disable-slash-commands --strict-mcp-config --system-prompt --setting-sources
EOF
    exit
fi
if [[ $* == 'login status' || $* == 'auth status'* ]]; then
    [[ ${MOCK_AUTH_FAIL:-} != "$tool" ]]; exit
fi
if [[ $tool == gh ]]; then
    if [[ -n ${MOCK_REQUIRE_GH_AUTH:-} ]]; then [[ ${GH_TOKEN:-} == fixture-secret-github ]]; fi
    if [[ $1 == repo ]]; then
        if [[ $* == *viewerPermission* ]]; then echo WRITE
        elif [[ ${MOCK_DISCOVERY_FAIL:-} == 1 ]]; then exit 1
        else printf '{"nameWithOwner":"org/repo","url":"https://%s/org/repo"}\n' "${MOCK_HOST:-github.com}"; fi
    elif [[ $1 == pr ]]; then
        if [[ $* == *--json* ]]; then
            [[ ${MOCK_PR_INACCESSIBLE:-} != 1 ]] || exit 1
            head=$(git --git-dir="$FIXTURE/remote.git" rev-parse refs/pull/7/head)
            base=$(git --git-dir="$FIXTURE/remote.git" rev-parse refs/heads/main)
            base=${MOCK_PR_BASE_SHA:-$base}
            jq -nc --arg head "$head" --arg base "$base" --arg author "${MOCK_AUTHOR:-author}" --arg state "${MOCK_PR_STATE:-OPEN}" --arg host "${MOCK_HOST:-github.com}" \
                '{number:7,title:"A useful change",body:"PR description",url:("https://"+$host+"/org/repo/pull/7"),state:$state,isDraft:false,baseRefName:"main",baseRefOid:$base,headRefName:"feature",headRefOid:$head,isCrossRepository:true,author:{login:$author}}'
        else echo 'Rendered discussion'; fi
    elif [[ $1 == api ]]; then
        endpoint=''; post=false; commit=''; event=''; body=''
        for arg in "$@"; do
            case $arg in
                user|repos/*|graphql) endpoint=$arg ;;
                POST) post=true ;;
                commit_id=*) commit=${arg#commit_id=} ;;
                event=*) event=${arg#event=} ;;
                body=@*) body=${arg#body=@} ;;
            esac
        done
        if { $post || [[ $endpoint == graphql ]]; } && [[ $* == *'--input -'* ]]; then
            exec python3 "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")/mock-gh-json.py" "$endpoint"
        fi
        case $endpoint in
            user) echo "${MOCK_VIEWER:-reviewer}" ;;
            graphql)
                if [[ $* == *latestOpinionatedReviews* ]]; then
                    if [[ -f $FIXTURE/review-status.json ]]; then cat "$FIXTURE/review-status.json"
                    else echo '{"data":{"viewer":{"login":"reviewer"},"repository":{"pullRequest":{"number":7,"reviewDecision":null,"viewerLatestReview":null,"latestOpinionatedReviews":{"nodes":[],"pageInfo":{"hasNextPage":false,"endCursor":null}}}}}}'; fi
                    exit
                fi
                if [[ ${MOCK_GRAPHQL_FAIL:-} == 1 ]]; then echo '{"errors":[{"message":"forbidden"}],"data":{}}'; exit; fi
                count=$(cat "$FIXTURE/refresh-count" 2>/dev/null || echo 0)
                count=$((count+1)); echo "$count" > "$FIXTURE/refresh-count"
                if [[ ${MOCK_CHANGE_AT:-} == "$count" ]]; then
                    if [[ -f $FIXTURE/inline-next.json ]]; then cp "$FIXTURE/inline-next.json" "$FIXTURE/inline.json"; fi
                    if [[ -f $FIXTURE/threads-next.json ]]; then cp "$FIXTURE/threads-next.json" "$FIXTURE/threads.json"; fi
                    if [[ -f $FIXTURE/contribution-model-next.json ]]; then cp "$FIXTURE/contribution-model-next.json" "$FIXTURE/contribution-model.json"; fi
                    touch "$FIXTURE/discussion-changed"
                fi
                if [[ -f $FIXTURE/threads.json ]]; then nodes=$(cat "$FIXTURE/threads.json"); else nodes='[]'; fi
                if [[ -f $FIXTURE/api-threads.json ]]; then nodes=$(jq --slurpfile added "$FIXTURE/api-threads.json" '. + $added[0]' <<< "$nodes"); fi
                if [[ -f $FIXTURE/published-replies.jsonl ]]; then
                    nodes=$(jq --slurpfile replies "$FIXTURE/published-replies.jsonl" 'map(. as $thread | .comments.totalCount += ([$replies[]|select(.in_reply_to_id==$thread.comments.nodes[0].databaseId)]|length))' <<< "$nodes")
                fi
                more=false; cursor=null
                if [[ ${MOCK_THREAD_PAGES:-} == 1 ]]; then
                    if [[ $* == *cursor=next* ]]; then nodes=$(jq '.[1:]' <<< "$nodes")
                    else nodes=$(jq '.[0:1]' <<< "$nodes"); more=true; cursor='"next"'; fi
                fi
                jq -nc --argjson nodes "$nodes" --argjson more "$more" --argjson cursor "$cursor" '{data:{repository:{pullRequest:{number:7,reviewThreads:{nodes:$nodes,pageInfo:{hasNextPage:$more,endCursor:$cursor}}}}}}' ;;
            */issues/7/comments)
                [[ ${MOCK_COMMENTS_FAIL:-} != 1 ]] || exit 1
                if [[ -f $FIXTURE/issues.json ]]; then jq -s '.' "$FIXTURE/issues.json"
                else echo '[[{"id":10,"user":{"login":"reader"},"body":"Discussion evidence","html_url":"https://github.com/org/repo/pull/7#issuecomment-10","created_at":"2026-01-01","updated_at":"2026-01-01"}]]'; fi ;;
            */pulls/7/reviews)
                if $post; then
                    count=$(cat "$FIXTURE/post-count" 2>/dev/null || echo 0)
                    echo "$((count+1))" > "$FIXTURE/post-count"
                    [[ ${MOCK_POST:-} != reject ]] || { echo 'HTTP 403 policy denied' >&2; exit 1; }
                    if [[ ${MOCK_POST:-} == absent && $count == 0 ]]; then exit 1; fi
                    jq -nc --arg head "$commit" --arg event "$event" --arg viewer "${MOCK_VIEWER:-reviewer}" --rawfile body "$body" '{id:99,commit_id:$head,state:$event,body:$body,user:{login:$viewer},html_url:"https://github.com/org/repo/pull/7#pullrequestreview-99",submitted_at:"2026-01-02"}' > "$FIXTURE/published.json"
                    cat "$FIXTURE/published.json"
                    [[ ${MOCK_POST:-} != ambiguous ]] || exit 1
                elif [[ ${MOCK_BAD_LOOKUP:-} == 1 ]]; then echo '[[{"id":99,"user":null,"body":"ambiguous"}]]'
                elif [[ -s $FIXTURE/api-reviews.json ]]; then jq '[.]' "$FIXTURE/api-reviews.json"
                elif [[ -s $FIXTURE/published.json ]]; then
                    if [[ ${MOCK_BAD_LOOKUP:-} == 1 ]]; then echo '[[{"id":99,"user":null,"body":"ambiguous"}]]'
                    else jq -s '[.]' "$FIXTURE/published.json"; fi
                elif [[ -s $FIXTURE/existing-reviews.json ]]; then jq -s '.' "$FIXTURE/existing-reviews.json"
                else echo '[[],[]]'; fi ;;
            */comments/*/replies)
                root=${endpoint%/replies}; root=${root##*/}
                count=$(cat "$FIXTURE/reply-count" 2>/dev/null || echo 0); count=$((count+1)); echo "$count" > "$FIXTURE/reply-count"
                if [[ ${MOCK_REPLY_FAIL_AT:-} == "$count" ]]; then echo 'HTTP 403 reply denied' >&2; exit 1; fi
                jq -nc --argjson root "$root" --argjson id "$((1000+count))" --rawfile body "$body" '{id:$id,in_reply_to_id:$root,user:{login:"reviewer"},body:$body,html_url:("https://github.com/org/repo/pull/7#discussion_r"+($id|tostring)),created_at:"2026-01-03",updated_at:"2026-01-03"}' > "$FIXTURE/reply-response.json"
                cat "$FIXTURE/reply-response.json" >> "$FIXTURE/published-replies.jsonl"
                cat "$FIXTURE/reply-response.json"
                if [[ ${MOCK_INTERRUPT_AFTER_REPLY:-} == 1 ]]; then kill -INT "$PPID"; fi
                if [[ ${MOCK_MOVE_HEAD_AFTER_REPLY:-} == 1 ]]; then
                    parent=$(git --git-dir="$FIXTURE/remote.git" rev-parse refs/pull/7/head)
                    new=$(printf 'new head\n' | git --git-dir="$FIXTURE/remote.git" commit-tree "$parent^{tree}" -p "$parent")
                    git --git-dir="$FIXTURE/remote.git" update-ref refs/pull/7/head "$new"
                fi
                [[ ${MOCK_REPLY_AMBIGUOUS:-} != 1 ]] || exit 1 ;;
            */pulls/7/comments)
                [[ ${MOCK_INLINE_FAIL:-} != 1 ]] || exit 1
                if [[ -f $FIXTURE/inline.json ]]; then cat "$FIXTURE/inline.json"; else echo '[]'; fi > "$FIXTURE/inline-output.json"
                if [[ -f $FIXTURE/api-inline.json ]]; then
                    jq --slurpfile added "$FIXTURE/api-inline.json" '. + $added[0]' "$FIXTURE/inline-output.json" > "$FIXTURE/inline-output.tmp"
                    mv "$FIXTURE/inline-output.tmp" "$FIXTURE/inline-output.json"
                fi
                if [[ -f $FIXTURE/published-replies.jsonl ]]; then jq --slurpfile replies "$FIXTURE/published-replies.jsonl" '[. + $replies]' "$FIXTURE/inline-output.json"
                else jq '[.]' "$FIXTURE/inline-output.json"; fi ;;
            */pulls/7/reviews/*/comments)
                review=${endpoint%/comments}; review=${review##*/}
                jq --argjson review "$review" '[[.[]|select(.pull_request_review_id==$review)]]' "$FIXTURE/api-inline.json" ;;
            */actions/runs*)
                [[ ${MOCK_ACTIONS_FAIL:-} != 1 ]] || { echo 'HTTP 403' >&2; exit 1; }
                if [[ ${MOCK_CI:-} == failing ]]; then echo '[{"workflow_runs":[{"status":"completed","conclusion":"failure"},{"status":"in_progress","conclusion":null}]}]'
                else echo '[{"workflow_runs":[]}]'; fi ;;
            */statuses) echo '[[]]' ;;
            *) echo "Unexpected mock endpoint: $endpoint" >&2; exit 2 ;;
        esac
    else echo "Unexpected gh call: $*" >&2; exit 2; fi
    exit
fi

if [[ $* == *PR_REVIEW_AUTH_OK* ]]; then
    printf '%s\n' "$tool" >> "$FIXTURE/probes"
    compgen -e | sort > "$FIXTURE/environment-$tool-probe"
    [[ -z $(cat) && ! -e .git && ! -e source.txt ]] || exit 9
    if [[ ${MOCK_PROBE_SLEEP:-} == "$tool" ]]; then
        trap 'exit 130' INT
        trap 'exit 143' TERM
        touch "$FIXTURE/model-started"
        sleep 10 &
        wait $!
    fi
    if [[ ${MOCK_PROBE_FAIL:-} == "$tool" ]]; then
        if [[ $tool == claude ]]; then
            jq -nc --arg error "${MOCK_PROBE_ERROR:-Failed to authenticate: OAuth session expired and could not be refreshed}" \
                '{type:"result",subtype:"success",is_error:true,result:$error}'
        else
            jq -nc --arg error "${MOCK_PROBE_ERROR:-401 Unauthorized}" '{type:"turn.failed",error:{message:$error}}'
        fi
        exit "${MOCK_PROBE_EXIT:-1}"
    fi
    reply=${MOCK_PROBE_REPLY:-PR_REVIEW_AUTH_OK}
    if [[ $tool == claude ]]; then
        jq -nc --arg reply "$reply" '{type:"result",subtype:"success",is_error:false,result:$reply}'
    else
        while (($#)); do if [[ $1 == -o ]]; then printf '%s\n' "$reply" > "$2"; break; fi; shift; done
        echo '{"type":"turn.completed"}'
    fi
    exit
fi

if [[ ${MOCK_ADAPT:-} == 1 ]]; then
    cat > "$FIXTURE/adapt-stdin"
    if [[ $tool == codex ]]; then
        echo '{"type":"item.completed","item":{"type":"agent_message","text":"A contextual reply"}}'
        echo '{"type":"turn.completed"}'
    else echo '{"type":"result","subtype":"success","is_error":false,"result":"A contextual reply"}'; fi
    exit
fi

stage=claude
if [[ $* == *followup.schema.json* || $* == *suggested_reply* ]]; then stage=followup
elif [[ $tool == codex && $* == *contributions.schema.json* ]]; then stage=contributions
elif [[ $tool == codex && $* == *synthesis.schema.json* ]]; then stage=synthesis
elif [[ $tool == codex ]]; then stage=codex
elif [[ $* == *validity_conflicts* ]]; then stage=contributions
elif [[ $* == *--json-schema* ]]; then stage=synthesis; fi
printf '%s\n' "$stage" >> "$FIXTURE/stages"
# Record only names; assertions can verify scrubbing without logging secrets.
compgen -e | sort > "$FIXTURE/environment-$stage"
git rev-parse HEAD >> "$FIXTURE/reviewed-heads"
if [[ $stage == claude ]]; then
    for manifest in "$FIXTURE/state/pr-review/${MOCK_HOST:-github.com}/org/repo/"*/manifest.json; do
        [[ -f $manifest ]] || continue
        directory=${manifest%/manifest.json}
        if [[ -L $directory/.pending-review ]]; then directory=$(realpath -e "$directory/.pending-review")
        elif [[ -L $directory/.current-review ]]; then directory=$(realpath -e "$directory/.current-review"); fi
        [[ ! -f $directory/reviews/codex.md ]] || exit 8
    done
fi
if [[ $stage == synthesis || $stage == contributions || $stage == followup ]]; then cat > "$FIXTURE/$stage-stdin"; else
    # Independent invocations must receive EOF, even with interactive parent stdin.
    [[ -z $(cat) ]] || exit 9
fi
if [[ $stage == synthesis || $stage == contributions ]] && [[ $* == *'--output-format stream-json'* ]]; then
    echo '{"type":"system","subtype":"init"}'
    echo '{"type":"assistant","message":{"content":[{"type":"tool_use","name":"Read"}]}}'
    echo '{"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":"fixture-model-text-do-not-replay"}}}'
    if [[ ${MOCK_STREAM_STAGE:-} == "$stage" ]]; then
        sleep 3
        echo '{"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":"fixture-model-text-do-not-replay"}}}'
        sleep 3
    fi
fi
if [[ ${MOCK_SLEEP_STAGE:-} == "$stage" ]]; then
    if [[ ${MOCK_IGNORE_SIGNALS:-} == 1 ]]; then trap '' INT TERM
    else trap 'exit 130' INT; trap 'exit 143' TERM; fi
    touch "$FIXTURE/model-started"
    sleep "${MOCK_SLEEP_SECONDS:-2}" &
    wait $!
fi
if [[ $stage == codex && -n ${MOCK_CODEX_EVENT:-} ]]; then
    case $MOCK_CODEX_EVENT in
        git) jq -nc --arg path "$PWD" '{type:"error",message:($path+" is not a git repository")}' ;;
        failed) echo '{"type":"turn.failed","error":{"message":"fixture-provider-error-do-not-replay"}}' ;;
        retry) echo '{"type":"error","message":"Reconnecting... 1/5: fixture-provider-error-do-not-replay"}' ;;
    esac
    if [[ ${MOCK_CODEX_EVENT_HANG:-} == 1 ]]; then
        trap '' TERM
        sleep 30 &
        wait $!
    fi
fi
if [[ ${MOCK_STDERR_STAGE:-} == "$stage" ]]; then
    sleep 3
    echo 'fixture-stderr-do-not-replay' >&2
    sleep 3
fi
if [[ ${MOCK_MUTATE_STAGE:-} == "$stage" ]]; then echo damage >> source.txt; fi
if [[ ${MOCK_INDEX_STAGE:-} == "$stage" ]]; then echo damage >> source.txt; git add source.txt; fi
if [[ ${MOCK_HEAD_STAGE:-} == "$stage" ]]; then git checkout -q HEAD^; fi
if [[ ${MOCK_REF_STAGE:-} == "$stage" ]]; then git update-ref refs/pr-review/7/base HEAD; fi
if [[ ${MOCK_GENERATE_STAGE:-} == "$stage" ]]; then mkdir -p __pycache__; echo cache > __pycache__/compiled; fi
if [[ ${MOCK_STDOUT_ERROR_STAGE:-} == "$stage" ]]; then
    echo '{"type":"result","subtype":"error_during_execution","is_error":true,"errors":["fixture-provider-error-do-not-replay"]}'
    exit 1
fi
if [[ ${MOCK_STDOUT_OAUTH_STAGE:-} == "$stage" ]]; then
    echo '{"type":"result","subtype":"success","is_error":true,"result":"Failed to authenticate: OAuth session expired and could not be refreshed"}'
    exit 1
fi
if [[ ${MOCK_FAIL_STAGE:-} == "$stage" ]]; then echo 'Requested model unavailable or stage failed' >&2; exit 42; fi
emit_structured() {
    if [[ $tool == codex ]]; then
        local output
        output=$(jq -r '.[index("-o")+1]' <<< "$args")
        jq '.structured_output' > "$output"
        echo '{"type":"turn.completed"}'
    else cat; fi
}
if [[ $stage == codex ]]; then
    if [[ ${MOCK_REWRITE_BASE:-} == 1 ]]; then
        git --git-dir="$FIXTURE/remote.git" update-ref refs/heads/main "$(git rev-parse HEAD)"
    fi
    if [[ ${MOCK_MOVE_HEAD:-} == 1 || ${MOCK_MOVE_BASE:-} == 1 ]]; then
        ref=refs/heads/main
        [[ ${MOCK_MOVE_HEAD:-} != 1 ]] || ref=refs/pull/7/head
        parent=$(git --git-dir="$FIXTURE/remote.git" rev-parse "$ref")
        new=$(printf 'advanced\n' | git --git-dir="$FIXTURE/remote.git" commit-tree "$parent^{tree}" -p "$parent")
        git --git-dir="$FIXTURE/remote.git" update-ref "$ref" "$new"
    fi
    while (($#)); do if [[ $1 == -o ]]; then echo 'Codex finding: inspect source.txt:1' > "$2"; break; fi; shift; done
    echo '{"type":"review.completed"}'
elif [[ $stage == claude ]]; then
    echo '{"type":"assistant","message":"investigating"}'
    if [[ ${MOCK_CLAUDE_ERROR:-} == 1 ]]; then echo '{"type":"result","subtype":"error_max_budget_usd","is_error":true,"result":"Budget exceeded"}'
    else echo '{"type":"result","subtype":"success","is_error":false,"result":"Claude independent finding: source.txt:1","permission_denials":[]}'; fi
elif [[ $stage == followup ]]; then
    if [[ -f $FIXTURE/followup-model.json ]]; then result=$(cat "$FIXTURE/followup-model.json")
    else result='{"assessments":[{"thread_key":"thread:T1","outcome":"ADDRESSED","evidence":"Current implementation persists the retry key.","limitations":"Code tracing only; no tests run.","suggested_reply":""}]}'; fi
    jq -nc --argjson result "$result" '{type:"result",subtype:"success",is_error:false,structured_output:$result}' | emit_structured
elif [[ $stage == synthesis ]]; then
    if [[ ${MOCK_SCHEMA_INVALID:-} == 1 ]]; then echo '{"type":"result","subtype":"success","structured_output":{"recommendation":"MAYBE"}}' | emit_structured
    else
        if [[ -f $FIXTURE/findings.json ]]; then findings=$(cat "$FIXTURE/findings.json")
        else findings=$(jq -nc --argjson blockers "${MOCK_BLOCKERS:-0}" '[range(0;([$blockers,1]|max)) | {id:("F"+(.+1|tostring)),title:"Check arithmetic",validity:"CONFIRMED",evidence:"source.txt:1 arithmetic changes",blocking:(.<$blockers),body_md:"Please check source.txt:1."}]'); fi
        findings=$(jq 'map(.severity //= "Medium")' <<< "$findings")
        if [[ ${MOCK_MATCH_CONFLICT:-} == once ]] && grep -q 'Fresh-discussion reassessment' "$FIXTURE/synthesis-stdin"; then
            findings=$(jq 'map(.validity="REJECTED"|.blocking=false)' <<< "$findings")
        fi
        printf '%s\n' "$findings" > "$FIXTURE/latest-findings.json"
        jq -nc --argjson findings "$findings" '{type:"result",subtype:"success",is_error:false,structured_output:{recommendation:"COMMENT",recommendation_rationale:"Review is advisory",blocking_findings:([$findings[]|select(.blocking)]|length),report_md:"# Review\n\nValidated findings and coverage. No tests were run.",review_body_md:"Please check source.txt:1.",findings:$findings},permission_denials:[]}' | emit_structured
    fi
else
    if [[ -n ${MOCK_REAL_MATCHER:-} ]]; then exec "$MOCK_REAL_MATCHER" "$@" < "$FIXTURE/contributions-stdin"; fi
    if [[ -f $FIXTURE/contribution-model.json ]]; then result=$(cat "$FIXTURE/contribution-model.json")
    else result=$(jq '{contributions:[.[]|select(.validity!="REJECTED")|{finding_ids:[.id],classification:"NEW",discussion_keys:[],target_key:null,explanation:"Not discussed yet",delta:.evidence,body_md:.body_md}],validity_conflicts:[]}' "$FIXTURE/latest-findings.json"); fi
    if [[ -n ${MOCK_MATCH_CONFLICT:-} ]] && [[ ${MOCK_MATCH_CONFLICT} == always || ! -f $FIXTURE/match-conflict-raised ]]; then
        touch "$FIXTURE/match-conflict-raised"
        result=$(jq '.validity_conflicts=[{finding_id:"F1",reason:"A later comment challenges validity",evidence_keys:["comment:10"]}]' <<< "$result")
    fi
    if [[ -f $FIXTURE/discussion-changed && ${MOCK_CHANGE_MATCH_TO_DUPLICATE:-} == 1 ]]; then
        result=$(jq '.contributions |= map(.classification="DUPLICATE"|.discussion_keys=["comment:10"]|.target_key=null|.delta=""|.body_md="")' <<< "$result")
    fi
    jq -nc --argjson result "$result" '{type:"result",subtype:"success",is_error:false,structured_output:$result,permission_denials:[]}' | emit_structured
fi
