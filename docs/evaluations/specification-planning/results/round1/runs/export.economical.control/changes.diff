@@ -1,6 +1,10 @@
+import csv
 import io
+import json
 import os
 import tempfile
+import subprocess
+import sys
 import unittest
 
 from ledger import cli
@@ -30,3 +34,89 @@ class CliTest(unittest.TestCase):
         self.assertEqual(2, code)
         self.assertIn("invalid", err)
         self.assertEqual(2, self.run_cli("add", "2026-01-01", "abc", "food")[0])
+
+
+class ExportTest(CliTest):
+    def run_process(self, *args):
+        return subprocess.run(
+            [sys.executable, "-m", "ledger", "--data", self.data, *args],
+            capture_output=True, text=True, encoding="utf-8",
+        )
+
+    def test_formats_round_trip_and_stable_order(self):
+        self.run_cli("add", "2026-02-01", "-3.00", "café, food", 'line "one"\nline two')
+        self.run_cli("add", "2026-01-01", "2.5", "other", "")
+        self.run_cli("add", "2026-02-01", "1", "same date", "")
+        expected = [
+            {"date": "2026-01-01", "amount": "2.50", "category": "other", "note": ""},
+            {"date": "2026-02-01", "amount": "-3.00", "category": "café, food", "note": 'line "one"\nline two'},
+            {"date": "2026-02-01", "amount": "1.00", "category": "same date", "note": ""},
+        ]
+        for format_ in ("csv", "json"):
+            with self.subTest(format=format_):
+                result = self.run_process("export", "--format", format_)
+                self.assertEqual((result.returncode, result.stderr), (0, ""))
+                if format_ == "csv":
+                    reader = csv.DictReader(io.StringIO(result.stdout, newline=""))
+                    self.assertEqual(reader.fieldnames, ["date", "amount", "category", "note"])
+                    self.assertEqual(list(reader), expected)
+                else:
+                    self.assertEqual(json.loads(result.stdout), {"version": 1, "entries": expected})
+
+    def test_empty_ledgers(self):
+        csv_result = self.run_process("export", "--format", "csv")
+        self.assertEqual(csv_result.returncode, 0)
+        self.assertEqual(list(csv.reader(io.StringIO(csv_result.stdout))), [["date", "amount", "category", "note"]])
+        json_result = self.run_process("export", "--format", "json")
+        self.assertEqual(json_result.returncode, 0)
+        self.assertEqual(json.loads(json_result.stdout), {"version": 1, "entries": []})
+
+    def test_output_and_overwrite(self):
+        path = os.path.join(self.directory.name, "export.json")
+        result = self.run_process("export", "--format", "json", "--output", path)
+        self.assertEqual((result.returncode, result.stdout, result.stderr), (0, "", ""))
+        with open(path, "w", encoding="utf-8") as stream:
+            stream.write("original")
+        result = self.run_process("export", "--format", "json", "--output", path)
+        self.assert_error(result)
+        with open(path, encoding="utf-8") as stream:
+            self.assertEqual(stream.read(), "original")
+        result = self.run_process("export", "--format", "json", "--output", path, "--force")
+        self.assertEqual((result.returncode, result.stdout, result.stderr), (0, "", ""))
+        with open(path, encoding="utf-8") as stream:
+            self.assertEqual(json.load(stream), {"version": 1, "entries": []})
+
+    def assert_error(self, result):
+        self.assertEqual(result.returncode, 2)
+        self.assertEqual(result.stdout, "")
+        self.assertEqual(len(result.stderr.splitlines()), 1)
+        self.assertNotIn("Traceback", result.stderr)
+
+    def test_errors(self):
+        for args in [("export",), ("export", "--format", "xml"),
+                     ("export", "--format", "csv", "--output", os.path.join(self.directory.name, "missing", "out"))]:
+            with self.subTest(args=args):
+                self.assert_error(self.run_process(*args))
+
+    @unittest.skipUnless(os.path.exists("/dev/full"), "requires /dev/full")
+    def test_stdout_flush_failure(self):
+        for format_ in ("csv", "json"):
+            with self.subTest(format=format_), open("/dev/full", "w") as destination:
+                result = subprocess.run(
+                    [sys.executable, "-m", "ledger", "--data", self.data,
+                     "export", "--format", format_],
+                    stdout=destination, stderr=subprocess.PIPE, text=True,
+                )
+                self.assertEqual(result.returncode, 2)
+                self.assertEqual(len(result.stderr.splitlines()), 1)
+                self.assertNotIn("Traceback", result.stderr)
+
+    def test_stdout_write_failure(self):
+        class BrokenOutput(io.StringIO):
+            def write(self, text):
+                raise OSError("write failed")
+
+        err = io.StringIO()
+        code = cli.main(["--data", self.data, "export", "--format", "csv"], BrokenOutput(), err)
+        self.assertEqual(code, 2)
+        self.assertEqual(len(err.getvalue().splitlines()), 1)
