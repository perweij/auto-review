+class ExportCliTest(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.data = os.path.join(self.directory.name, "ledger.json")
+        self.entries = [
+            Entry("2026-02-02", 1250, "café, food", 'A "quoted" note\nsecond line'),
+            Entry("2026-01-01", -300, "返金", ""),
+            Entry("2026-01-01", -5, "other", "same date"),
+            Entry("2026-01-02", 0, "zero", ""),
+        ]
+        self.expected = [
+            {"date": "2026-01-01", "amount": "-3.00", "category": "返金", "note": ""},
+            {"date": "2026-01-01", "amount": "-0.05", "category": "other", "note": "same date"},
+            {"date": "2026-01-02", "amount": "0.00", "category": "zero", "note": ""},
+            {"date": "2026-02-02", "amount": "12.50", "category": "café, food", "note": 'A "quoted" note\nsecond line'},
+        ]
+
+    def run_cli(self, *argv):
+        return subprocess.run(
+            [sys.executable, "-m", "ledger", "--data", self.data, "export", *argv],
+            cwd=Path(__file__).resolve().parents[1],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+        )
+
+    def assert_export(self, format_, text, expected):
+        if format_ == "csv":
+            reader = csv.DictReader(io.StringIO(text, newline=""))
+            self.assertEqual(["date", "amount", "category", "note"], reader.fieldnames)
+            self.assertEqual(expected, list(reader))
+        else:
+            self.assertEqual({"version": 1, "entries": expected}, json.loads(text))
+
+    def assert_error(self, result):
+        self.assertEqual(2, result.returncode)
+        self.assertEqual("", result.stdout)
+        self.assertEqual(1, len(result.stderr.splitlines()))
+        self.assertTrue(result.stderr.startswith("error:"))
+        self.assertNotIn("Traceback", result.stderr)
+
+    def test_stdout_round_trip(self):
+        store.save(self.data, self.entries)
+        for format_ in ("csv", "json"):
+            with self.subTest(format=format_):
+                result = self.run_cli("--format", format_)
+                self.assertEqual(0, result.returncode, result.stderr)
+                self.assertEqual("", result.stderr)
+                self.assert_export(format_, result.stdout, self.expected)
+        self.assertEqual(self.entries, store.load(self.data))
+
+    def test_empty_ledgers(self):
+        for stored in (False, True):
+            if stored:
+                store.save(self.data, [])
+            for format_ in ("csv", "json"):
+                with self.subTest(stored=stored, format=format_):
+                    result = self.run_cli("--format", format_)
+                    self.assertEqual(0, result.returncode, result.stderr)
+                    self.assertEqual("", result.stderr)
+                    self.assert_export(format_, result.stdout, [])
+
+    def test_output_and_overwrite(self):
+        store.save(self.data, self.entries)
+        for format_ in ("csv", "json"):
+            with self.subTest(format=format_):
+                output = Path(self.directory.name) / ("entries." + format_)
+                args = ("--format", format_, "--output", str(output))
+                result = self.run_cli(*args)
+                self.assertEqual((0, "", ""), (result.returncode, result.stdout, result.stderr))
+                with output.open(encoding="utf-8", newline="") as stream:
+                    self.assert_export(format_, stream.read(), self.expected)
+                output.write_bytes(b"existing contents\x00\xff")
+                self.assert_error(self.run_cli(*args))
+                self.assertEqual(b"existing contents\x00\xff", output.read_bytes())
+                result = self.run_cli(*args, "--force")
+                self.assertEqual((0, "", ""), (result.returncode, result.stdout, result.stderr))
+                with output.open(encoding="utf-8", newline="") as stream:
+                    self.assert_export(format_, stream.read(), self.expected)
+
+    def test_invalid_formats(self):
+        for args in ((), ("--format", "xml"), ("--format",), ("--format", "bad\nformat")):
+            with self.subTest(args=args):
+                self.assert_error(self.run_cli(*args))
+
+    def test_unwritable_destinations(self):
+        for output in (self.directory.name, os.path.join(self.directory.name, "missing", "out\n.csv")):
+            for force in ((), ("--force",)):
+                with self.subTest(output=output, force=force):
+                    self.assert_error(self.run_cli("--format", "csv", "--output", output, *force))
+
+    def test_file_write_and_close_failures(self):
+        for failure in ("write", "close"):
+            with self.subTest(failure=failure):
+                destination = mock.MagicMock()
+                if failure == "write":
+                    destination.__enter__.return_value.write.side_effect = OSError("disk full\nwrite failed")
+                else:
+                    destination.__exit__.side_effect = OSError("close failed")
+                out, err = io.StringIO(), io.StringIO()
+                with mock.patch("ledger.cli.open", return_value=destination):
+                    code = cli.main(
+                        ["--data", self.data, "export", "--format", "json", "--output", "out.json"],
+                        out, err,
+                    )
+                self.assertEqual(2, code)
+                self.assertEqual("", out.getvalue())
+                self.assertEqual(1, len(err.getvalue().splitlines()))
+
+    def test_validation_uses_supplied_error_stream(self):
+        for args in ([], ["--format", "xml"]):
+            with self.subTest(args=args):
+                out, err = io.StringIO(), io.StringIO()
+                code = cli.main(["--data", self.data, "export", *args], out, err)
+                self.assertEqual(2, code)
+                self.assertEqual("", out.getvalue())
+                self.assertEqual(1, len(err.getvalue().splitlines()))
