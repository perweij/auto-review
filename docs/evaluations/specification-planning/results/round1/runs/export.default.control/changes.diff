     return parser
 
 
+def write_export(entries, format_, stream):
+    rows = [
+        {
+            "date": entry.date,
+            "amount": report.format_cents(entry.amount_cents),
+            "category": entry.category,
+            "note": entry.note,
+        }
+        for entry in sorted(entries, key=lambda entry: entry.date)
+    ]
+    if format_ == "csv":
+        writer = csv.DictWriter(stream, fieldnames=["date", "amount", "category", "note"])
+        writer.writeheader()
+        writer.writerows(rows)
+    else:
+        json.dump({"version": 1, "entries": rows}, stream, ensure_ascii=False, indent=2)
+        stream.write("\n")
+
+
+def export_error(error, err):
+    # Paths and invalid arguments may themselves contain newlines.
+    print("error: " + " ".join(str(error).splitlines()), file=err)
+    return 2
+
+
 def main(argv=None, out=None, err=None):
     out, err = out or sys.stdout, err or sys.stderr
     try:
         args = build_parser().parse_args(argv)
+    except ExportArgumentError as error:
+        return export_error(error, err)
     except SystemExit as exit_:
         return exit_.code
     entries = store.load(args.data)
+    if args.command == "export":
+        try:
+            if args.output is not None:
+                with open(args.output, "w" if args.force else "x", encoding="utf-8", newline="") as stream:
+                    write_export(entries, args.format, stream)
+            else:
+                write_export(entries, args.format, out)
+        except (OSError, ValueError, UnicodeError) as error:
+            return export_error(error, err)
+        return 0
     if args.command == "add":
         try:
             datetime.date.fromisoformat(args.date)
