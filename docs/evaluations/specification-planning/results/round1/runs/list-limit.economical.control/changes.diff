@@ -30,3 +32,35 @@ class CliTest(unittest.TestCase):
         self.assertEqual(2, code)
         self.assertIn("invalid", err)
         self.assertEqual(2, self.run_cli("add", "2026-01-01", "abc", "food")[0])
+
+    def test_list_limit(self):
+        for date, note in [("2026-01-05", "first"), ("2026-01-03", "old"),
+                           ("2026-01-05", "second"), ("2026-01-04", "middle")]:
+            self.assertEqual(0, self.run_cli("add", date, "1", "food", note)[0])
+        expected = ["2026-01-03       1.00 food old",
+                    "2026-01-04       1.00 food middle",
+                    "2026-01-05       1.00 food first",
+                    "2026-01-05       1.00 food second"]
+        for limit, lines in [(None, expected), (1, expected[-1:]),
+                             (3, expected[-3:]), (4, expected), (8, expected)]:
+            with self.subTest(limit=limit):
+                args = ("list",) if limit is None else ("list", "--limit", str(limit))
+                code, out, err = self.run_cli(*args)
+                self.assertEqual(0, code)
+                self.assertEqual(lines, out.splitlines())
+                self.assertEqual("", err)
+
+    def test_list_limit_empty(self):
+        self.assertEqual((0, "", ""), self.run_cli("list", "--limit", "1"))
+
+    def test_invalid_list_limits(self):
+        for value in [("0",), ("-1",), ("1.5",), ("text",), ()]:
+            with self.subTest(value=value):
+                result = subprocess.run(
+                    [sys.executable, "-m", "ledger", "--data", self.data,
+                     "list", "--limit", *value],
+                    capture_output=True, text=True,
+                )
+                self.assertEqual(2, result.returncode)
+                self.assertEqual("", result.stdout)
+                self.assertIn("error:", result.stderr)
