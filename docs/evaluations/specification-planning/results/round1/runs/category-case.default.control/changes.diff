@@ -13,5 +13,24 @@ class ReportTest(unittest.TestCase):
     def test_totals_by_category(self):
         self.assertEqual({"food": 1750, "rent": 3000}, report.totals_by_category(ENTRIES))
 
+    def test_totals_by_category_normalizes_case_without_changing_entries(self):
+        entries = [
+            Entry("2026-02-01", 3000, "RENT"),
+            Entry("2026-01-05", 1250, "Food"),
+            Entry("2026-01-20", 500, "food"),
+            Entry("2026-02-02", -250, "FOOD"),
+            Entry("2026-01-01", 100, "Books"),
+        ]
+        original_categories = [entry.category for entry in entries]
+
+        totals = report.totals_by_category(entries)
+
+        self.assertEqual([("books", 100), ("food", 1500), ("rent", 3000)], list(totals.items()))
+        self.assertEqual(original_categories, [entry.category for entry in entries])
+        self.assertEqual({"2026-01": 1850, "2026-02": 2750}, report.monthly_totals(entries))
+
+    def test_totals_by_category_empty(self):
+        self.assertEqual({}, report.totals_by_category([]))
+
     def test_monthly_totals(self):
         self.assertEqual({"2026-01": 1750, "2026-02": 3000}, report.monthly_totals(ENTRIES))
