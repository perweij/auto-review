         self.assertEqual(2, self.run_cli("add", "2026-01-01", "abc", "food")[0])
+
+    def test_export_formats_and_order(self):
+        records = [
+            {"date": "2026-02-01", "amount_cents": 0, "category": "café, \"x\"", "note": "line 1\nline 2"},
+            {"date": "2026-01-01", "amount_cents": -300, "category": "food", "note": "refund"},
+            {"date": "2026-01-01", "amount_cents": 1250, "category": "rent"},
+        ]
+        with open(self.data, "w", encoding="utf-8") as stream:
+            json.dump(records, stream)
+        expected = [
+            {"date": "2026-01-01", "amount": "-3.00", "category": "food", "note": "refund"},
+            {"date": "2026-01-01", "amount": "12.50", "category": "rent", "note": ""},
+            {"date": "2026-02-01", "amount": "0.00", "category": "café, \"x\"", "note": "line 1\nline 2"},
+        ]
+        for format_ in ("csv", "json"):
+            with self.subTest(format=format_):
+                code, output, error = self.run_cli("export", "--format", format_)
+                self.assertEqual((code, error), (0, ""))
+                if format_ == "csv":
+                    reader = csv.DictReader(io.StringIO(output, newline=""))
+                    self.assertEqual(reader.fieldnames, ["date", "amount", "category", "note"])
+                    self.assertEqual(list(reader), expected)
+                else:
+                    self.assertEqual(json.loads(output), {"version": 1, "entries": expected})
+
+    def test_empty_export_and_files(self):
+        destination = os.path.join(self.directory.name, "export")
+        for format_ in ("csv", "json"):
+            code, output, error = self.run_cli("export", "--format", format_)
+            self.assertEqual((code, error), (0, ""))
+            self.assertEqual(output if format_ == "csv" else json.loads(output),
+                             "date,amount,category,note\n" if format_ == "csv" else {"version": 1, "entries": []})
+            code, out, err = self.run_cli("export", "--format", format_, "--output", destination, "--force")
+            self.assertEqual((code, out, err), (0, "", ""))
+            with open(destination, encoding="utf-8") as stream:
+                self.assertEqual(stream.read(), output)
+        code, out, err = self.run_cli("export", "--format", "csv", "--output", destination)
+        self.assertEqual((code, out), (2, ""))
+        self.assertEqual(len(err.splitlines()), 1)
+        with open(destination, encoding="utf-8") as stream:
+            self.assertEqual(json.load(stream), {"version": 1, "entries": []})
+
+    def test_errors_and_process_exit_codes(self):
+        cases = [("export",), ("export", "--format", "xml"),
+                 ("export", "--format", "csv", "--output", os.path.join(self.directory.name, "missing", "out"))]
+        for args in cases:
+            with self.subTest(args=args):
+                code, out, err = self.run_cli(*args)
+                self.assertEqual((code, out, len(err.splitlines())), (2, "", 1))
+                process = subprocess.run([sys.executable, "-B", "-m", "ledger", "--data", self.data, *args],
+                                         text=True, capture_output=True)
+                self.assertEqual((process.returncode, process.stdout, len(process.stderr.splitlines())), (2, "", 1))
+                self.assertNotIn("Traceback", process.stderr)
+
+    def test_export_data_precedence(self):
+        other = os.path.join(self.directory.name, "other.json")
+        with open(other, "w", encoding="utf-8") as stream:
+            json.dump([{"date": "2026-01-01", "amount_cents": 100, "category": "env"}], stream)
+        with mock.patch.dict(os.environ, {"LEDGER_DATA": other}):
