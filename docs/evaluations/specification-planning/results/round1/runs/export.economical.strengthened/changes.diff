     return parser
 
 
+def write_export(entries, format_, stream):
+    rows = [
+        {"date": entry.date, "amount": report.format_cents(entry.amount_cents),
+         "category": entry.category, "note": entry.note}
+        for entry in sorted(entries, key=lambda entry: entry.date)
+    ]
+    if format_ == "csv":
+        writer = csv.DictWriter(stream, fieldnames=["date", "amount", "category", "note"],
+                                lineterminator="\n")
+        writer.writeheader()
+        writer.writerows(rows)
+    else:
+        json.dump({"version": 1, "entries": rows}, stream, ensure_ascii=False)
+        stream.write("\n")
+
+
 def main(argv=None, out=None, err=None):
