index b677f4e..81c83d3 100644
--- a/README.md
+++ b/README.md
@@ -5,5 +5,11 @@ A small expense ledger. Entries live in a JSON file (`--data` or `$LEDGER_DATA`)
     python -m ledger add 2026-01-05 12.50 food "lunch"
     python -m ledger list
     python -m ledger report --by month
+    python -m ledger export --format csv
+    python -m ledger export --format json --output entries.json
+
+Export writes entries in date order to standard output unless `--output` is
+specified. Existing output files are protected; add `--force` to replace one.
+The data file is selected by `--data`, then `LEDGER_DATA`, then `ledger.json`.
 
 Tests: `python -m unittest discover -s tests`.
