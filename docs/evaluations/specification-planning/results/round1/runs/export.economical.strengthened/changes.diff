+    except ArgumentError as error:
+        print(f"error: {error}", file=err)
+        return 2
     except SystemExit as exit_:
         return exit_.code
     entries = store.load(args.data)
+    if args.command == "export":
+        try:
+            if args.output is None:
+                write_export(entries, args.format, out)
+            else:
+                with open(args.output, "w" if args.force else "x", encoding="utf-8", newline="") as stream:
+                    write_export(entries, args.format, stream)
+        except (OSError, UnicodeError) as error:
+            print(f"error: cannot write export: {str(error).splitlines()[0]}", file=err)
+            return 2
+        return 0
     if args.command == "add":
