@@ -0,0 +1,214 @@
+import contextlib
+import csv
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+from ledger import cli, store
+from ledger.models import Entry
+
+
+class ExportTest(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.root = Path(self.directory.name)
+        self.data = self.root / "ledger.json"
+        self.entries = [
+            Entry("2026-02-01", 1250, 'café, "food"\n雪', 'first\nsecond, "quoted"\r\nlast'),
+            Entry("2026-01-05", -300, "food", "refund"),
+            Entry("2026-01-05", 0, "other"),
+            Entry("2026-01-06", -5, "food", "small refund"),
+        ]
+        store.save(str(self.data), self.entries)
+        self.expected = [
+            {"date": "2026-01-05", "amount": "-3.00", "category": "food", "note": "refund"},
+            {"date": "2026-01-05", "amount": "0.00", "category": "other", "note": ""},
+            {"date": "2026-01-06", "amount": "-0.05", "category": "food", "note": "small refund"},
+            {"date": "2026-02-01", "amount": "12.50", "category": 'café, "food"\n雪',
+             "note": 'first\nsecond, "quoted"\r\nlast'},
+        ]
+
+    def run_cli(self, *argv):
+        out, err = io.StringIO(), io.StringIO()
+        code = cli.main(["--data", str(self.data), *argv], out, err)
+        return code, out.getvalue(), err.getvalue()
+
+    def parse_export(self, format_name, text):
+        if format_name == "csv":
+            reader = csv.DictReader(io.StringIO(text, newline=""))
+            self.assertEqual(["date", "amount", "category", "note"], reader.fieldnames)
+            return list(reader)
+        document = json.loads(text)
+        self.assertEqual({"version", "entries"}, set(document))
+        self.assertIs(type(document["version"]), int)
+        self.assertEqual(1, document["version"])
+        return document["entries"]
+
+    def assert_error(self, result):
+        code, out, err = result
+        self.assertEqual(2, code)
+        self.assertEqual("", out)
+        self.assertEqual(1, len(err.splitlines()))
+        self.assertTrue(err.strip())
+        self.assertNotIn("Traceback", err)
+
+    def test_stdout_formats_preserve_entries_and_storage(self):
+        original = self.data.read_bytes()
+        for format_name in ("csv", "json"):
+            with self.subTest(format=format_name):
+                code, out, err = self.run_cli("export", "--format", format_name)
+                self.assertEqual(0, code)
+                self.assertEqual("", err)
+                rows = self.parse_export(format_name, out)
+                self.assertEqual(self.expected, rows)
+                for row in rows:
+                    self.assertEqual({"date", "amount", "category", "note"}, set(row))
+                    self.assertTrue(all(isinstance(value, str) for value in row.values()))
+                self.assertEqual(original, self.data.read_bytes())
+
+    def test_amounts_match_list_without_padding(self):
+        entries = [Entry("2026-01-05", cents, "food") for cents in (1250, 0, -300, -5)]
+        store.save(str(self.data), entries)
+        listed = [line.split()[1] for line in self.run_cli("list")[1].splitlines()]
+        self.assertEqual(["12.50", "0.00", "-3.00", "-0.05"], listed)
+        for format_name in ("csv", "json"):
+            with self.subTest(format=format_name):
+                code, out, err = self.run_cli("export", "--format", format_name)
+                self.assertEqual((0, ""), (code, err))
+                rows = self.parse_export(format_name, out)
+                self.assertEqual(listed, [row["amount"] for row in rows])
+
+    def test_empty_and_missing_ledgers(self):
+        for missing in (False, True):
+            if missing:
+                self.data.unlink()
+            else:
+                store.save(str(self.data), [])
+            for format_name in ("csv", "json"):
+                with self.subTest(missing=missing, format=format_name):
+                    code, out, err = self.run_cli("export", "--format", format_name)
+                    self.assertEqual((0, ""), (code, err))
+                    self.assertEqual([], self.parse_export(format_name, out))
+                    if format_name == "csv":
+                        self.assertEqual(["date,amount,category,note"], out.splitlines())
+            self.assertEqual(not missing, self.data.exists())
+
+    def test_legacy_entry_without_note(self):
+        self.data.write_text('[{"date":"2026-01-05","amount_cents":1250,"category":"food"}]', encoding="utf-8")
+        expected = [{"date": "2026-01-05", "amount": "12.50", "category": "food", "note": ""}]
+        for format_name in ("csv", "json"):
+            with self.subTest(format=format_name):
+                code, out, err = self.run_cli("export", "--format", format_name)
+                self.assertEqual((0, ""), (code, err))
+                self.assertEqual(expected, self.parse_export(format_name, out))
+
+    def test_file_exports_and_overwrite_protection(self):
+        for format_name in ("csv", "json"):
+            with self.subTest(format=format_name):
+                destination = self.root / ("entries." + format_name)
+                args = ("export", "--format", format_name, "--output", str(destination))
+                self.assertEqual((0, "", ""), self.run_cli(*args))
+                stdout = self.run_cli("export", "--format", format_name)[1]
+                self.assertEqual(stdout.encode("utf-8"), destination.read_bytes())
+                self.assertEqual(self.expected, self.parse_export(format_name, destination.read_bytes().decode("utf-8")))
+                destination.write_bytes(b"keep these original contents\x00")
+                self.assert_error(self.run_cli(*args))
+                self.assertEqual(b"keep these original contents\x00", destination.read_bytes())
+                self.assertEqual((0, "", ""), self.run_cli(*args, "--force"))
+                self.assertEqual(stdout.encode("utf-8"), destination.read_bytes())
+
+    def test_format_errors_use_supplied_stream(self):
+        for args in ((), ("--format", "xml"), ("--format",), ("--format", "bad\nformat")):
+            with self.subTest(args=args):
+                process_err = io.StringIO()
+                with contextlib.redirect_stderr(process_err):
+                    self.assert_error(self.run_cli("export", *args))
+                self.assertEqual("", process_err.getvalue())
+
+    def test_invalid_format_does_not_touch_destination(self):
+        destination = self.root / "keep.txt"
+        destination.write_text("keep", encoding="utf-8")
+        self.assert_error(self.run_cli("export", "--format", "xml", "--output", str(destination), "--force"))
+        self.assertEqual("keep", destination.read_text(encoding="utf-8"))
+
+    def test_unwritable_paths(self):
+        for destination in (self.root, self.root / "missing" / "out.csv", self.data / "out.csv"):
+            for force in ((), ("--force",)):
+                with self.subTest(destination=destination, force=force):
+                    self.assert_error(self.run_cli("export", "--format", "csv", "--output", str(destination), *force))
+        self.assert_error(self.run_cli("export", "--format", "json", "--output", "bad\0path"))
+
+    def test_permission_denied(self):
+        # Mock permissions so this test also works when run as root.
+        real_open = open
+        destination = self.root / "denied.json"
+
+        def open_with_denied_output(path, *args, **kwargs):
+            if path == str(destination):
+                raise PermissionError("permission denied")
+            return real_open(path, *args, **kwargs)
+
+        with mock.patch("builtins.open", side_effect=open_with_denied_output):
+            self.assert_error(self.run_cli("export", "--format", "json", "--output", str(destination)))
+        self.assertFalse(destination.exists())
+
+    def test_export_help_uses_supplied_stream(self):
+        code, out, err = self.run_cli("export", "--help")
+        self.assertEqual((0, ""), (code, err))
+        for option in ("--format", "--output", "--force"):
+            self.assertIn(option, out)
+
+    def test_data_source_precedence(self):
+        environment_data = self.root / "environment.json"
+        store.save(str(environment_data), [Entry("2026-03-01", 200, "environment")])
+        with mock.patch.dict(os.environ, {"LEDGER_DATA": str(environment_data)}):
+            self.assertEqual(self.expected, json.loads(self.run_cli("export", "--format", "json")[1])["entries"])
+            out, err = io.StringIO(), io.StringIO()
+            self.assertEqual(0, cli.main(["export", "--format", "json"], out, err))
+            self.assertEqual("environment", json.loads(out.getvalue())["entries"][0]["category"])
+            self.assertEqual("", err.getvalue())
+        with mock.patch.dict(os.environ):
+            os.environ.pop("LEDGER_DATA", None)
+            previous = os.getcwd()
+            try:
+                os.chdir(self.root)
+                out, err = io.StringIO(), io.StringIO()
+                self.assertEqual(0, cli.main(["export", "--format", "json"], out, err))
+                self.assertEqual(self.expected, json.loads(out.getvalue())["entries"])
+                self.assertEqual("", err.getvalue())
+            finally:
+                os.chdir(previous)
+
+    def test_process_exit_codes_and_streams(self):
+        destination = self.root / "existing.json"
+        destination.write_text("keep", encoding="utf-8")
+        cases = [
+            (),
+            ("--format", "xml"),
+            ("--format",),
+            ("--format", "json", "--output", str(self.root / "missing" / "out.json")),
+            ("--format", "csv", "--output", str(self.root)),
+            ("--format", "json", "--output", str(destination)),
+        ]
+        for args in cases:
+            with self.subTest(args=args):
+                result = subprocess.run(
+                    [sys.executable, "-B", "-m", "ledger", "--data", str(self.data), "export", *args],
+                    capture_output=True, text=True, check=False,
+                )
+                self.assert_error((result.returncode, result.stdout, result.stderr))
+        self.assertEqual("keep", destination.read_text(encoding="utf-8"))
+        result = subprocess.run(
+            [sys.executable, "-B", "-m", "ledger", "--data", str(self.data), "export",
+             "--format", "json", "--output", str(destination), "--force"],
+            capture_output=True, text=True, check=False,
+        )
+        self.assertEqual((0, "", ""), (result.returncode, result.stdout, result.stderr))
+        self.assertEqual(self.expected, json.loads(destination.read_text(encoding="utf-8"))["entries"])
