+"""Portable entry exports; storage continues to use integer cents."""
+import csv
+import json
+
+from .report import format_cents
+
+
+FIELDS = ("date", "amount", "category", "note")
+
+
+def write(entries, format_name, stream):
+    rows = [
+        {
+            "date": entry.date,
+            "amount": format_cents(entry.amount_cents),
+            "category": entry.category,
+            "note": entry.note,
+        }
+        for entry in sorted(entries, key=lambda entry: entry.date)
+    ]
+    if format_name == "csv":
+        writer = csv.DictWriter(stream, fieldnames=FIELDS)
+        writer.writeheader()
+        writer.writerows(rows)
+    else:
+        json.dump({"version": 1, "entries": rows}, stream, ensure_ascii=False)
+        stream.write("\n")
