+
+    def test_list_limits_preserve_date_order_and_formatting(self):
+        for date, amount, category, note in [
+            ("2026-01-05", "12.50", "food", "lunch"),
+            ("2026-01-03", "30", "rent", ""),
+            ("2026-01-05", "2", "food", "snack"),
+            ("2026-01-01", "-5", "refund", ""),
+        ]:
+            self.assertEqual(0, self.run_cli("add", date, amount, category, note)[0])
+        lines = [
+            "2026-01-01      -5.00 refund\n",
+            "2026-01-03      30.00 rent\n",
+            "2026-01-05      12.50 food lunch\n",
+            "2026-01-05       2.00 food snack\n",
+        ]
+        self.assertEqual((0, "".join(lines), ""), self.run_cli("list"))
+        for limit in (1, 2, 3, 4, 5):
+            with self.subTest(limit=limit):
+                self.assertEqual(
+                    (0, "".join(lines[-limit:]), ""),
+                    self.run_cli("list", "--limit", str(limit)),
+                )
+
+    def test_list_empty_ledger(self):
+        for args in ((), ("--limit", "1"), ("--limit", "5")):
+            with self.subTest(args=args):
+                self.assertEqual((0, "", ""), self.run_cli("list", *args))
+
+    def test_list_invalid_limits(self):
+        for args in (("0",), ("-1",), ("1.5",), ("text",), ()):
+            with self.subTest(args=args):
+                code, out, err = self.run_cli("list", "--limit", *args)
+                self.assertEqual(2, code)
+                self.assertEqual("", out)
+                self.assertIn("usage:", err)
+                self.assertIn("--limit", err)
+                result = subprocess.run(
+                    [sys.executable, "-m", "ledger", "--data", self.data,
+                     "list", "--limit", *args],
+                    capture_output=True, text=True,
+                )
+                self.assertEqual(2, result.returncode)
+                self.assertEqual("", result.stdout)
+                self.assertIn("usage:", result.stderr)
+                self.assertIn("--limit", result.stderr)
