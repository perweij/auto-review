 import io
+import json
 import os
 import tempfile
 import unittest
@@ -30,3 +31,53 @@ class CliTest(unittest.TestCase):
         self.assertEqual(2, code)
         self.assertIn("invalid", err)
         self.assertEqual(2, self.run_cli("add", "2026-01-01", "abc", "food")[0])
+
+    def test_mixed_case_add_report_and_list_preserve_categories(self):
+        for date, amount, category in [
+            ("2026-01-05", "12.50", "Food"),
+            ("2026-01-03", "5.00", "food"),
+            ("2026-02-01", "-2.50", "FOOD"),
+        ]:
+            self.assertEqual((0, "", ""), self.run_cli("add", date, amount, category))
+
+        with open(self.data, "rb") as stream:
+            original = stream.read()
+        self.assertEqual(["Food", "food", "FOOD"], [item["category"] for item in json.loads(original)])
+        for arguments in [("report",), ("report", "--by", "category")]:
+            with self.subTest(arguments=arguments):
+                self.assertEqual((0, "food: 15.00\n", ""), self.run_cli(*arguments))
+                with open(self.data, "rb") as stream:
+                    self.assertEqual(original, stream.read())
+        self.assertEqual(
+            (0, "2026-01-03       5.00 food\n2026-01-05      12.50 Food\n2026-02-01      -2.50 FOOD\n", ""),
+            self.run_cli("list"),
+        )
+        self.assertEqual((0, "2026-01: 17.50\n2026-02: -2.50\n", ""), self.run_cli("report", "--by", "month"))
+
+    def test_preexisting_mixed_case_json_needs_no_migration(self):
+        original = b'''[
+  {"date":"2026-02-01","amount_cents":3000,"category":"Rent"},
+  {"date":"2026-01-05","amount_cents":1250,"category":"Food","note":"lunch"},
+  {"date":"2026-01-20","amount_cents":500,"category":"food"},
+  {"date":"2026-01-21","amount_cents":-250,"category":"FOOD"},
+  {"date":"2026-01-22","amount_cents":-5,"category":"Books"}
+]'''
+        with open(self.data, "wb") as stream:
+            stream.write(original)
+
+        for arguments in [("report",), ("report", "--by", "category")]:
+            with self.subTest(arguments=arguments):
+                self.assertEqual((0, "books: -0.05\nfood: 15.00\nrent: 30.00\n", ""), self.run_cli(*arguments))
+        self.assertEqual(
+            (0, "2026-01-05      12.50 Food lunch\n2026-01-20       5.00 food\n2026-01-21      -2.50 FOOD\n2026-01-22      -0.05 Books\n2026-02-01      30.00 Rent\n", ""),
+            self.run_cli("list"),
+        )
+        self.assertEqual((0, "2026-01: 14.95\n2026-02: 30.00\n", ""), self.run_cli("report", "--by", "month"))
+        with open(self.data, "rb") as stream:
+            self.assertEqual(original, stream.read())
+
+    def test_empty_reports(self):
+        for arguments in [("report",), ("report", "--by", "category"), ("report", "--by", "month")]:
+            with self.subTest(arguments=arguments):
+                self.assertEqual((0, "", ""), self.run_cli(*arguments))
+        self.assertFalse(os.path.exists(self.data))
