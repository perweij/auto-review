diff --git a/tests/test_export.py b/tests/test_export.py
new file mode 100644
index 0000000..57a4ddb
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,102 @@
+import csv
+import io
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+from ledger import cli
+
+
+class ExportTest(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.data = os.path.join(self.directory.name, 'ledger.json')
+        self.destination = os.path.join(self.directory.name, 'export')
+
+    def run_cli(self, *args):
+        out, err = io.StringIO(), io.StringIO()
+        status = cli.main(['--data', self.data, 'export', *args], out, err)
+        return status, out.getvalue(), err.getvalue()
+
+    def test_serialization_order_and_legacy_note(self):
+        entries = [
+            {'date': '2026-02-01', 'amount_cents': -300, 'category': 'café, "x"', 'note': 'line 1\nline 2'},
+            {'date': '2026-01-01', 'amount_cents': 1250, 'category': 'food'},
+            {'date': '2026-01-01', 'amount_cents': 0, 'category': 'other', 'note': ''},
+        ]
+        with open(self.data, 'w', encoding='utf-8') as stream:
+            json.dump(entries, stream)
+        expected = [
+            {'date': '2026-01-01', 'amount': '12.50', 'category': 'food', 'note': ''},
+            {'date': '2026-01-01', 'amount': '0.00', 'category': 'other', 'note': ''},
+            {'date': '2026-02-01', 'amount': '-3.00', 'category': 'café, "x"', 'note': 'line 1\nline 2'},
+        ]
+        for fmt in ('csv', 'json'):
+            with self.subTest(fmt=fmt):
+                status, output, error = self.run_cli('--format', fmt)
+                self.assertEqual((status, error), (0, ''))
+                if fmt == 'csv':
+                    reader = csv.DictReader(io.StringIO(output))
+                    self.assertEqual(reader.fieldnames, ['date', 'amount', 'category', 'note'])
+                    self.assertEqual(list(reader), expected)
+                else:
+                    self.assertEqual(json.loads(output), {'version': 1, 'entries': expected})
+
+    def test_empty_and_file_destinations(self):
+        for fmt in ('csv', 'json'):
+            with self.subTest(fmt=fmt):
+                status, output, error = self.run_cli('--format', fmt)
+                self.assertEqual((status, error), (0, ''))
+                self.assertEqual(output if fmt == 'csv' else json.loads(output),
+                                 'date,amount,category,note\n' if fmt == 'csv' else {'version': 1, 'entries': []})
+                self.assertEqual(self.run_cli('--format', fmt, '--output', self.destination, '--force'), (0, '', ''))
+                with open(self.destination, encoding='utf-8') as stream:
+                    self.assertEqual(stream.read(), output)
+                self.assert_failure(self.run_cli('--format', fmt, '--output', self.destination))
+                with open(self.destination, encoding='utf-8') as stream:
+                    self.assertEqual(stream.read(), output)
+
+    def assert_failure(self, result):
+        status, out, err = result
+        self.assertEqual(status, 2)
+        self.assertEqual(out, '')
+        self.assertEqual(len(err.splitlines()), 1)
+        self.assertNotIn('Traceback', err)
+
+    def test_errors_and_module_entry_point(self):
+        cases = [('--output', self.destination), ('--format', 'xml', '--output', self.destination),
+                 ('--format', 'csv', '--output', os.path.join(self.directory.name, 'missing', 'out'))]
+        for args in cases:
+            with self.subTest(args=args):
+                self.assert_failure(self.run_cli(*args))
+                proc = subprocess.run([sys.executable, '-m', 'ledger', '--data', self.data, 'export', *args],
+                                      text=True, capture_output=True)
+                self.assert_failure((proc.returncode, proc.stdout, proc.stderr))
+                self.assertFalse(os.path.exists(self.destination))
+        with open(self.destination, 'w', encoding='utf-8') as stream:
+            stream.write('original')
+        for args in [('--output', self.destination), ('--format', 'xml', '--output', self.destination),
+                     ('--format', 'csv', '--output', self.destination)]:
+            self.assert_failure(self.run_cli(*args))
+            with open(self.destination, encoding='utf-8') as stream:
+                self.assertEqual(stream.read(), 'original')
+
+    def test_data_selection(self):
+        with open(self.data, 'w', encoding='utf-8') as stream:
+            json.dump([{'date': '2026-01-01', 'amount_cents': 100, 'category': 'food'}], stream)
+        with patch.dict(os.environ, {'LEDGER_DATA': self.data}):
+            out, err = io.StringIO(), io.StringIO()
+            self.assertEqual(cli.main(['export', '--format', 'json'], out, err), 0)
+            self.assertEqual(json.loads(out.getvalue())['entries'][0]['amount'], '1.00')
+            out = io.StringIO()
+            self.assertEqual(cli.main(['--data', self.data + '.missing', 'export', '--format', 'json'], out, err), 0)
+            self.assertEqual(json.loads(out.getvalue())['entries'], [])
+
+
+if __name__ == '__main__':
+    unittest.main()
