index 0000000..0395c7f
--- /dev/null
+++ b/tests/test_export.py
@@ -0,0 +1,172 @@
+import contextlib
+import csv
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest import mock
+
+from ledger import cli, store
+from ledger.models import Entry
+
+
+class ExportTest(unittest.TestCase):
+    def setUp(self):
+        self.directory = tempfile.TemporaryDirectory()
+        self.addCleanup(self.directory.cleanup)
+        self.root = Path(self.directory.name)
+        self.data = self.root / "ledger.json"
+        # Include a legacy entry without a note and text requiring CSV escaping.
+        self.stored = [
+            {"date": "2026-02-01", "amount_cents": 1250, "category": 'food,"café"\n外', "note": 'a,b "quoted"\n雪'},
+            {"date": "2026-01-01", "amount_cents": -300, "category": "refund"},
+            {"date": "2026-01-01", "amount_cents": 0, "category": "zero", "note": ""},
+            {"date": "2026-01-02", "amount_cents": -5, "category": "refund", "note": "small"},
+        ]
+        self.data.write_text(json.dumps(self.stored), encoding="utf-8")
+        self.expected = [
+            {"date": "2026-01-01", "amount": "-3.00", "category": "refund", "note": ""},
+            {"date": "2026-01-01", "amount": "0.00", "category": "zero", "note": ""},
+            {"date": "2026-01-02", "amount": "-0.05", "category": "refund", "note": "small"},
+            {"date": "2026-02-01", "amount": "12.50", "category": 'food,"café"\n外', "note": 'a,b "quoted"\n雪'},
+        ]
+
+    def run_cli(self, *arguments):
+        out, err = io.StringIO(), io.StringIO()
+        # Parser errors must use the supplied streams rather than global ones.
+        global_out, global_err = io.StringIO(), io.StringIO()
+        with contextlib.redirect_stdout(global_out), contextlib.redirect_stderr(global_err):
+            code = cli.main(["--data", str(self.data), "export", *arguments], out, err)
+        self.assertEqual("", global_out.getvalue())
+        self.assertEqual("", global_err.getvalue())
+        return code, out.getvalue(), err.getvalue()
+
+    def run_module(self, *arguments):
+        result = subprocess.run(
+            [sys.executable, "-m", "ledger", "--data", str(self.data), "export", *arguments],
+            cwd=Path(__file__).resolve().parents[1],
+            capture_output=True,
+            text=True,
+            encoding="utf-8",
+        )
+        return result.returncode, result.stdout, result.stderr
+
+    def assert_export(self, format, text, expected):
+        if format == "csv":
+            reader = csv.DictReader(io.StringIO(text, newline=""))
+            self.assertEqual(["date", "amount", "category", "note"], reader.fieldnames)
+            self.assertEqual(expected, list(reader))
+        else:
+            document = json.loads(text)
+            self.assertEqual({"version", "entries"}, set(document))
+            self.assertIs(type(document["version"]), int)
+            self.assertEqual(1, document["version"])
+            self.assertEqual(expected, document["entries"])
+
+    def assert_failure(self, result):
+        code, out, err = result
+        self.assertEqual(2, code)
+        self.assertEqual("", out)
+        self.assertEqual(1, len(err.splitlines()))
+        self.assertTrue(err.strip())
+        self.assertNotIn("Traceback", err)
+
+    def test_stdout_serialization_order_amounts_and_legacy_note(self):
+        original = self.data.read_bytes()
+        for run in (self.run_cli, self.run_module):
+            for format in ("csv", "json"):
+                with self.subTest(run=run.__name__, format=format):
+                    code, out, err = run("--format", format)
+                    self.assertEqual((0, ""), (code, err))
+                    self.assert_export(format, out, self.expected)
+        self.assertEqual(original, self.data.read_bytes())
+
+    def test_empty_and_missing_ledgers(self):
+        for missing in (False, True):
+            if missing:
+                self.data.unlink()
+            else:
+                self.data.write_text("[]", encoding="utf-8")
+            for run in (self.run_cli, self.run_module):
+                for format in ("csv", "json"):
+                    with self.subTest(missing=missing, run=run.__name__, format=format):
+                        code, out, err = run("--format", format)
+                        self.assertEqual((0, ""), (code, err))
+                        self.assert_export(format, out, [])
+            self.assertEqual(not missing, self.data.exists())
+
+    def test_output_files_and_force(self):
+        for run in (self.run_cli, self.run_module):
+            for format in ("csv", "json"):
+                with self.subTest(run=run.__name__, format=format):
+                    target = self.root / f"{run.__name__}.{format}"
+                    arguments = ("--format", format, "--output", str(target))
+                    self.assertEqual((0, "", ""), run(*arguments))
+                    original = target.read_bytes()
+                    self.assert_export(format, original.decode("utf-8"), self.expected)
+                    self.assertEqual(self.run_cli("--format", format)[1].encode("utf-8"), original)
+                    self.assert_failure(run(*arguments))
+                    self.assertEqual(original, target.read_bytes())
+                    target.write_text("old content", encoding="utf-8")
+                    self.assertEqual((0, "", ""), run(*arguments, "--force"))
+                    self.assertEqual(original, target.read_bytes())
+
+    def test_invalid_format_never_creates_or_replaces_files(self):
+        for run in (self.run_cli, self.run_module):
+            for options in ((), ("--format", "xml"), ("--format",)):
+                with self.subTest(run=run.__name__, options=options):
+                    self.assert_failure(run(*options))
+                    for exists in (False, True):
+                        for force in ((), ("--force",)):
+                            target = self.root / "invalid-output"
+                            if exists:
+                                target.write_bytes(b"preserve me")
+                            elif target.exists():
+                                target.unlink()
+                            self.assert_failure(run("--output", str(target), *force, *options))
+                            if exists:
+                                self.assertEqual(b"preserve me", target.read_bytes())
+                            else:
+                                self.assertFalse(target.exists())
+
+    def test_unwritable_destinations(self):
+        for run in (self.run_cli, self.run_module):
+            for format in ("csv", "json"):
+                for target in (self.root, self.root / "missing" / "output"):
+                    for force in ((), ("--force",)):
+                        with self.subTest(run=run.__name__, format=format, target=target, force=force):
+                            self.assert_failure(run("--format", format, "--output", str(target), *force))
+
+    def test_permission_and_write_errors_use_injected_error_stream(self):
+        # Simulate permission denial even when the tests run as a privileged user.
+        with mock.patch("ledger.cli.open", create=True, side_effect=PermissionError("permission denied")):
+            self.assert_failure(self.run_cli("--format", "json", "--output", str(self.root / "denied")))
+        with mock.patch("ledger.export.write", side_effect=OSError("disk full\nextra detail")):
+            self.assert_failure(self.run_cli("--format", "csv", "--output", str(self.root / "full")))
+
+    def test_data_selection_and_existing_commands(self):
+        other_data = self.root / "other.json"
+        store.save(str(other_data), [Entry("2026-03-01", 200, "other")])
+        with mock.patch.dict(os.environ, {"LEDGER_DATA": str(other_data)}):
+            out, err = io.StringIO(), io.StringIO()
+            self.assertEqual(0, cli.main(["export", "--format", "json"], out, err))
+            self.assertEqual("", err.getvalue())
+            self.assert_export("json", out.getvalue(), [
+                {"date": "2026-03-01", "amount": "2.00", "category": "other", "note": ""},
+            ])
+            self.assert_export("json", self.run_cli("--format", "json")[1], self.expected)
+
+        self.assertEqual(0, cli.main(["--data", str(other_data), "add", "2026-02-01", "-3", "refund"]))
+        for arguments, expected in (
+            (("list",), "2026-02-01      -3.00 refund\n2026-03-01       2.00 other\n"),
+            (("report",), "other: 2.00\nrefund: -3.00\n"),
+            (("report", "--by", "month"), "2026-02: -3.00\n2026-03: 2.00\n"),
+        ):
+            out, err = io.StringIO(), io.StringIO()
+            self.assertEqual(0, cli.main(["--data", str(other_data), *arguments], out, err))
+            self.assertEqual(expected, out.getvalue())
+            self.assertEqual("", err.getvalue())
