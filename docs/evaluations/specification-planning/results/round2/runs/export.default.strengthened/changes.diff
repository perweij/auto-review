new file mode 100644
index 0000000..cf1ba37
--- /dev/null
+++ b/ledger/export.py
@@ -0,0 +1,27 @@
+"""CSV and versioned JSON exports of ledger entries."""
+import csv
+import json
+
+from .report import format_cents
+
+
+FIELDS = ("date", "amount", "category", "note")
+
+
+def write(entries, format, stream):
+    records = [
+        {
+            "date": entry.date,
+            "amount": format_cents(entry.amount_cents),
+            "category": entry.category,
+            "note": entry.note,
+        }
+        for entry in sorted(entries, key=lambda entry: entry.date)
+    ]
+    if format == "csv":
+        writer = csv.DictWriter(stream, fieldnames=FIELDS)
+        writer.writeheader()
+        writer.writerows(records)
+    else:
+        json.dump({"version": 1, "entries": records}, stream, ensure_ascii=False)
+        stream.write("\n")
diff --git a/tests/test_export.py b/tests/test_export.py
