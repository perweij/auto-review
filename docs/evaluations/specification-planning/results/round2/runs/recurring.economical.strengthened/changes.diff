diff --git a/ledger/models.py b/ledger/models.py
index e382fba..b7310bf 100644
--- a/ledger/models.py
+++ b/ledger/models.py
@@ -1,4 +1,6 @@
-"""Ledger entries."""
+"""Ledger entries and bounded monthly series."""
+import calendar
+import datetime
 from dataclasses import dataclass, asdict
 
 
@@ -15,3 +17,43 @@ class Entry:
     @classmethod
     def from_dict(cls, value):
         return cls(value["date"], int(value["amount_cents"]), value["category"], value.get("note", ""))
+
+
+@dataclass(frozen=True)
+class MonthlySeries:
+    date: str
+    amount_cents: int
+    category: str
+    note: str
+    until: str
+
+    def to_dict(self):
+        return {**asdict(self), "repeat": "monthly"}
+
+    @classmethod
+    def from_dict(cls, value):
+        entry = Entry.from_dict(value)
+        return cls(entry.date, entry.amount_cents, entry.category, entry.note, value["until"])
+
+    def occurrences(self):
+        start = datetime.date.fromisoformat(self.date)
+        end = datetime.date.fromisoformat(self.until)
+        year, month = start.year, start.month
+        while (year, month) <= (end.year, end.month):
+            day = min(start.day, calendar.monthrange(year, month)[1])
+            occurrence = datetime.date(year, month, day)
+            if occurrence <= end:
+                yield Entry(occurrence.isoformat(), self.amount_cents, self.category, self.note)
+            if month == 12:
+                year, month = year + 1, 1
+            else:
+                month += 1
+
+
+def expand(entries):
+    """Yield ordinary entries and each occurrence of a series."""
+    for entry in entries:
+        if isinstance(entry, MonthlySeries):
+            yield from entry.occurrences()
+        else:
+            yield entry
