+
+    def test_mixed_series_listing_and_reports(self):
+        self.assertEqual(0, self.run_cli("add", "2028-01-31", "10", "rent", "home", "--repeat", "monthly", "--until", "2028-03-31")[0])
+        self.assertEqual(0, self.run_cli("add", "2028-02-15", "-2.50", "rent", "refund", "--repeat", "monthly", "--until", "2028-03-15")[0])
+        self.assertEqual(0, self.run_cli("add", "2028-02-01", "3", "food")[0])
+        self.assertEqual([
+            "2028-01-31      10.00 rent home", "2028-02-01       3.00 food",
+            "2028-02-15      -2.50 rent refund", "2028-02-29      10.00 rent home",
+            "2028-03-15      -2.50 rent refund", "2028-03-31      10.00 rent home",
+        ], self.run_cli("list")[1].splitlines())
+        self.assertEqual("food: 3.00\nrent: 25.00\n", self.run_cli("report")[1])
+        self.assertEqual("2028-01: 10.00\n2028-02: 10.50\n2028-03: 7.50\n", self.run_cli("report", "--by", "month")[1])
+
+    def test_cutoff_year_boundary_and_single_occurrence(self):
+        for start, end in [("2026-01-31", "2026-03-30"), ("2026-12-31", "2027-01-31"), ("2030-04-12", "2030-04-12")]:
+            self.assertEqual(0, self.run_cli("add", start, "1", "x", "--repeat", "monthly", "--until", end)[0])
+        self.assertEqual(["2026-01-31", "2026-02-28", "2026-12-31", "2027-01-31", "2030-04-12"],
+                         [line[:10] for line in self.run_cli("list")[1].splitlines()])
+
+    def test_rejected_recurrence_does_not_touch_file(self):
+        import subprocess
+        import sys
+        cases = [("--repeat", "weekly", "--until", "2026-03-01"),
+                 ("--repeat", "monthly"), ("--repeat", "monthly", "--until", "bad"),
+                 ("--repeat", "monthly", "--until", "2026-02-30"),
+                 ("--repeat", "monthly", "--until", "2026-1-31"),
+                 ("--repeat", "monthly", "--until", "2025-12-31")]
+        for existing in (False, True):
+            for options in cases:
+                with self.subTest(existing=existing, options=options):
+                    if existing:
+                        with open(self.data, "wb") as stream:
+                            stream.write(b'[]  \n')
+                    elif os.path.exists(self.data):
+                        os.unlink(self.data)
+                    result = subprocess.run([sys.executable, "-B", "-m", "ledger", "--data", self.data,
+                                             "add", "2026-01-31", "1", "x", *options], capture_output=True, text=True)
+                    self.assertEqual(2, result.returncode)
+                    self.assertTrue(result.stderr)
+                    if existing:
+                        with open(self.data, "rb") as stream:
+                            self.assertEqual(b'[]  \n', stream.read())
+                    else:
+                        self.assertFalse(os.path.exists(self.data))
