+def positive_integer(text):
+    try:
+        value = int(text)
+    except ValueError:
+        raise argparse.ArgumentTypeError("limit must be a positive integer") from None
+    if value <= 0:
+        raise argparse.ArgumentTypeError("limit must be a positive integer")
+    return value
+
+
 def build_parser():
     parser = argparse.ArgumentParser(prog="ledger")
     parser.add_argument("--data", default=os.environ.get("LEDGER_DATA", "ledger.json"))
@@ -23,7 +33,11 @@ def build_parser():
     add.add_argument("amount")
     add.add_argument("category")
     add.add_argument("note", nargs="?", default="")
-    commands.add_parser("list")
+    listing = commands.add_parser("list")
+    listing.add_argument(
+        "--limit", type=positive_integer, metavar="N",
+        help="show the N most recent entries by date, oldest first (default: all entries)",
+    )
     summary = commands.add_parser("report")
     summary.add_argument("--by", choices=["category", "month"], default="category")
     return parser
@@ -46,7 +60,10 @@ def main(argv=None, out=None, err=None):
