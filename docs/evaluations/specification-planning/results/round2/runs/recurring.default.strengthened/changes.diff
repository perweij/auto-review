@@ -1,5 +1,8 @@
 """Ledger entries."""
+import calendar
+import datetime
 from dataclasses import dataclass, asdict
+from typing import Optional
 
 
 @dataclass(frozen=True)
@@ -8,10 +11,59 @@ class Entry:
     amount_cents: int  # positive spending, negative refund
     category: str
     note: str = ""
+    repeat: Optional[str] = None
+    until: Optional[str] = None
+
+    def __post_init__(self):
+        if self.repeat is None:
+            if self.until is not None:
+                raise ValueError("--until requires --repeat monthly")
+            return
+        if self.repeat != "monthly":
+            raise ValueError("--repeat must be monthly")
+        if self.until is None:
+            raise ValueError("--repeat monthly requires --until YYYY-MM-DD")
+        try:
+            end = datetime.date.fromisoformat(self.until)
+            if end.isoformat() != self.until:
+                raise ValueError
+        except ValueError:
+            raise ValueError("--until must be a valid date in YYYY-MM-DD form") from None
+        if end < datetime.date.fromisoformat(self.date):
+            raise ValueError("--until must not be before the start date")
 
     def to_dict(self):
-        return asdict(self)
+        value = asdict(self)
+        if self.repeat is None:
+            del value["repeat"]
+            del value["until"]
+        return value
 
     @classmethod
     def from_dict(cls, value):
-        return cls(value["date"], int(value["amount_cents"]), value["category"], value.get("note", ""))
+        return cls(value["date"], int(value["amount_cents"]), value["category"],
+                   value.get("note", ""), value.get("repeat"), value.get("until"))
+
+    def occurrences(self):
+        """Yield ordinary entries, retaining the original day in every month."""
+        if self.repeat is None:
+            yield self
+            return
+        start = datetime.date.fromisoformat(self.date)
+        end = datetime.date.fromisoformat(self.until)
+        first_month = (start.year - 1) * 12 + start.month - 1
+        last_month = (end.year - 1) * 12 + end.month - 1
+        for month_index in range(first_month, last_month + 1):
+            year, month = divmod(month_index, 12)
+            year, month = year + 1, month + 1
+            day = min(start.day, calendar.monthrange(year, month)[1])
+            occurrence = datetime.date(year, month, day)
+            if occurrence > end:
+                break
+            yield Entry(occurrence.isoformat(), self.amount_cents, self.category, self.note)
+
+
+def expand_entries(entries):
+    """Expand series for display and reports without changing stored entries."""
+    for entry in entries:
+        yield from entry.occurrences()
