@@ -0,0 +1,32 @@
+import unittest
+
+from ledger.models import Entry, expand_entries
+
+
+class RecurrenceTest(unittest.TestCase):
+    def test_monthly_dates(self):
+        cases = [
+            ("2026-01-31", "2026-03-31", ["2026-01-31", "2026-02-28", "2026-03-31"]),
+            ("2028-01-31", "2028-03-31", ["2028-01-31", "2028-02-29", "2028-03-31"]),
+            ("2026-01-31", "2026-03-30", ["2026-01-31", "2026-02-28"]),
+            ("2026-01-31", "2026-01-31", ["2026-01-31"]),
+            ("2026-12-31", "2027-02-28", ["2026-12-31", "2027-01-31", "2027-02-28"]),
+            ("2028-02-29", "2028-04-30", ["2028-02-29", "2028-03-29", "2028-04-29"]),
+            ("2026-01-30", "2026-03-30", ["2026-01-30", "2026-02-28", "2026-03-30"]),
+            ("9999-11-30", "9999-12-31", ["9999-11-30", "9999-12-30"]),
+        ]
+        for start, until, expected in cases:
+            with self.subTest(start=start, until=until):
+                series = Entry(start, -305, "refund", "credit", "monthly", until)
+                self.assertEqual(
+                    [Entry(date, -305, "refund", "credit") for date in expected],
+                    list(series.occurrences()),
+                )
+
+    def test_expand_preserves_ordinary_entries(self):
+        ordinary = Entry("2026-02-03", 100, "food")
+        series = Entry("2026-01-31", 500, "rent", repeat="monthly", until="2026-02-28")
+        self.assertEqual(
+            [ordinary, Entry("2026-01-31", 500, "rent"), Entry("2026-02-28", 500, "rent")],
+            list(expand_entries(iter([ordinary, series]))),
+        )
