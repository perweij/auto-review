 from ledger import cli
 
@@ -30,3 +32,35 @@ class CliTest(unittest.TestCase):
         self.assertEqual(2, code)
         self.assertIn("invalid", err)
         self.assertEqual(2, self.run_cli("add", "2026-01-01", "abc", "food")[0])
+
+    def test_list_limit_order_boundaries_and_ties(self):
+        for date, category in [("2026-01-08", "first"), ("2026-01-03", "early"),
+                               ("2026-01-08", "second"), ("2026-01-05", "middle"),
+                               ("2026-01-08", "third")]:
+            self.assertEqual(0, self.run_cli("add", date, "1", category)[0])
+        all_lines = ["2026-01-03       1.00 early", "2026-01-05       1.00 middle",
+                     "2026-01-08       1.00 first", "2026-01-08       1.00 second",
+                     "2026-01-08       1.00 third"]
+        self.assertEqual(all_lines, self.run_cli("list")[1].splitlines())
+        for limit in (1, 2, 4, 5, 10):
+            with self.subTest(limit=limit):
+                code, out, err = self.run_cli("list", "--limit", str(limit))
+                self.assertEqual((0, ""), (code, err))
+                self.assertEqual(all_lines[-limit:], out.splitlines())
+
+    def test_list_limit_empty_and_missing(self):
+        self.assertEqual((0, "", ""), self.run_cli("list", "--limit", "2"))
+        with open(self.data, "w") as data:
+            data.write("[]")
+        self.assertEqual((0, "", ""), self.run_cli("list", "--limit", "2"))
+
+    def test_invalid_list_limits_fail_before_loading(self):
+        for arguments in [("0",), ("-1",), ("abc",), ("1.5",), ()]:
+            with self.subTest(arguments=arguments), patch("ledger.cli.store.load") as load:
+                stderr = io.StringIO()
+                with redirect_stderr(stderr):
+                    code, out, _ = self.run_cli("list", "--limit", *arguments)
+                self.assertEqual(2, code)
+                self.assertEqual("", out)
+                self.assertTrue(stderr.getvalue())
+                load.assert_not_called()
