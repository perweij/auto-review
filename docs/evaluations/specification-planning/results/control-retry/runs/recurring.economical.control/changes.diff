diff --git a/ledger/models.py b/ledger/models.py
index e382fba..e37775e 100644
--- a/ledger/models.py
+++ b/ledger/models.py
@@ -1,4 +1,6 @@
-"""Ledger entries."""
+"""Ledger entries and recurrence expansion."""
+import calendar
+import datetime
 from dataclasses import dataclass, asdict
 
 
@@ -8,10 +10,42 @@ class Entry:
     amount_cents: int  # positive spending, negative refund
     category: str
     note: str = ""
+    repeat: str = None
+    until: str = None
 
     def to_dict(self):
-        return asdict(self)
+        value = asdict(self)
+        if self.repeat is None:
+            del value["repeat"]
+            del value["until"]
+        return value
 
     @classmethod
     def from_dict(cls, value):
-        return cls(value["date"], int(value["amount_cents"]), value["category"], value.get("note", ""))
+        return cls(value["date"], int(value["amount_cents"]), value["category"],
+                   value.get("note", ""), value.get("repeat"), value.get("until"))
+
+
+def expand_entries(entries):
+    """Yield one-time entries for each occurrence, anchored to the start day."""
+    for entry in entries:
+        if entry.repeat is None:
+            yield entry
+            continue
+        if entry.repeat != "monthly":
+            raise ValueError("unsupported recurrence frequency")
+        start = datetime.date.fromisoformat(entry.date)
+        end = datetime.date.fromisoformat(entry.until)
+        year, month = start.year, start.month
+        while True:
+            day = min(start.day, calendar.monthrange(year, month)[1])
+            occurrence = datetime.date(year, month, day)
+            if occurrence > end:
+                break
+            yield Entry(occurrence.isoformat(), entry.amount_cents, entry.category, entry.note)
+            if year == 9999 and month == 12:
+                break
+            if month == 12:
+                year, month = year + 1, 1
+            else:
+                month += 1
