diff --git a/tests/test_models.py b/tests/test_models.py
new file mode 100644
index 0000000..1386d7f
--- /dev/null
+++ b/tests/test_models.py
@@ -0,0 +1,22 @@
+import unittest
+
+from ledger.models import Entry, expand_entries
+
+
+class RecurrenceTest(unittest.TestCase):
+    def test_month_end_leap_year_and_original_day(self):
+        entry = Entry("2024-01-31", 1250, "food", "lunch", "monthly", "2024-04-30")
+        occurrences = list(expand_entries([entry]))
+        self.assertEqual(["2024-01-31", "2024-02-29", "2024-03-31", "2024-04-30"],
+                         [item.date for item in occurrences])
+        self.assertTrue(all((item.amount_cents, item.category, item.note) == (1250, "food", "lunch")
+                            for item in occurrences))
+
+    def test_year_transition_non_leap_and_exclusive_next_occurrence(self):
+        entry = Entry("2025-12-31", 1, "x", repeat="monthly", until="2026-03-30")
+        self.assertEqual(["2025-12-31", "2026-01-31", "2026-02-28"],
+                         [item.date for item in expand_entries([entry])])
+
+    def test_maximum_date(self):
+        entry = Entry("9999-12-31", 1, "x", repeat="monthly", until="9999-12-31")
+        self.assertEqual(["9999-12-31"], [item.date for item in expand_entries([entry])])
