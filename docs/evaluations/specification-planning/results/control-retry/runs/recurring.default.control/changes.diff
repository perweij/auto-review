--- /dev/null
+++ b/tests/test_models.py
@@ -0,0 +1,52 @@
+import unittest
+
+from ledger.models import Entry, expand_occurrences
+
+
+class ModelTest(unittest.TestCase):
+    def test_ordinary_entry_serialization(self):
+        value = {"date": "2026-01-05", "amount_cents": 1250,
+                 "category": "food", "note": "lunch"}
+        entry = Entry.from_dict(value)
+        self.assertIsNone(entry.repeat)
+        self.assertIsNone(entry.until)
+        self.assertEqual(value, entry.to_dict())
+        self.assertEqual([entry], list(expand_occurrences([entry])))
+
+    def test_legacy_missing_note(self):
+        entry = Entry.from_dict({"date": "2026-01-05", "amount_cents": 100,
+                                 "category": "food"})
+        self.assertEqual("", entry.note)
+        self.assertIsNone(entry.repeat)
+
+    def test_monthly_dates(self):
+        cases = [
+            ("2026-01-31", "2026-04-30",
+             ["2026-01-31", "2026-02-28", "2026-03-31", "2026-04-30"]),
+            ("2024-01-31", "2024-03-31",
+             ["2024-01-31", "2024-02-29", "2024-03-31"]),
+            ("2024-02-29", "2024-04-29",
+             ["2024-02-29", "2024-03-29", "2024-04-29"]),
+            ("2026-12-30", "2027-03-30",
+             ["2026-12-30", "2027-01-30", "2027-02-28", "2027-03-30"]),
+            ("2026-01-15", "2026-03-14", ["2026-01-15", "2026-02-15"]),
+            ("2026-01-31", "2026-01-31", ["2026-01-31"]),
+            ("9999-11-30", "9999-12-31", ["9999-11-30", "9999-12-30"]),
+        ]
+        for start, until, dates in cases:
+            with self.subTest(start=start, until=until):
+                series = Entry(start, -1250, "refund", "same note", "monthly", until)
+                occurrences = list(expand_occurrences([series]))
+                self.assertEqual(dates, [entry.date for entry in occurrences])
+                self.assertEqual([Entry(day, -1250, "refund", "same note")
+                                  for day in dates], occurrences)
+                self.assertEqual(series, Entry.from_dict(series.to_dict()))
+
+    def test_invalid_recurrence(self):
+        for repeat, until in [("weekly", "2026-03-01"), ("monthly", None),
+                              ("monthly", "2026-02-30"), ("monthly", "bad"),
+                              ("monthly", "20260131"), ("monthly", "2025-12-31"),
+                              (None, "2026-03-01")]:
+            with self.subTest(repeat=repeat, until=until):
+                with self.assertRaises(ValueError):
+                    Entry("2026-01-01", 100, "food", repeat=repeat, until=until)
