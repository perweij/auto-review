index e382fba..ea0dc24 100644
--- a/ledger/models.py
+++ b/ledger/models.py
@@ -1,5 +1,8 @@
 """Ledger entries."""
 from dataclasses import dataclass, asdict
+from calendar import monthrange
+from datetime import date
+from typing import Optional
 
 
 @dataclass(frozen=True)
@@ -8,10 +11,56 @@ class Entry:
     amount_cents: int  # positive spending, negative refund
     category: str
     note: str = ""
+    repeat: Optional[str] = None
+    until: Optional[str] = None
+
+    def __post_init__(self):
+        if self.repeat is None:
+            if self.until is not None:
+                raise ValueError("--until requires --repeat monthly")
+            return
+        if self.repeat != "monthly":
+            raise ValueError("--repeat must be monthly")
+        if self.until is None:
+            raise ValueError("--repeat monthly requires --until YYYY-MM-DD")
+        try:
+            end = date.fromisoformat(self.until)
+            start = date.fromisoformat(self.date)
+        except ValueError:
+            raise ValueError("invalid recurrence date; use YYYY-MM-DD") from None
+        if end.isoformat() != self.until:
+            raise ValueError("invalid --until date; use YYYY-MM-DD")
+        if end < start:
+            raise ValueError("--until must be on or after the start date")
 
     def to_dict(self):
-        return asdict(self)
+        value = asdict(self)
+        if self.repeat is None:
+            del value["repeat"]
+            del value["until"]
+        return value
 
     @classmethod
     def from_dict(cls, value):
-        return cls(value["date"], int(value["amount_cents"]), value["category"], value.get("note", ""))
+        return cls(value["date"], int(value["amount_cents"]), value["category"],
+                   value.get("note", ""), value.get("repeat"), value.get("until"))
+
+
+def expand_occurrences(entries):
+    """Yield one-time entries, expanding each series from its original day."""
+    for entry in entries:
+        if entry.repeat is None:
+            yield entry
+            continue
+        start = date.fromisoformat(entry.date)
+        end = date.fromisoformat(entry.until)
+        # Month indices avoid drifting after a short month and year overflow
+        # when a series ends in December of year 9999.
+        for index in range(start.year * 12 + start.month - 1,
+                           end.year * 12 + end.month):
+            year, month = divmod(index, 12)
+            month += 1
+            occurrence = date(year, month, min(start.day, monthrange(year, month)[1]))
+            if occurrence <= end:
+                yield Entry(occurrence.isoformat(), entry.amount_cents,
+                            entry.category, entry.note)
