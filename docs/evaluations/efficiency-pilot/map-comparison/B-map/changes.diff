+    def test_cancellation_during_prepare_preserves_staging_and_saved_state(self):
+        c = self.attach()
+        c['status'] = 'staged'
+        self.save()
+        saved = self.session.file.read_bytes()
+        cancelled = Cancelled(signal.SIGTERM)
+        with patch.object(publication, 'recover'), patch.object(publication, 'refresh', return_value=[]), \
+                patch.object(publication, 'repository_operation'), patch.object(s, 'validate', side_effect=cancelled):
+            with self.assertRaises(Cancelled):
+                publication.prepare(self.session, self.state)
+        self.assertEqual(c['status'], 'staged')
+        self.assertEqual(self.session.file.read_bytes(), saved)
+
+    def test_ordinary_validation_failure_remains_actionable(self):
+        c = self.attach()
+        failure = ApiError('invalid_suggestion', 'Replacement is invalid.')
+        with patch.object(s, 'validate', side_effect=failure):
+            reasons = s.blockers(self.session, c, self.state)
+        self.assertIn('Replacement is invalid.', reasons[0])
+        self.assertIn(s.RECOVERY, reasons[0])
+
