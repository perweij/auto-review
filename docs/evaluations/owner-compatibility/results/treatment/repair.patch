 sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
 from pr_review import models, settings
@@ -46,3 +48,45 @@ class SlotSettingsTest(unittest.TestCase):
         legacy = settings.validate(settings.from_manifest({'models': {'claude': 'old'}}))
         self.assertEqual(legacy['reviewer_slots'][0]['model'], 'old')
         self.assertEqual(legacy['processing']['provider'], 'claude')
+
+    def test_legacy_order_and_explicit_slot_order(self):
+        from pr_review.reviews import Review
+        config = settings.resolve({'reviewers': ['codex', 'claude']})['settings']
+        self.assertEqual(config['reviewers'], ['claude', 'codex'])
+        review = Review.__new__(Review)
+        review.settings = config
+        self.assertTrue(review.dual)
+        slots = [dict(id='reviewer-1', provider='codex', model='x', effort='high'),
+                 dict(id='reviewer-2', provider='claude', model='y', effort='high')]
+        self.assertEqual(settings.validate({'reviewer_slots': slots})['reviewer_slots'], slots)
+
+    def test_saved_reviewer_override_and_explicit_processing(self):
+        saved = settings.validate(settings.DEFAULTS)
+        with patch.object(settings, 'Session') as session, patch.object(settings, 'read_json', return_value={'configuration': saved}):
+            session.return_value.pointer.return_value = None
+            session.return_value.path = Path('/unused')
+            result = settings.resolve({'session': '/unused', 'reviewers': ['claude']})['settings']
+            self.assertEqual(result['processing']['provider'], 'claude')
+            result = settings.resolve({'session': '/unused', 'reviewers': ['claude'], 'processing_provider': 'codex'})['settings']
+            self.assertEqual(result['processing']['provider'], 'codex')
+            self.assertEqual(settings.resolve({'session': '/unused'})['settings'], saved)
+        result = settings.resolve({'reviewers': ['claude'], 'defaults': {'processing_provider': 'codex'}})['settings']
+        self.assertEqual(result['processing']['provider'], 'codex')
+
+    def test_unchanged_legacy_completed_review_does_not_begin_generation(self):
+        from pr_review.reviews import Review
+        legacy = dict(settings.DEFAULTS)
+        review = Review.__new__(Review)
+        review.manifest = {'configuration': legacy, 'phases': {'synthesis': {'status': 'completed'}}}
+        review.settings = settings.validate(settings.from_manifest(review.manifest))
+        review.scope, review.begin, review.save = Mock(), Mock(), Mock()
+        review.runtime = SimpleNamespace(permission='default')
+        review.tools, review.viewer, review.permission = {}, 'viewer', 'read'
+        review.path = Path('/unused')
+        with patch('pr_review.reviews.say'):
+            review.configure('full', [])
+        review.begin.assert_not_called()
+        review.settings = settings.validate({**legacy, 'claude_model': 'different'})
+        with patch('pr_review.reviews.say'):
+            review.configure('full', [])
+        review.begin.assert_called_once()
