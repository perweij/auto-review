diff --git a/tests/test_settings_slots.py b/tests/test_settings_slots.py
new file mode 100644
index 0000000..4778320
--- /dev/null
+++ b/tests/test_settings_slots.py
@@ -0,0 +1,72 @@
+"""Configuration contract for reviewer slots and processing choices."""
+import sys
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
+from pr_review import settings, models
+from pr_review.common import ApiError
+
+
+def slot(index, provider, model, effort):
+    return {'id': f'reviewer-{index}', 'provider': provider, 'model': model, 'effort': effort}
+
+
+class SettingsSlotsTest(unittest.TestCase):
+    def test_defaults_presets_and_overrides(self):
+        for preset, expected in [(None, ('opus', 'gpt-6.1-sol')), ('economical', ('haiku', 'gpt-6.1-terra')), ('expensive', ('fable', 'gpt-6-astra'))]:
+            request = {preset: True} if preset else {}
+            config = settings.resolve(request)['settings']
+            self.assertEqual(tuple(s['model'] for s in config['reviewer_slots']), expected)
+            self.assertEqual(settings.resolve({**request, 'claude_model': 'custom'})['settings']['reviewer_slots'][0]['model'], 'custom')
+
+    def test_legacy_order_and_implicit_processing(self):
+        config = settings.resolve({'reviewers': ['codex', 'claude']})['settings']
+        self.assertEqual([s['provider'] for s in config['reviewer_slots']], ['claude', 'codex'])
+        self.assertEqual(settings.resolve({'reviewers': ['claude']})['settings']['processing']['provider'], 'claude')
+        config = settings.resolve({'reviewers': ['claude'], 'processing_provider': 'codex', 'codex_effort': 'medium'})['settings']
+        self.assertEqual(config['processing'], {'provider': 'codex', 'model': 'gpt-6.1-sol', 'effort': 'medium'})
+
+    def test_single_reviewer_request_overrides_provisional_processing(self):
+        defaults = {'processing_provider': 'codex', 'codex_model': 'custom'}
+        self.assertEqual(settings.resolve({'defaults': defaults, 'reviewers': ['claude']})['settings']['processing']['provider'], 'claude')
+        self.assertEqual(settings.resolve({'defaults': defaults, 'reviewers': ['claude'], 'processing_provider': 'codex'})['settings']['processing']['model'], 'custom')
+
+    def test_malformed_layered_choices_raise_api_error(self):
+        for defaults in ({'reviewer_slots': [{}]}, {'reviewer_slots': [None]},
+                         {'reviewer_slots': 'bad'}, {'processing': {}}, {'processing': 'bad'}):
+            with self.subTest(defaults=defaults), self.assertRaises(ApiError):
+                settings.resolve({'defaults': defaults, 'claude_model': 'override'})
+
+    def test_duplicate_slots_roundtrip(self):
+        for provider in ('claude', 'codex'):
+            slots = [slot(1, provider, 'first', 'low'), slot(2, provider, 'second', 'high')]
+            config = settings.resolve({'reviewer_slots': slots, 'processing': {'provider': provider, 'model': 'third', 'effort': 'medium'}})['settings']
+            self.assertEqual(settings.validate(config), config)
+            self.assertEqual(config['reviewer_slots'], slots)
+            self.assertEqual(settings.from_manifest({'configuration': config})['reviewer_slots'], slots)
+
+    def test_legacy_manifest_and_override(self):
+        manifest = {'models': {'claude': 'old', 'claude_effort': 'low'}, 'configuration': {'reviewers': ['claude']}}
+        saved = settings.from_manifest(manifest)
+        self.assertEqual(saved['reviewer_slots'][0]['model'], 'old')
+        self.assertEqual(saved['codex_model'], 'gpt-6-astra')
+        self.assertEqual(saved['processing']['provider'], 'claude')
+        merged = settings.initial_settings({'economical': True})
+        settings.overlay(merged, saved)
+        settings.overlay(merged, {'claude_model': 'override'})
+        self.assertEqual(settings.validate(merged)['reviewer_slots'][0]['model'], 'override')
+
+    def test_catalogs_validate_every_choice(self):
+        slots = [slot(1, 'claude', 'a', 'low'), slot(2, 'claude', 'b', 'high')]
+        config = settings.resolve({'reviewer_slots': slots, 'processing': {'provider': 'codex', 'model': 'c', 'effort': 'medium'}})['settings']
+        catalogs = {'claude': {'provider': 'claude', 'models': [{'value': 'a', 'efforts': ['low']}, {'value': 'b', 'efforts': ['high']}]}, 'codex': {'provider': 'codex', 'models': [{'value': 'c', 'efforts': ['medium']}]}}
+        models.validate_selection(config, catalogs)
+        for bad in [{**config, 'reviewer_slots': [slots[0], slot(2, 'claude', 'b', 'low')]}, {**config, 'processing': {'provider': 'codex', 'model': 'missing', 'effort': 'medium'}}]:
+            with self.assertRaises(ApiError):
+                models.validate_selection(bad, catalogs)
+
+    def test_invalid_configurations(self):
+        for request in [{'reviewers': []}, {'reviewers': ['claude'] * 3}, {'reviewers': ['unknown']}, {'reviewer_slots': [slot(2, 'claude', 'a', 'high')]}, {'reviewer_slots': [slot(1, 'claude', '', 'high')]}, {'processing': {'provider': 'codex', 'model': 'x', 'effort': '-bad'}}]:
+            with self.subTest(request=request), self.assertRaises(ApiError):
+                settings.resolve(request)
