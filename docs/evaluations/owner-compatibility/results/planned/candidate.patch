+def overlay(settings, values):
+    """Apply a higher-precedence layer without leaving stale canonical choices."""
+    values = {k: v for k, v in values.items() if k in set(DEFAULTS) | {"configuration_version", "reviewer_slots", "processing"}}
+    if "reviewers" in values and "reviewer_slots" not in values:
+        settings.pop("reviewer_slots", None)
+        if (isinstance(values["reviewers"], list) and len(values["reviewers"]) == 1
+                and "processing" not in values and "processing_provider" not in values):
+            settings.pop("processing", None)
+            settings["_processing_explicit"] = False
+    elif "reviewer_slots" not in values and "reviewer_slots" in settings:
+        slots = settings["reviewer_slots"]
+        if isinstance(slots, list) and all(isinstance(slot, dict) and slot.get("provider") in ("claude", "codex") for slot in slots):
+            settings["reviewer_slots"] = [{**slot, **{field: values[slot["provider"] + "_" + field] for field in ("model", "effort") if slot["provider"] + "_" + field in values}} for slot in slots]
+    if "processing" not in values:
+        processing = settings.get("processing")
+        if "processing_provider" in values:
+            settings.pop("processing", None)
+        elif isinstance(processing, dict) and processing.get("provider") in ("claude", "codex") and any(processing["provider"] + "_" + field in values for field in ("model", "effort")):
+            settings["processing"] = {**processing, **{field: values[processing["provider"] + "_" + field] for field in ("model", "effort") if processing["provider"] + "_" + field in values}}
+    if "processing_provider" in values or "processing" in values:
+        settings["_processing_explicit"] = True
+    settings.update(values)
     return settings
 
 
