@@ -46,3 +48,47 @@ class SlotSettingsTest(unittest.TestCase):
         legacy = settings.validate(settings.from_manifest({'models': {'claude': 'old'}}))
         self.assertEqual(legacy['reviewer_slots'][0]['model'], 'old')
         self.assertEqual(legacy['processing']['provider'], 'claude')
+
+    def test_legacy_order_and_single_reviewer_override(self):
+        config = settings.validate({'reviewers': ['codex', 'claude']})
+        self.assertEqual(config['reviewers'], ['claude', 'codex'])
+        settings.apply_overrides(config, {'reviewers': ['claude']})
+        self.assertEqual(settings.validate(config)['processing']['provider'], 'claude')
+        settings.apply_overrides(config, {'reviewers': ['claude'], 'processing_provider': 'codex'})
+        self.assertEqual(settings.validate(config)['processing']['provider'], 'codex')
+
+    def test_unchanged_legacy_review_does_not_begin_generation(self):
+        from pr_review.reviews import Review
+        manifest = {'configuration': dict(settings.DEFAULTS),
+                    'phases': {'synthesis': {'status': 'completed'}}}
+        review = Mock(spec=Review)
+        review.manifest = manifest
+        review.settings = settings.validate(settings.from_manifest(manifest))
+        review.runtime = SimpleNamespace(permission='default')
+        review.tools, review.viewer, review.permission, review.path = {}, 'viewer', 'read', Path('/tmp')
+        with patch('pr_review.reviews.say'):
+            Review.configure(review, 'review', [])
+        review.begin.assert_not_called()
+        review.settings = settings.validate({**settings.DEFAULTS, 'claude_model': 'changed'})
+        with patch('pr_review.reviews.say'):
+            Review.configure(review, 'review', [])
+        review.begin.assert_called_once()
+
+    def test_automation_discovers_processing_catalog(self):
+        from pr_review import automation, reviews
+        from pr_review.repository import Repository
+        config = settings.validate({'reviewers': ['claude'], 'processing_provider': 'codex'})
+        controller = Mock()
+        controller.operation = {'operation_id': 'a' * 32}
+        repo = SimpleNamespace(common='/tmp/repo', pr=1, lock='/tmp/lock')
+        catalogs = {p: {'provider': p, 'models': [{'value': config[p + '_model'],
+                    'efforts': [config[p + '_effort']]}]} for p in ('claude', 'codex')}
+        with patch.object(Repository, 'resolve', return_value=repo), \
+                patch('pr_review.automation.atomic_json'), patch('pr_review.automation.locked'), \
+                patch('pr_review.sessions.locate', return_value=(None, None)), \
+                patch.object(settings, 'resolve', return_value={'settings': config}), \
+                patch.object(models, 'discover', side_effect=lambda r: catalogs[r['provider']]) as discover, \
+                patch.object(reviews, 'execute') as execute:
+            automation._execute({'pr': 1}, controller)
+        self.assertEqual({call.args[0]['provider'] for call in discover.call_args_list}, {'claude', 'codex'})
+        execute.assert_called_once()
