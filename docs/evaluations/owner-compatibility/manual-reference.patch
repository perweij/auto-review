diff --git a/tests/test_slot_settings.py b/tests/test_slot_settings.py
index df724db..d475144 100644
--- a/tests/test_slot_settings.py
+++ b/tests/test_slot_settings.py
@@ -74,3 +74,34 @@ class SlotSettingsTest(unittest.TestCase):
         with patch('pr_review.reviews.say'):
             review.configure('review', [])
         review.begin.assert_not_called()
+
+    def test_explicit_processing_defaults_survive_single_reviewer_override(self):
+        for defaults in ({'processing_provider': 'codex'},
+                         {'processing': {'provider': 'codex', 'model': 'custom', 'effort': 'high'}}):
+            with self.subTest(defaults=defaults):
+                result = settings.resolve({'reviewers': ['claude'], 'defaults': defaults})['settings']
+                self.assertEqual('codex', result['processing']['provider'])
+                if 'processing' in defaults:
+                    self.assertEqual('custom', result['processing']['model'])
+
+    def test_saved_legacy_selection_overrides_canonical_defaults(self):
+        defaults = settings.validate({'reviewers': ['codex'], 'processing_provider': 'codex'})
+        manifest = {'configuration': {'reviewers': ['claude'], 'claude_model': 'saved-model'}}
+        session = SimpleNamespace(pointer=lambda name: None, path=Path('/unused-session'))
+        with patch.object(settings, 'Session', return_value=session), patch.object(settings, 'read_json', return_value=manifest):
+            result = settings.resolve({'session': '/unused-session', 'defaults': defaults})['settings']
+        self.assertEqual(['claude'], result['reviewers'])
+        self.assertEqual('saved-model', result['reviewer_slots'][0]['model'])
+        self.assertEqual('claude', result['processing']['provider'])
+
+    def test_legacy_single_provider_infers_historical_processing(self):
+        for provider in ('claude', 'codex'):
+            with self.subTest(provider=provider):
+                result = settings.validate(settings.from_manifest({'configuration': {'reviewers': [provider]}}))
+                self.assertEqual(provider, result['processing']['provider'])
+
+    def test_saved_canonical_independent_processing_is_preserved(self):
+        saved = settings.validate({'reviewers': ['codex'], 'processing_provider': 'claude'})
+        result = settings.validate(settings.from_manifest({'configuration': saved}))
+        self.assertEqual('claude', result['processing']['provider'])
+        self.assertEqual(['codex'], result['reviewers'])
