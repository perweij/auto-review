#!/usr/bin/env python3
"""Installed entry point; resolve resources relative to the real program path."""
from pathlib import Path
import sys

# Source checkouts and immutable installations must stay free of import caches.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))
from pr_review.cli import main

if __name__ == '__main__':
    sys.exit(main())
