#!/usr/bin/env python3
"""Utilities for the installed Codex CLI."""
import argparse
from pathlib import Path
import sys

# Share pr-review's metadata-only discovery from this installation.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'lib'))


def list_models():
    """Print the available MODEL:EFFORT choices from the local Codex app server."""
    from pr_review.models import discover
    for model in discover({'provider': 'codex'})['models']:
        for effort in model['efforts']:
            print(f"{model['value']}:{effort}")


if __name__ == "__main__":
    from pr_review.common import ApiError
    parser = argparse.ArgumentParser(description=__doc__)
    modes = parser.add_subparsers(required=True, dest="mode")
    models = modes.add_parser("list-models", help="list available MODEL:EFFORT choices")
    models.set_defaults(action=list_models)
    try:
        parser.parse_args().action()
    except (ApiError, OSError) as error:
        sys.exit(str(error))
